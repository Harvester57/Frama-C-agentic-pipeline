{
  "$comment": "Contract for run-metadata.json. Written only by the parent via scripts/run_metadata.py.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^run-[0-9]+$"},
    "repo": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "target": {"type": "string", "minLength": 1},
    "source_ref": {
      "type": "object",
      "properties": {
        "vcs": {"type": "string", "enum": ["git", "none"]},
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      },
      "required": ["vcs", "commit", "dirty"],
      "additionalProperties": false
    },
    "profile": {"type": "string", "enum": ["quick", "standard", "deep"]},
    "scope_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget": {"type": ["integer", "null"], "minimum": 1},
    "execution_policy": {"const": "sandboxed-local-only"},
    "sandbox": {
      "type": "object",
      "properties": {
        "outer": {"type": "string", "enum": ["docker-hardened", "podman-hardened", "unknown"]},
        "inner": {"type": "string", "enum": ["rlimits", "bubblewrap", "degraded", "unknown"]}
      },
      "required": ["outer", "inner"],
      "additionalProperties": false
    },
    "prior_runs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "toolchain": {"type": "object"},
    "resources": {
      "$comment": "Optional. Compact summary of `resources.py probe --scope container` at init: what the init container itself measured (its lease), plus under `pool` the node pool the host broker measured.",
      "type": "object",
      "properties": {
        "cpus": {"type": "integer", "minimum": 1},
        "mem_mb": {"type": "integer", "minimum": 1},
        "sources": {"type": "object"},
        "binding": {"type": "object"},
        "reserve": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "pool": {
          "type": "object",
          "properties": {
            "cpus": {"type": "integer", "minimum": 1},
            "mem_mb": {"type": "integer", "minimum": 1},
            "source": {"type": "string"}
          },
          "required": ["cpus", "mem_mb"]
        }
      },
      "required": ["cpus", "mem_mb", "sources", "warnings"]
    },
    "build": {
      "$comment": "Optional. The target's build recipe, set by run_metadata.py set-build and run by build_capture.py (plan step I2).",
      "type": "object",
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "workdir": {"type": "string", "minLength": 1},
        "packages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+$"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "test_command": {"type": ["string", "null"]},
        "install_command": {"type": ["string", "null"]},
        "snapshot_extra": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "origin": {"type": "string", "enum": ["user", "agent_confirmed", "benchmark"]},
        "updated_at": {"type": "string", "minLength": 1}
      },
      "required": ["command", "workdir", "packages", "env", "test_command", "origin"],
      "additionalProperties": false
    },
    "run_dir_host": {"$comment": "Optional. Host path of the run directory (FRAMAC_RUN_HOST).", "type": ["string", "null"]},
    "snapshot_manifest": {"$comment": "Optional. Run-relative path to state/snapshot-manifest.json.", "type": ["string", "null"]},
    "snapshot_digest": {"$comment": "Optional. SHA-256 digest of the canonical files map in state/snapshot-manifest.json.", "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "run_status": {"type": "string", "enum": ["in_progress", "complete", "incomplete"]},
    "incomplete_reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "run_id", "repo", "target", "source_ref", "profile", "scope_paths", "budget", "execution_policy", "sandbox", "prior_runs", "toolchain", "run_status", "incomplete_reason", "created_at", "updated_at"],
  "additionalProperties": false
}
