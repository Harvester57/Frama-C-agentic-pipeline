{
  "$comment": "Contract for workspace/reports/phase0_model.json, written by scripts/phase0_model.py run (plan step I3). Function ids are `file#name`, the file relative to the target root. Every function, edge and alias carries its source. Version 2 records external_calls, kernel_names, formals, writes and param_sizes on its functions; version 1 models stay valid and consumers read which facts they have with phase0_model.model_features. Fields (remediation R4, D9: kept when the report, the benchmark or a skill step shows them): thread_entries and parse_jobs are kept (the benchmark counts thread entries and sums parse seconds); alias is kept (the report summarizes an --alias run); a function's `included` (a .c file another source includes) is dropped: nothing read it.",
  "type": "object",
  "definitions": {
    "function_id": {"$comment": "A function id, `file#name`: the file relative to the target root (any character but `#`), then one symbol name. The name may carry what nm prints for a compiler clone or a versioned symbol (`parse.constprop.0`, `f@@VERS_1`).", "type": "string", "pattern": "^(?:[^#\\s]+|[^#\\s][^#\\r\\n]*\\/[^#/\\s]+)#[A-Za-z_$][A-Za-z0-9_$.@]*$"},
    "formals": {
      "$comment": "Step I9: a function's parameters; kind `pointer` (the pointee may be written: non-const pointer or array), `const_pointer` or `value`.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "kind": {"type": "string", "enum": ["pointer", "const_pointer", "value"]}},
        "required": ["name", "kind"],
        "additionalProperties": false
      }
    },
    "function_trust": {
      "$comment": "Step I7 (scripts/trust.py): value, the deciding rule, every rule marking it untrusted, whether attacker data reaches its parameters directly, and why.",
      "type": "object",
      "properties": {
        "value": {"type": "string", "enum": ["untrusted", "trusted"]},
        "source": {"type": "string", "enum": ["default", "call_graph", "threat_model", "codeql"]},
        "sources": {"type": "array", "items": {"type": "string", "enum": ["default", "call_graph", "threat_model", "codeql"]}},
        "boundary": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "overridden": {"$comment": "rules a threat-model trusted_callers decision overrode", "type": "array", "items": {"type": "string"}}
      },
      "required": ["value", "source", "sources", "boundary", "reasons"],
      "additionalProperties": false
    },
    "unit_trust": {
      "type": "object",
      "properties": {
        "threat_model": {"type": "string", "enum": ["ok", "no_threat_model", "invalid_threat_model"]},
        "functions": {"type": "integer", "minimum": 0},
        "untrusted": {"type": "integer", "minimum": 0},
        "boundary": {"type": "integer", "minimum": 0},
        "api": {"type": "integer", "minimum": 0}
      },
      "required": ["threat_model", "functions", "untrusted", "boundary", "api"],
      "additionalProperties": false
    },
    "parse_warnings": {
      "$comment": "Phase 0 Frama-C (-no-annot) C-level [kernel:...] parse-loss summary: asm:clobber, attribute-filtered attrs:unknown (semantic/benign/unclassified), benign/tracked kernel categories, unclassified [kernel:...] categories with project_count vs total count, and skipped -no-annot libc:frama-c warnings.",
      "type": "object",
      "properties": {
        "asm_clobber": {
          "type": "object",
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "project_count": {"type": "integer", "minimum": 0},
            "samples": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["count", "project_count", "samples"],
          "additionalProperties": false
        },
        "attrs_unknown": {
          "type": "object",
          "properties": {
            "semantic": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
            "benign": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
            "unclassified": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
            "semantic_samples": {"type": "array", "items": {"type": "string"}},
            "unclassified_samples": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["semantic", "benign", "unclassified", "semantic_samples", "unclassified_samples"],
          "additionalProperties": false
        },
        "benign_categories": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "unclassified_categories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "count": {"type": "integer", "minimum": 1},
              "project_count": {"type": "integer", "minimum": 0},
              "sample": {"type": "string"}
            },
            "required": ["count", "project_count", "sample"],
            "additionalProperties": false
          }
        },
        "no_annot_libc_skipped": {"type": "integer", "minimum": 0},
        "has_parse_loss": {"type": "boolean"}
      },
      "required": ["asm_clobber", "attrs_unknown", "unclassified_categories", "no_annot_libc_skipped", "has_parse_loss"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ok", "error", "no_unit_parsed"]},
    "error": {"type": "string"},
    "capture": {"type": "string"},
    "capture_generated_at": {"type": ["string", "null"]},
    "tree": {"type": "string"},
    "snapshot": {
      "type": "object",
      "properties": {"root": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"]}},
      "required": ["root", "digest"]
    },
    "dump_module": {
      "type": "object",
      "properties": {"status": {"type": "string", "enum": ["ok", "compile_failed"]}},
      "required": ["status"]
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["executable", "shared_lib", "static_lib", "unlinked"]},
          "test": {"type": "boolean"},
          "files": {"type": "array", "items": {"type": "string"}},
          "links": {"type": "array", "items": {"type": "string"}},
          "cppflags": {"type": ["array", "null"], "items": {"type": "string"}},
          "entry_points": {"type": ["array", "null"], "items": {"$ref": "#/definitions/function_id"}},
          "embedded_api": {"type": ["array", "null"], "items": {"$ref": "#/definitions/function_id"}},
          "header_api": {
            "$comment": "A library unit's functions defined in a public header of the build capture (static, header), which it compiles: API entry points without a global symbol. Absent on executables, test units and models made before it",
            "type": "array",
            "items": {"$ref": "#/definitions/function_id"}
          },
          "parse": {
            "type": "object",
            "properties": {
              "status": {"$comment": "`unparsed`: Frama-C failed and so did the GCC fallback, so the model has no function or edge of the unit (`gcc_fallback` says they came from GCC)", "type": "string", "enum": ["ok", "gcc_fallback", "unparsed", "skipped_test", "no_sources"]},
              "job": {"type": "string"},
              "seconds": {"type": "number", "minimum": 0},
              "error": {"$comment": "Frama-C's first error, when the unit fell back to GCC or is unparsed", "type": "string"},
              "gcc_error": {"$comment": "The GCC fallback's first error, when the unit is unparsed", "type": "string"},
              "warnings": {"$ref": "#/definitions/parse_warnings"}
            },
            "required": ["status"]
          },
          "concurrent": {"$comment": "the unit starts threads (pthread_create, thrd_create)", "type": "boolean"},
          "trust": {"$ref": "#/definitions/unit_trust"}
        },
        "required": ["kind", "test", "files", "links", "parse", "concurrent"]
      }
    },
    "functions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kernel_names": {"$comment": "unit -> Frama-C's name (same-named statics are renamed per parse)", "type": "object", "additionalProperties": {"type": "string"}},
          "units": {"type": "array", "items": {"type": "string"}},
          "line": {"type": "integer", "minimum": 0},
          "end_line": {"type": "integer", "minimum": 0},
          "lines": {"type": ["integer", "null"], "minimum": 1},
          "static": {"type": "boolean"},
          "inline": {"type": "boolean"},
          "constructor": {"$comment": "Dump schema 6: whether the function carries __attribute__((constructor))", "type": "boolean"},
          "header": {"$comment": "defined in a project header: belongs to every unit compiling it", "type": "boolean"},
          "signature": {"type": "string"},
          "loops": {"type": ["integer", "null"], "minimum": 0},
          "cyclomatic": {"type": ["integer", "null"], "minimum": 1},
          "address_taken": {"type": "boolean"},
          "source": {"type": "string", "enum": ["frama-c-kernel", "gcc-callgraph-info"]},
          "formals": {"$ref": "#/definitions/formals"},
          "writes": {
            "$comment": "Step I9: writes of its body: through a pointer (count), the formals they go through, globals written directly",
            "type": "object",
            "properties": {
              "pointer": {"type": "integer", "minimum": 0},
              "params": {"type": "array", "items": {"type": "string"}},
              "globals": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["pointer", "params", "globals"],
            "additionalProperties": false
          },
          "external_calls": {"$comment": "functions it calls that no unit of its program defines (libc, packages)", "type": "array", "items": {"type": "string"}},
          "address_refs": {"$comment": "Dump schema 6 (docs/plans/unit-split-address-flow.md): the project functions whose address its body takes (a direct call's callee is none). Absent: not recorded", "type": "array", "items": {"$ref": "#/definitions/function_id"}},
          "global_refs": {"$comment": "Dump schema 6: the project globals (`global_variables` ids) its body names: read, written or address-taken. Absent: not recorded", "type": "array", "items": {"type": "string"}},
          "unresolved_global_refs": {"$comment": "Dump schema 6: names of globals its body names that its parse only declares and several other parses define (non-static): not in `global_refs`, so the unit split does not trust its address flow", "type": "array", "items": {"type": "string"}},
          "call_sites": {
            "$comment": "Dump schema 4 (plan steps M2, M5): each direct call of its body, with the string literals it passes (argument index -> text; bytes outside printable ASCII but CR, LF, tab and NUL read '?'). Absent: not recorded",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "callee": {"type": "string"},
                "line": {"type": "integer", "minimum": 0},
                "literals": {"type": "object", "additionalProperties": {"type": "string"}},
                "initializer": {"$comment": "Dump schema 5 (package E of docs/plans/metacsl-exploitation-plan.md): whether the call is the initializer of a local (`int n = f(x);`). MetAcsl gives such a call no \\calling, \\writing (callee assigns) or \\strong_invariant instance, so security_props.py writes an in-code check there. Absent: a dump before schema 5, which cannot tell", "type": "boolean"}
              },
              "required": ["callee", "line", "literals"],
              "additionalProperties": false
            }
          },
          "param_sizes": {
            "$comment": "argument index -> bytes of the object the parsed callers pass there (an array, an object's address), when the call site shows it",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "min": {"type": "integer", "minimum": 1},
                "max": {"type": "integer", "minimum": 1},
                "sites": {"type": "integer", "minimum": 1}
              },
              "required": ["min", "max", "sites"],
              "additionalProperties": false
            }
          },
          "trust": {"$ref": "#/definitions/function_trust"}
        },
        "required": ["file", "name", "kernel_names", "units", "line", "static", "header", "signature", "address_taken", "source"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caller": {"$ref": "#/definitions/function_id"},
          "callee": {"$ref": "#/definitions/function_id"},
          "kind": {"type": "string", "enum": ["direct", "indirect"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["frama-c-kernel", "gcc-callgraph-info", "type-match", "thread-spawn", "callback-arg", "alias"]}
          }
        },
        "required": ["caller", "callee", "kind", "sources"]
      }
    },
    "indirect_sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {"type": "string"},
          "units": {"type": "array", "items": {"type": "string"}},
          "caller": {"$ref": "#/definitions/function_id"},
          "expr": {"type": ["string", "null"]},
          "signature": {"$comment": "null when the GCC fallback found the site: no candidates then", "type": ["string", "null"]},
          "loc": {"type": ["string", "null"]},
          "candidates": {"$comment": "the type match, narrowed by Alias when narrowing is alias", "type": "array", "items": {"$ref": "#/definitions/function_id"}},
          "narrowing": {"type": "string", "enum": ["alias", "none"]},
          "narrowing_reason": {"$comment": "alias, or why the full type match stays: disabled, gcc_fallback, alias_<status> (failed, timeout, crashed, unavailable), no_state, no_targets, error, unmatched, disjoint (Alias names none of the type match), no_candidates (empty type match)", "type": "string"},
          "dropped": {"$comment": "type-match candidates Alias ruled out", "type": "array", "items": {"$ref": "#/definitions/function_id"}}
        },
        "required": ["unit", "caller", "signature", "candidates"]
      }
    },
    "externals": {"type": "array", "items": {"type": "string"}},
    "external_formals": {"$comment": "Step I9: the formals of external functions, from their prototypes", "type": "object", "additionalProperties": {"$ref": "#/definitions/formals"}},
    "external_decls": {
      "$comment": "S2: the first declaration of each external function (`decl`, a Frama-C location: FRAMAC_SHARE/libc/..., a path under the parse's tree, or an absolute header path) and its C text with typedef and parameter names (`proto`), from which scripts/stub_gen.py writes the stub skeletons",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {"decl": {"type": "string"}, "proto": {"type": "string"}, "signature": {"type": "string"}},
        "required": ["decl", "proto"],
        "additionalProperties": false
      }
    },
    "global_variables": {
      "$comment": "Step I9: defined global variables, `file#name`, where security properties naming them are anchored",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "file": {"type": "string"},
          "static": {"type": "boolean"},
          "type": {"$comment": "the canonical C type (typedefs unrolled, qualifiers dropped)", "type": "string"},
          "size": {"$comment": "Dump schema 6: sizeof(var) in bytes from Frama-C CIL when known, for type-free .bss link stubs", "type": ["integer", "null"], "minimum": 1},
          "units": {"type": "array", "items": {"type": "string"}},
          "init_functions": {"$comment": "Dump schema 6: the project functions whose address its initializer holds", "type": "array", "items": {"$ref": "#/definitions/function_id"}},
          "init_globals": {"$comment": "Dump schema 6: the project globals its initializer names", "type": "array", "items": {"type": "string"}},
          "unresolved_global_refs": {"$comment": "Dump schema 6: names of globals its initializer names that resolve to several definitions (see the function field)", "type": "array", "items": {"type": "string"}}
        },
        "required": ["name", "file", "static", "units"],
        "additionalProperties": false
      }
    },
    "macro_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "function": {"type": "string"},
          "ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/function_id"}},
          "via": {"type": "array", "items": {"type": "string"}},
          "defined_in": {"type": "string"},
          "source": {"const": "preprocessor"}
        },
        "required": ["function", "ids", "via", "defined_in", "source"]
      }
    },
    "entry_points": {"type": "array", "items": {"$ref": "#/definitions/function_id"}},
    "entry_points_source": {"type": "string"},
    "thread_entries": {"type": "array", "items": {"$ref": "#/definitions/function_id"}},
    "alias": {
      "$comment": "plan step I4: narrowing of indirect sites with Frama-C's Alias plugin (phase0_model.py --alias)",
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "module": {"type": "string", "enum": ["ok", "compile_failed"]},
        "error": {"type": "string"},
        "timeout_s": {"type": "integer", "minimum": 1},
        "sites": {"$comment": "indirect sites per narrowing_reason", "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "dropped_candidates": {"type": "integer", "minimum": 0},
        "seconds": {"type": "number", "minimum": 0}
      },
      "required": ["enabled"]
    },
    "parse_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {"type": "string"},
          "units": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["ok", "parse_failed"]},
          "seconds": {"type": "number", "minimum": 0},
          "error": {"type": "string"},
          "gcc_fallback": {"type": "object"},
          "parse_warnings": {"$ref": "#/definitions/parse_warnings"},
          "alias": {
            "type": "object",
            "properties": {
              "status": {"type": "string", "enum": ["ok", "failed", "timeout", "crashed", "unavailable"]},
              "error": {"type": "string"},
              "seconds": {"type": "number", "minimum": 0}
            },
            "required": ["status"]
          }
        },
        "required": ["key", "units", "sources", "status", "seconds"]
      }
    },
    "seconds": {"type": "number", "minimum": 0},
    "trust": {
      "$comment": "Step I7 (scripts/trust.py): the threat model and CodeQL used, counts, warnings.",
      "type": "object",
      "properties": {
        "generated_at": {"type": "string"},
        "threat_model": {
          "type": "object",
          "properties": {
            "status": {"type": "string", "enum": ["ok", "no_threat_model", "invalid_threat_model"]},
            "path": {"type": ["string", "null"]},
            "sha256": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]},
            "errors": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["status"]
        },
        "codeql": {"type": "object", "properties": {"status": {"type": "string"}}, "required": ["status"]},
        "input_readers": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["threat_model", "codeql", "summary", "warnings"]
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema_version", "generated_at", "status", "capture", "warnings"],
  "additionalProperties": false
}
