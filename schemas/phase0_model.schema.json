{
  "$comment": "Contract for workspace/reports/phase0_model.json, written by scripts/phase0_model.py run (plan step I3). Function ids are `file#name`, the file relative to the target root. Every function, edge and alias carries its source. Version 2 records external_calls, kernel_names, formals, writes and param_sizes on its functions; version 1 models stay valid and consumers read which facts they have with phase0_model.model_features. Fields (remediation R4, D9: kept when the report, the benchmark or a skill step shows them): thread_entries and parse_jobs are kept (the benchmark counts thread entries and sums parse seconds); alias is kept (the report summarizes an --alias run); a function's `included` (a .c file another source includes) is dropped: nothing read it.",
  "type": "object",
  "definitions": {
    "formals": {
      "$comment": "Step I9: a function's parameters; kind `pointer` (the pointee may be written: non-const pointer or array), `const_pointer` or `value`.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "kind": {"type": "string", "enum": ["pointer", "const_pointer", "value"]}},
        "required": ["name", "kind"],
        "additionalProperties": false
      }
    },
    "function_trust": {
      "$comment": "Step I7 (scripts/trust.py): value, the deciding rule, every rule marking it untrusted, whether attacker data reaches its parameters directly, and why.",
      "type": "object",
      "properties": {
        "value": {"type": "string", "enum": ["untrusted", "trusted"]},
        "source": {"type": "string", "enum": ["default", "call_graph", "threat_model", "codeql"]},
        "sources": {"type": "array", "items": {"type": "string", "enum": ["default", "call_graph", "threat_model", "codeql"]}},
        "boundary": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "overridden": {"$comment": "rules a threat-model trusted_callers decision overrode", "type": "array", "items": {"type": "string"}}
      },
      "required": ["value", "source", "sources", "boundary", "reasons"],
      "additionalProperties": false
    },
    "unit_trust": {
      "type": "object",
      "properties": {
        "threat_model": {"type": "string", "enum": ["ok", "no_threat_model", "invalid_threat_model"]},
        "functions": {"type": "integer", "minimum": 0},
        "untrusted": {"type": "integer", "minimum": 0},
        "boundary": {"type": "integer", "minimum": 0},
        "api": {"type": "integer", "minimum": 0}
      },
      "required": ["threat_model", "functions", "untrusted", "boundary", "api"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ok", "error", "no_unit_parsed"]},
    "error": {"type": "string"},
    "capture": {"type": "string"},
    "capture_generated_at": {"type": ["string", "null"]},
    "tree": {"type": "string"},
    "snapshot": {
      "type": "object",
      "properties": {"root": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"]}},
      "required": ["root", "digest"]
    },
    "dump_module": {
      "type": "object",
      "properties": {"status": {"type": "string", "enum": ["ok", "compile_failed"]}},
      "required": ["status"]
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["executable", "shared_lib", "static_lib", "unlinked"]},
          "test": {"type": "boolean"},
          "files": {"type": "array", "items": {"type": "string"}},
          "links": {"type": "array", "items": {"type": "string"}},
          "cppflags": {"type": ["array", "null"], "items": {"type": "string"}},
          "entry_points": {"type": ["array", "null"], "items": {"type": "string", "pattern": "#"}},
          "embedded_api": {"type": ["array", "null"], "items": {"type": "string", "pattern": "#"}},
          "parse": {
            "type": "object",
            "properties": {
              "status": {"type": "string", "enum": ["ok", "gcc_fallback", "skipped_test", "no_sources"]},
              "job": {"type": "string"},
              "seconds": {"type": "number", "minimum": 0},
              "error": {"$comment": "Frama-C's first error, when the unit fell back to GCC", "type": "string"}
            },
            "required": ["status"]
          },
          "concurrent": {"$comment": "the unit starts threads (pthread_create, thrd_create)", "type": "boolean"},
          "trust": {"$ref": "#/definitions/unit_trust"}
        },
        "required": ["kind", "test", "files", "links", "parse", "concurrent"]
      }
    },
    "functions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kernel_names": {"$comment": "unit -> Frama-C's name (same-named statics are renamed per parse)", "type": "object", "additionalProperties": {"type": "string"}},
          "units": {"type": "array", "items": {"type": "string"}},
          "line": {"type": "integer", "minimum": 0},
          "end_line": {"type": "integer", "minimum": 0},
          "lines": {"type": ["integer", "null"], "minimum": 1},
          "static": {"type": "boolean"},
          "inline": {"type": "boolean"},
          "header": {"$comment": "defined in a project header: belongs to every unit compiling it", "type": "boolean"},
          "signature": {"type": "string"},
          "loops": {"type": ["integer", "null"], "minimum": 0},
          "cyclomatic": {"type": ["integer", "null"], "minimum": 1},
          "address_taken": {"type": "boolean"},
          "source": {"type": "string", "enum": ["frama-c-kernel", "gcc-callgraph-info"]},
          "formals": {"$ref": "#/definitions/formals"},
          "writes": {
            "$comment": "Step I9: writes of its body: through a pointer (count), the formals they go through, globals written directly",
            "type": "object",
            "properties": {
              "pointer": {"type": "integer", "minimum": 0},
              "params": {"type": "array", "items": {"type": "string"}},
              "globals": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["pointer", "params", "globals"],
            "additionalProperties": false
          },
          "external_calls": {"$comment": "functions it calls that no unit of its program defines (libc, packages)", "type": "array", "items": {"type": "string"}},
          "param_sizes": {
            "$comment": "argument index -> bytes of the object the parsed callers pass there (an array, an object's address), when the call site shows it",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "min": {"type": "integer", "minimum": 1},
                "max": {"type": "integer", "minimum": 1},
                "sites": {"type": "integer", "minimum": 1}
              },
              "required": ["min", "max", "sites"],
              "additionalProperties": false
            }
          },
          "trust": {"$ref": "#/definitions/function_trust"}
        },
        "required": ["file", "name", "kernel_names", "units", "line", "static", "header", "signature", "address_taken", "source"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caller": {"type": "string", "pattern": "#"},
          "callee": {"type": "string", "pattern": "#"},
          "kind": {"type": "string", "enum": ["direct", "indirect"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["frama-c-kernel", "gcc-callgraph-info", "type-match", "thread-spawn", "callback-arg", "alias"]}
          }
        },
        "required": ["caller", "callee", "kind", "sources"]
      }
    },
    "indirect_sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {"type": "string"},
          "units": {"type": "array", "items": {"type": "string"}},
          "caller": {"type": "string", "pattern": "#"},
          "expr": {"type": ["string", "null"]},
          "signature": {"$comment": "null when the GCC fallback found the site: no candidates then", "type": ["string", "null"]},
          "loc": {"type": ["string", "null"]},
          "candidates": {"$comment": "the type match, narrowed by Alias when narrowing is alias", "type": "array", "items": {"type": "string", "pattern": "#"}},
          "narrowing": {"type": "string", "enum": ["alias", "none"]},
          "narrowing_reason": {"$comment": "alias, or why the full type match stays: disabled, gcc_fallback, alias_<status> (failed, timeout, crashed, unavailable), no_state, no_targets, error, unmatched, disjoint (Alias names none of the type match), no_candidates (empty type match)", "type": "string"},
          "dropped": {"$comment": "type-match candidates Alias ruled out", "type": "array", "items": {"type": "string", "pattern": "#"}}
        },
        "required": ["unit", "caller", "signature", "candidates"]
      }
    },
    "externals": {"type": "array", "items": {"type": "string"}},
    "external_formals": {"$comment": "Step I9: the formals of external functions, from their prototypes", "type": "object", "additionalProperties": {"$ref": "#/definitions/formals"}},
    "global_variables": {
      "$comment": "Step I9: defined global variables, `file#name`, where security properties naming them are anchored",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "file": {"type": "string"},
          "static": {"type": "boolean"},
          "type": {"$comment": "the canonical C type (typedefs unrolled, qualifiers dropped)", "type": "string"},
          "units": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["name", "file", "static", "units"],
        "additionalProperties": false
      }
    },
    "macro_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "function": {"type": "string"},
          "ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "#"}},
          "via": {"type": "array", "items": {"type": "string"}},
          "defined_in": {"type": "string"},
          "source": {"const": "preprocessor"}
        },
        "required": ["function", "ids", "via", "defined_in", "source"]
      }
    },
    "entry_points": {"type": "array", "items": {"type": "string", "pattern": "#"}},
    "entry_points_source": {"type": "string"},
    "thread_entries": {"type": "array", "items": {"type": "string", "pattern": "#"}},
    "alias": {
      "$comment": "plan step I4: narrowing of indirect sites with Frama-C's Alias plugin (phase0_model.py --alias)",
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "module": {"type": "string", "enum": ["ok", "compile_failed"]},
        "error": {"type": "string"},
        "timeout_s": {"type": "integer", "minimum": 1},
        "sites": {"$comment": "indirect sites per narrowing_reason", "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "dropped_candidates": {"type": "integer", "minimum": 0},
        "seconds": {"type": "number", "minimum": 0}
      },
      "required": ["enabled"]
    },
    "parse_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {"type": "string"},
          "units": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["ok", "parse_failed"]},
          "seconds": {"type": "number", "minimum": 0},
          "error": {"type": "string"},
          "gcc_fallback": {"type": "object"},
          "alias": {
            "type": "object",
            "properties": {
              "status": {"type": "string", "enum": ["ok", "failed", "timeout", "crashed", "unavailable"]},
              "error": {"type": "string"},
              "seconds": {"type": "number", "minimum": 0}
            },
            "required": ["status"]
          }
        },
        "required": ["key", "units", "sources", "status", "seconds"]
      }
    },
    "seconds": {"type": "number", "minimum": 0},
    "trust": {
      "$comment": "Step I7 (scripts/trust.py): the threat model and CodeQL used, counts, warnings.",
      "type": "object",
      "properties": {
        "generated_at": {"type": "string"},
        "threat_model": {
          "type": "object",
          "properties": {
            "status": {"type": "string", "enum": ["ok", "no_threat_model", "invalid_threat_model"]},
            "path": {"type": ["string", "null"]},
            "sha256": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]},
            "errors": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["status"]
        },
        "codeql": {"type": "object", "properties": {"status": {"type": "string"}}, "required": ["status"]},
        "input_readers": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["threat_model", "codeql", "summary", "warnings"]
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema_version", "generated_at", "status", "capture", "warnings"],
  "additionalProperties": false
}
