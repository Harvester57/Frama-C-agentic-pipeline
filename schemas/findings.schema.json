{
  "$comment": "Contract for findings.json: one verdict record per fingerprint. Checked by scripts/validate_artifacts.py findings (schema + semantic checks).",
  "type": "array",
  "maxItems": 5000,
  "items": {
    "oneOf": [
      {"$ref": "#/definitions/confirmed"},
      {"$ref": "#/definitions/needs_validation"},
      {"$ref": "#/definitions/rejected"}
    ]
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1, "visibleContent": true},
    "relpath": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$"},
    "fingerprint": {"type": "string", "minLength": 16, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+-]*#[A-Za-z_][A-Za-z0-9_]*::[A-Za-z0-9_]+::[0-9a-f]{10}$"},
    "coverage_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+-]*#[A-Za-z0-9_]+::(rte|l2_termination|l3_frame|l3_isolation|l4_auth_state|l4_auth_required|l4_invariant|l4_call_rule|l5_sanitized|l6_wiped|l6_no_leak)$"},
    "location": {
      "type": "object",
      "properties": {
        "file": {"$ref": "#/definitions/relpath"},
        "line": {"type": "integer", "minimum": 1},
        "function": {"$ref": "#/definitions/text"}
      },
      "required": ["file", "line", "function"],
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "properties": {
        "kind": {"$ref": "#/definitions/text"},
        "predicate": {"$ref": "#/definitions/text"}
      },
      "required": ["kind", "predicate"],
      "additionalProperties": false
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["entrypoint", "propagation", "sink"]},
          "file": {"$ref": "#/definitions/relpath"},
          "line": {"type": "integer", "minimum": 1},
          "function": {"$ref": "#/definitions/text"},
          "description": {"$ref": "#/definitions/text"}
        },
        "required": ["kind", "file", "line", "function", "description"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "phase": {"type": "string", "enum": ["fuzz", "eva", "wp", "breaker", "verifier", "audit"]},
          "tool_output": {"$ref": "#/definitions/relpath"},
          "description": {"$ref": "#/definitions/text"}
        },
        "required": ["phase", "tool_output", "description"],
        "additionalProperties": false
      }
    },
    "linked_units": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/coverage_id"}
    },
    "linked_units_nonempty": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/coverage_id"}
    },
    "verifier": {
      "type": "object",
      "properties": {
        "agent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "method": {"type": "string", "enum": ["reproduced", "source_review", "reproduced_and_source_review"]},
        "notes": {"$ref": "#/definitions/text"}
      },
      "required": ["agent_id", "method", "notes"],
      "additionalProperties": false
    },
    "reachability": {"type": "string", "enum": ["untrusted_surface", "internal_api"]},
    "decision_point": {
      "type": "object",
      "description": "Optional. The earliest step at which a value chosen outside the target makes the failure inevitable, and who controls that value. A reviewed claim of the verifier, not an analysis result.",
      "properties": {
        "file": {"$ref": "#/definitions/relpath"},
        "line": {"type": "integer", "minimum": 1},
        "function": {"$ref": "#/definitions/text"},
        "controlled_by": {"type": "string", "enum": ["attacker_input", "harness_choice", "environment"]},
        "description": {"$ref": "#/definitions/text"},
        "basis": {
          "type": "string",
          "description": "Optional. What the decision point rests on: 'checked' (set by ledger.py ingest-verifier only, from an agreeing scripts/decision_point_check.py report: a patch at that location removes the failure for the recorded reproducers, nothing more), 'located' (traced in the source, file and line cited), 'model' (reasoning only).",
          "enum": ["checked", "located", "model"]
        }
      },
      "required": ["file", "line", "function", "controlled_by", "description"],
      "additionalProperties": false
    },
    "prior_verdicts": {
      "type": "array",
      "description": "Written by ledger.py ingest-verifier only. The rejection(s) this record superseded after later tool evidence reopened the candidate, oldest first.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "verdict": {"const": "rejected"},
          "fingerprint": {"$ref": "#/definitions/fingerprint"},
          "rejection_class": {"type": "string", "enum": ["harness_induced", "dead_code", "toolchain_artifact", "contract_overconstraint", "disproved_by_source", "duplicate", "other"]},
          "reason": {"$ref": "#/definitions/text"},
          "refutation_basis": {"$ref": "#/definitions/refutation_basis"},
          "evidence": {"$ref": "#/definitions/evidence"},
          "verifier": {"$ref": "#/definitions/verifier"},
          "superseded_at": {"type": "string", "minLength": 1},
          "reopened_by": {
            "type": "object",
            "properties": {
              "source": {"type": "string", "enum": ["breaker_crash_found", "guardrail_code_fault", "fuzz_reproducer", "sibling_verdict"]},
              "artifact": {"$ref": "#/definitions/relpath"},
              "tool_output": {"$ref": "#/definitions/relpath"}
            },
            "required": ["source", "artifact", "tool_output"],
            "additionalProperties": false
          }
        },
        "required": ["verdict", "fingerprint", "rejection_class", "reason", "evidence", "verifier", "superseded_at", "reopened_by"],
        "additionalProperties": false
      }
    },
    "conflicts_with": {
      "type": "array",
      "description": "Written by ledger.py ingest-verifier only. Records at the same sink (file, function, baseline line, kind) whose verdict is the opposite one: confirmed / needs_validation against rejected (any class but duplicate). Not reconciled automatically; the report lists the pair.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/fingerprint"}
    },
    "refutation_basis": {
      "type": "string",
      "description": "Optional. What a rejection rests on: 'checked' (a tool output cited in evidence refutes the candidate), 'located' (file and line of the check or dead branch, no tool output), 'model' (reasoning only).",
      "enum": ["checked", "located", "model"]
    },
    "confirmed": {
      "type": "object",
      "description": "A reproduced E-ACSL failure in target code through a harness that respected the entry function's contract.",
      "properties": {
        "verdict": {"const": "confirmed"},
        "fingerprint": {"$ref": "#/definitions/fingerprint"},
        "title": {"$ref": "#/definitions/text"},
        "description": {"$ref": "#/definitions/text"},
        "location": {"$ref": "#/definitions/location"},
        "property": {"$ref": "#/definitions/property"},
        "root_cause": {"$ref": "#/definitions/text"},
        "decision_point": {"$ref": "#/definitions/decision_point"},
        "prior_verdicts": {"$ref": "#/definitions/prior_verdicts"},
        "conflicts_with": {"$ref": "#/definitions/conflicts_with"},
        "intended_behavior": {"$ref": "#/definitions/text"},
        "trace": {"$ref": "#/definitions/trace"},
        "evidence": {"$ref": "#/definitions/evidence"},
        "reachability": {"$ref": "#/definitions/reachability"},
        "harness": {
          "type": "object",
          "properties": {
            "file": {"$ref": "#/definitions/relpath"},
            "entry_function": {"$ref": "#/definitions/text"},
            "contract_respected": {"const": true},
            "notes": {"$ref": "#/definitions/text"}
          },
          "required": ["file", "entry_function", "contract_respected", "notes"],
          "additionalProperties": false
        },
        "reproducers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "input": {"$ref": "#/definitions/relpath"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "command": {"$ref": "#/definitions/text"},
              "observed_result": {"$ref": "#/definitions/text"}
            },
            "required": ["input", "sha256", "size_bytes", "command", "observed_result"],
            "additionalProperties": false
          }
        },
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
        "severity_rationale": {"$ref": "#/definitions/text"},
        "remediation": {
          "type": "object",
          "properties": {
            "summary": {"$ref": "#/definitions/text"},
            "invariant": {"$ref": "#/definitions/text"},
            "fix_patch": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/relpath"}]}
          },
          "required": ["summary", "invariant", "fix_patch"],
          "additionalProperties": false
        },
        "linked_units": {"$ref": "#/definitions/linked_units_nonempty"},
        "verifier": {"$ref": "#/definitions/verifier"}
      },
      "required": ["verdict", "fingerprint", "title", "description", "location", "property", "root_cause", "intended_behavior", "trace", "evidence", "reachability", "harness", "reproducers", "severity", "severity_rationale", "remediation", "linked_units", "verifier"],
      "additionalProperties": false
    },
    "needs_validation": {
      "type": "object",
      "description": "A specific source-grounded fault hypothesis that could not be reproduced. No severity.",
      "properties": {
        "verdict": {"const": "needs_validation"},
        "fingerprint": {"$ref": "#/definitions/fingerprint"},
        "title": {"$ref": "#/definitions/text"},
        "description": {"$ref": "#/definitions/text"},
        "location": {"$ref": "#/definitions/location"},
        "property": {"$ref": "#/definitions/property"},
        "origin": {"type": "string", "enum": ["eva_invalid_no_witness", "fault_hypothesis", "fuzz_timeout_or_oom", "fuzz_unreproduced"]},
        "claimed_root_cause": {"$ref": "#/definitions/text"},
        "decision_point": {"$ref": "#/definitions/decision_point"},
        "prior_verdicts": {"$ref": "#/definitions/prior_verdicts"},
        "conflicts_with": {"$ref": "#/definitions/conflicts_with"},
        "trace": {"$ref": "#/definitions/trace"},
        "evidence": {"$ref": "#/definitions/evidence"},
        "reachability": {"type": "string", "enum": ["untrusted_surface", "internal_api", "unknown"]},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/text"}},
        "validation_plan": {
          "type": "object",
          "properties": {
            "local": {"$ref": "#/definitions/text"},
            "owner": {"$ref": "#/definitions/text"}
          },
          "anyOf": [{"required": ["local"]}, {"required": ["owner"]}],
          "additionalProperties": false
        },
        "linked_units": {"$ref": "#/definitions/linked_units"},
        "verifier": {"$ref": "#/definitions/verifier"}
      },
      "required": ["verdict", "fingerprint", "title", "description", "location", "property", "origin", "claimed_root_cause", "trace", "evidence", "reachability", "blockers", "validation_plan", "linked_units", "verifier"],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "description": "A candidate disproved during verification, retained so the identical claim is not verified twice in this run; a new reproduced failure can reopen it (ledger.py, FRAMAC_REJECTION_REOPEN).",
      "properties": {
        "verdict": {"const": "rejected"},
        "fingerprint": {"$ref": "#/definitions/fingerprint"},
        "title": {"$ref": "#/definitions/text"},
        "description": {"$ref": "#/definitions/text"},
        "location": {"$ref": "#/definitions/location"},
        "property": {"$ref": "#/definitions/property"},
        "claimed_root_cause": {"$ref": "#/definitions/text"},
        "evidence": {"$ref": "#/definitions/evidence"},
        "rejection_class": {"type": "string", "enum": ["harness_induced", "dead_code", "toolchain_artifact", "contract_overconstraint", "disproved_by_source", "duplicate", "other"]},
        "reason": {"$ref": "#/definitions/text"},
        "refutation_basis": {"$ref": "#/definitions/refutation_basis"},
        "prior_verdicts": {"$ref": "#/definitions/prior_verdicts"},
        "conflicts_with": {"$ref": "#/definitions/conflicts_with"},
        "linked_units": {"$ref": "#/definitions/linked_units"},
        "verifier": {"$ref": "#/definitions/verifier"}
      },
      "required": ["verdict", "fingerprint", "title", "description", "location", "property", "claimed_root_cause", "evidence", "rejection_class", "reason", "linked_units", "verifier"],
      "additionalProperties": false
    }
  }
}
