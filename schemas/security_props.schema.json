{
  "$comment": "Contract for workspace/reports/security_props.json, written by scripts/security_props.py run (plan step I9): the MetAcsl security properties the threat model requires (L4-L6), the frame obligations (L3), and the ledger obligations per function (`file#name`).",
  "type": "object",
  "definitions": {
    "function_id": {"$comment": "A function id, `file#name`: the file relative to the target root (any character but `#`), then one symbol name. The name may carry what nm prints for a compiler clone or a versioned symbol (`parse.constprop.0`, `f@@VERS_1`).", "type": "string", "pattern": "^(?:[^#\\s]+|[^#\\s][^#\\r\\n]*\\/[^#/\\s]+)#[A-Za-z_$][A-Za-z0-9_$.@]*$"},
    "class": {"type": "string", "enum": ["l3_frame", "l4_auth_state", "l4_auth_required", "l5_sanitized", "l6_wiped", "l6_no_leak"]}
  },
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "threat_model": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["ok", "no_threat_model", "invalid_threat_model"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      },
      "required": ["status"]
    },
    "preamble": {"$comment": "ACSL every meta file starts with (templates/metacsl/preamble.acsl)", "type": "string"},
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "pattern": "^L[4-6]_(auth_state|auth_required|sanitized|wiped|no_leak)_[A-Za-z0-9_]+$"},
          "layer": {"type": "integer", "minimum": 4, "maximum": 6},
          "kind": {"type": "string", "enum": ["auth_state", "auth_required", "sanitized", "wiped", "no_leak"]},
          "obligation_class": {"$ref": "#/definitions/class"},
          "acsl": {"$comment": "the meta-property annotation(s), ready to parse", "type": "string", "minLength": 1},
          "instances": {"$comment": "functions whose WP proof holds the generated annotations: the ledger units", "type": "array", "items": {"$ref": "#/definitions/function_id"}},
          "sources": {"$comment": "files defining the globals the property names, parsed with every WP run that loads it", "type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}},
          "targets": {"type": "string"},
          "threat_model": {"$comment": "the threat-model item the property comes from", "type": "object"},
          "decided": {
            "$comment": "instances decided from the model instead of by a WP goal (plan step M2): not in `instances`, recorded by the ledger seed",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "function": {"$ref": "#/definitions/function_id"},
                "verdict": {"type": "string", "enum": ["satisfied", "violated"]},
                "how": {"type": "string", "enum": ["syntactic"]},
                "reason": {"type": "string", "minLength": 1}
              },
              "required": ["function", "verdict", "how", "reason"],
              "additionalProperties": false
            }
          },
          "taint": {
            "$comment": "where the work tree gets Eva taint annotations for this secret (plan step M3, `run --eva-taint`)",
            "type": "object",
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "function": {"$ref": "#/definitions/function_id"},
                    "at": {"type": "string", "enum": ["entry", "return"]},
                    "lvalues": {"type": "string", "minLength": 1}
                  },
                  "required": ["function", "at", "lvalues"],
                  "additionalProperties": false
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "function": {"$ref": "#/definitions/function_id"},
                    "sink": {"type": "string", "minLength": 1},
                    "args": {"$comment": "[pointer argument index, length argument index or null]", "type": "array", "items": {"type": "array"}}
                  },
                  "required": ["function", "sink", "args"],
                  "additionalProperties": false
                }
              },
              "notes": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["sources", "checks", "notes"],
            "additionalProperties": false
          },
          "code": {
            "$comment": "a property written into the work tree, not into the meta file: a local secret's wipe `check` (plan step M6, `local`) or an auth gate's failure `check` before each return (M7, `returns`; `${result}` stands for the returned expression)",
            "type": "object",
            "properties": {
              "local": {"type": "string", "minLength": 1},
              "returns": {"const": true},
              "check": {"type": "string", "minLength": 1}
            },
            "required": ["check"],
            "additionalProperties": false
          },
          "direct_writers": {"type": "array", "items": {"type": "string"}},
          "entry_points": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["name", "layer", "kind", "obligation_class", "acsl", "instances", "sources", "notes"],
        "additionalProperties": false
      }
    },
    "frame": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"function": {"$ref": "#/definitions/function_id"}, "reason": {"type": "string"}},
        "required": ["function", "reason"],
        "additionalProperties": false
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "class": {"$ref": "#/definitions/class"},
            "property": {"type": "string"},
            "reason": {"type": "string"},
            "decided": {"$comment": "decided from the model, no WP goal (plan step M2)", "type": "string", "enum": ["satisfied", "violated"]},
            "decided_reason": {"type": "string", "minLength": 1}
          },
          "required": ["class", "property", "reason"],
          "additionalProperties": false
        }
      }
    },
    "summary": {"type": "object"},
    "code_checks": {
      "$comment": "plan step M6: each in-code check placed in the work tree (file, line: where Eva reports its status)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "function": {"$ref": "#/definitions/function_id"},
          "property": {"type": "string"}
        },
        "required": ["file", "line", "function", "property"],
        "additionalProperties": false
      }
    },
    "eva_taint": {
      "$comment": "the Eva taint annotations written into the work tree (plan step M3); absent from reports older than it",
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "files": {"type": "array", "items": {"type": "string"}},
        "functions": {"type": "array", "items": {"type": "string"}},
        "checks": {
          "$comment": "each taint check placed: where Eva reports its status (ledger.py ingest-eva names the property from it)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer"},
              "function": {"$ref": "#/definitions/function_id"},
              "property": {"type": "string"}
            },
            "required": ["file", "line", "function", "property"],
            "additionalProperties": false
          }
        },
        "skipped": {"type": "array", "items": {"type": "string"}},
        "modules": {"$comment": "harness modules whose EVA_TAINT this run set", "type": "array", "items": {"type": "string"}},
        "pending": {"type": "string"}
      },
      "required": ["enabled", "files", "functions", "checks", "skipped"],
      "additionalProperties": false
    },
    "meta_engines": {
      "$comment": "the engines that check the MetAcsl properties besides WP (run --meta-engines, sticky): eva loads them in each harness module's Phase 2 run, eacsl compiles them into the Phase 1 fuzz build; absent or empty: WP only",
      "type": "array",
      "items": {"type": "string", "enum": ["eva", "eacsl"]},
      "uniqueItems": true
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema_version", "generated_at", "threat_model", "preamble", "properties", "frame", "obligations", "summary", "warnings"],
  "additionalProperties": false
}
