{
  "$comment": "Contract for candidates.json: tool-detected candidates awaiting an independent verdict. Written by scripts/ledger.py ingestion; a run with unverified candidates cannot be complete.",
  "type": "array",
  "definitions": {
    "fingerprint": {"type": "string", "minLength": 16, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+-]*#[A-Za-z_][A-Za-z0-9_]*::[A-Za-z0-9_]+::[0-9a-f]{10}$"}
  },
  "maxItems": 20000,
  "items": {
    "type": "object",
    "properties": {
      "fingerprint": {"$ref": "#/definitions/fingerprint"},
      "status": {"type": "string", "enum": ["unverified", "verified"]},
      "origin": {"type": "string", "enum": ["fuzz", "eva", "breaker", "prover"]},
      "proposed_verdict": {"type": "string", "enum": ["confirmed", "needs_validation"]},
      "module": {"type": "string"},
      "location": {
        "type": "object",
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 0},
          "function": {"type": "string", "minLength": 1}
        },
        "required": ["file", "line", "function"],
        "additionalProperties": false
      },
      "property": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "predicate": {"type": "string"}
        },
        "required": ["kind", "predicate"],
        "additionalProperties": false
      },
      "reproducers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "tool_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "linked_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "first_seen": {"type": "string", "minLength": 1},
      "site": {
        "type": "string",
        "minLength": 1,
        "description": "The statement site of the detections (failure_identity.site_key). Two detections at one site are one candidate (D1). Absent on candidates recorded before the site key."
      },
      "observations": {
        "type": "array",
        "description": "Every detection that landed on this candidate: one entry per fingerprint, origin and engine (D1). Absent on candidates recorded before the site key.",
        "items": {
          "type": "object",
          "properties": {
            "fingerprint": {"type": "string", "minLength": 1},
            "origin": {"type": "string", "minLength": 1},
            "engine": {"type": ["string", "null"]},
            "kind": {"type": "string"},
            "message": {"type": "string"},
            "tool_output": {"type": "string"},
            "reproducer": {"type": ["string", "null"]}
          },
          "required": ["fingerprint", "origin", "engine", "kind", "message", "tool_output", "reproducer"],
          "additionalProperties": false
        }
      },
      "related": {
        "type": "array",
        "description": "Candidates that another engine reports on the same reproducer, in the same file and function (D1b, link-related).",
        "items": {
          "type": "object",
          "properties": {
            "fingerprint": {"$ref": "#/definitions/fingerprint"},
            "reason": {"type": "string", "minLength": 1}
          },
          "required": ["fingerprint", "reason"],
          "additionalProperties": false
        }
      },
      "notes": {"type": "array", "items": {"type": "string"}},
      "resolved_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/fingerprint"}},
      "refingerprint_reason": {"type": ["string", "null"]},
      "last_rejection": {
        "type": "object",
        "description": "Written by ledger.py ingest-verifier for a rejected candidate (FRAMAC_REJECTION_REOPEN on): what a later tool-reproduced signal is weighed against.",
        "properties": {
          "at": {"type": "string", "minLength": 1},
          "rejection_class": {"type": "string", "enum": ["harness_induced", "dead_code", "toolchain_artifact", "contract_overconstraint", "disproved_by_source", "duplicate", "other"]},
          "refutation_basis": {"type": "string", "enum": ["checked", "located", "model", "unstated"]},
          "refutation_basis_source": {"type": "string", "minLength": 1},
          "harness_sha256": {"type": ["string", "null"]},
          "repair_attempts": {"type": ["integer", "null"], "minimum": 0}
        },
        "required": ["at", "rejection_class", "refutation_basis", "harness_sha256", "repair_attempts"],
        "additionalProperties": false
      },
      "reopened": {
        "type": "array",
        "description": "One entry each time later tool-reproduced evidence put a rejected candidate back to 'unverified'. 'resolved' is added by the verdict that follows.",
        "items": {
          "type": "object",
          "properties": {
            "at": {"type": "string", "minLength": 1},
            "evidence": {
              "type": "object",
              "properties": {
                "source": {"type": "string", "enum": ["breaker_crash_found", "guardrail_code_fault", "fuzz_reproducer", "sibling_verdict"]},
                "artifact": {"type": "string", "minLength": 1},
                "tool_output": {"type": "string", "minLength": 1}
              },
              "required": ["source", "artifact", "tool_output"],
              "additionalProperties": false
            },
            "rejection_class": {"type": "string", "enum": ["harness_induced", "dead_code", "toolchain_artifact", "contract_overconstraint", "disproved_by_source", "duplicate", "other"]},
            "refutation_basis": {"type": "string", "enum": ["checked", "located", "model", "unstated"]},
            "refutation_basis_source": {"type": "string", "minLength": 1},
            "rejected_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/fingerprint"}},
            "harness_changed": {"type": "boolean"},
            "refingerprint_reason": {"type": "string"},
            "resolved": {
              "type": "object",
              "properties": {
                "at": {"type": "string", "minLength": 1},
                "decision": {"type": "string", "enum": ["confirmed", "needs_validation", "rejected"]},
                "resolved_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/fingerprint"}}
              },
              "required": ["at", "decision", "resolved_fingerprints"],
              "additionalProperties": false
            }
          },
          "required": ["at", "evidence", "rejection_class", "refutation_basis", "rejected_fingerprints"],
          "additionalProperties": false
        }
      },
      "contradicting_evidence": {
        "type": "array",
        "description": "Tool-reproduced evidence against a rejection that did not reopen the candidate, with the reason.",
        "items": {
          "type": "object",
          "properties": {
            "at": {"type": "string", "minLength": 1},
            "source": {"type": "string", "enum": ["breaker_crash_found", "guardrail_code_fault", "fuzz_reproducer", "sibling_verdict"]},
            "artifact": {"type": "string", "minLength": 1},
            "tool_output": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "enum": ["checked_rejection", "harness_unchanged", "reopen_limit"]},
            "rejection_class": {"type": "string", "enum": ["harness_induced", "dead_code", "toolchain_artifact", "contract_overconstraint", "disproved_by_source", "duplicate", "other"]},
            "refutation_basis": {"type": "string", "enum": ["checked", "located", "model", "unstated"]},
            "refutation_basis_source": {"type": "string", "minLength": 1}
          },
          "required": ["at", "source", "artifact", "tool_output", "reason", "rejection_class", "refutation_basis"],
          "additionalProperties": false
        }
      }
    },
    "required": ["fingerprint", "status", "origin", "proposed_verdict", "module", "location", "property", "reproducers", "tool_outputs", "linked_units", "first_seen"],
    "additionalProperties": false
  }
}
