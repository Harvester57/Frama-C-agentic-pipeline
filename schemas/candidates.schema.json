{
  "$comment": "Contract for candidates.json: tool-detected candidates awaiting an independent verdict. Written by scripts/ledger.py ingestion; a run with unverified candidates cannot be complete.",
  "type": "array",
  "maxItems": 20000,
  "items": {
    "type": "object",
    "properties": {
      "fingerprint": {"type": "string", "minLength": 16, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+-]*#[A-Za-z_][A-Za-z0-9_]*::[A-Za-z0-9_]+::[0-9a-f]{10}$"},
      "status": {"type": "string", "enum": ["unverified", "verified"]},
      "origin": {"type": "string", "enum": ["fuzz", "eva", "breaker", "prover"]},
      "proposed_verdict": {"type": "string", "enum": ["confirmed", "needs_validation"]},
      "module": {"type": "string"},
      "location": {
        "type": "object",
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 0},
          "function": {"type": "string", "minLength": 1}
        },
        "required": ["file", "line", "function"],
        "additionalProperties": false
      },
      "property": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "predicate": {"type": "string"}
        },
        "required": ["kind", "predicate"],
        "additionalProperties": false
      },
      "reproducers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "tool_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "linked_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "first_seen": {"type": "string", "minLength": 1},
      "notes": {"type": "array", "items": {"type": "string"}},
      "resolved_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 16, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+-]*#[A-Za-z_][A-Za-z0-9_]*::[A-Za-z0-9_]+::[0-9a-f]{10}$"}},
      "refingerprint_reason": {"type": ["string", "null"]}
    },
    "required": ["fingerprint", "status", "origin", "proposed_verdict", "module", "location", "property", "reproducers", "tool_outputs", "linked_units", "first_seen"],
    "additionalProperties": false
  }
}
