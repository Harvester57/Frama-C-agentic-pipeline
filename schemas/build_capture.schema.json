{
  "$comment": "Contract for workspace/reports/build_capture.json, written by scripts/build_capture.py run (plan step I2). Paths of the target's files are relative to the target root; scratch, compiler and system paths are absolute paths in the build container (the scratch volume is mounted at the same path wherever it is used).",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ok", "needs_build_recipe", "unsupported_architecture", "error"]},
    "architecture": {
      "$comment": "The architecture guard (build_capture.ARCH_RULE): x86_64 Linux only. `host` is the machine the capture ran on. The counts and `unsupported` are set once the build ran: the objects, executables and shared libraries it produced, by file header (`decided_by: header`) or, for a file that cannot be read, by its command line (`command_line`). A non-empty `unsupported`, or a host that is not x86_64, gives status unsupported_architecture.",
      "type": "object",
      "properties": {
        "supported": {"const": "x86_64"},
        "host": {"type": "string", "minLength": 1},
        "rule": {"type": "string"},
        "files": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "unsupported_total": {"type": "integer", "minimum": 0},
        "unsupported": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "sources": {"type": "array", "items": {"type": "string"}},
              "found": {"type": "string", "minLength": 1},
              "why": {"type": ["string", "null"]},
              "decided_by": {"type": "string", "enum": ["header", "command_line"]}
            },
            "required": ["file", "sources", "found", "why", "decided_by"]
          }
        }
      },
      "required": ["supported", "host"]
    },
    "target": {"type": "string", "minLength": 1},
    "error": {"type": "string"},
    "scratch": {
      "type": "object",
      "properties": {
        "root": {"type": "string"},
        "tree": {"type": "string"}
      },
      "required": ["root", "tree"]
    },
    "recipe": {
      "type": ["object", "null"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "workdir": {"type": "string", "minLength": 1},
        "packages": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "test_command": {"type": ["string", "null"]},
        "install_command": {"type": ["string", "null"]},
        "snapshot_extra": {"type": "array", "items": {"type": "string"}},
        "origin": {"type": "string"}
      },
      "required": ["command", "workdir", "packages", "env", "test_command", "origin"]
    },
    "build": {
      "type": ["object", "null"],
      "properties": {
        "returncode": {"type": "integer"},
        "timed_out": {"type": "boolean"},
        "seconds": {"type": "number", "minimum": 0},
        "jobs": {"type": "integer", "minimum": 1},
        "attempts": {
          "$comment": "One per build run: a build that fails or times out in parallel is retried once with one job.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jobs": {"type": "integer", "minimum": 1},
              "returncode": {"type": "integer"},
              "timed_out": {"type": "boolean"},
              "seconds": {"type": "number", "minimum": 0}
            },
            "required": ["jobs", "returncode", "seconds"]
          }
        },
        "tree_files": {"type": "integer", "minimum": 0},
        "executions": {"type": "integer", "minimum": 0},
        "probes_dropped": {"type": "integer", "minimum": 0},
        "log": {"type": "string"},
        "events": {"type": "string"}
      },
      "required": ["returncode", "timed_out", "seconds", "executions", "log", "events"]
    },
    "diagnostics": {
      "$comment": "Set when status is needs_build_recipe (what the agent shows the user when it asks for a recipe) or unsupported_architecture (`first_error` and `instructions`: what to do on a host or for a target that is not x86_64).",
      "type": ["object", "null"],
      "properties": {
        "first_error": {"type": "string"},
        "context": {"type": "array", "items": {"type": "string"}},
        "missing_headers": {"type": "array", "items": {"type": "string"}},
        "missing_commands": {"type": "array", "items": {"type": "string"}},
        "candidate_packages": {"type": "array", "items": {"type": "string"}},
        "packages_not_installed": {"type": "array", "items": {"type": "string"}},
        "proposed_recipe": {"type": ["object", "null"]},
        "instructions": {"type": "array", "items": {"type": "string"}},
        "heuristic": {"type": "string"},
        "log_tail": {"type": "string"},
        "crlf_scripts": {
          "$comment": "Set when the failed build points at scripts with CRLF line endings (a Windows checkout): how many the tree holds, the first paths, and whether the bounded scan saw the whole tree. The matching hint is in `warnings`.",
          "type": "object",
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "paths": {"type": "array", "items": {"type": "string"}},
            "complete": {"type": "boolean"}
          },
          "required": ["count", "paths", "complete"],
          "additionalProperties": false
        }
      },
      "required": ["first_error", "missing_headers", "candidate_packages", "packages_not_installed"]
    },
    "compiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "object": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "minLength": 1},
          "compiler": {"type": "string"},
          "arguments": {"type": "array", "items": {"type": "string"}},
          "flags": {"$comment": "-I -iquote -isystem -idirafter -include -imacros (value as next token, relative to the target root), -D -U (joined), -std=", "type": "array", "items": {"type": "string"}},
          "system_flags": {"$comment": "include options naming directories or files outside the tree (absolute)", "type": "array", "items": {"type": "string"}},
          "headers": {"$comment": "project headers the compiler's dependency list names (generated ones included)", "type": "array", "items": {"type": "string"}},
          "includes_setjmp_h": {"$comment": "the dependency list names the libc's <setjmp.h> (not bits/setjmp.h, which glibc's <pthread.h> includes): E-ACSL cannot build it (build_callgraph_dag.route_nonlocal_jumps)", "type": "boolean"},
          "defined_functions": {"$comment": "functions the object defines (nm), as `file#name` ids: compared with the model by build_callgraph_dag (build_only_functions)", "type": "array", "items": {"type": "string"}},
          "probe_errors": {"$comment": "why the dependency (`deps`) or symbol (`symbols`) probe of this compile failed; {} when both ran, so empty `headers`/`defined_functions` mean the object includes/defines nothing. Absent in captures that predate it", "type": "object", "properties": {"deps": {"type": "string"}, "symbols": {"type": "string"}}, "additionalProperties": false}
        },
        "required": ["source", "object", "cwd", "compiler", "arguments", "flags", "system_flags", "headers"]
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["executable", "shared_lib", "static_lib", "unlinked"]},
          "test": {"type": "boolean"},
          "test_reason": {"type": ["string", "null"], "enum": ["name", "directory", "test_sources", "name_and_sources", "main_in_test_source", null]},
          "files": {"type": "array", "items": {"type": "string"}},
          "objects": {"type": "array", "items": {"type": "string"}},
          "links": {"type": "array", "items": {"type": "string"}},
          "external_libs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"ref": {"type": "string"}, "libdirs": {"type": "array", "items": {"type": "string"}}},
              "required": ["ref", "libdirs"]
            }
          },
          "compiler": {"type": ["string", "null"]},
          "cppflags": {"type": "array", "items": {"type": "string"}},
          "entry_points": {"type": "array", "items": {"$ref": "#/definitions/function_id"}},
          "embedded_api": {"$comment": "executables: globals of non-main files declared in the project headers they include", "type": "array", "items": {"$ref": "#/definitions/function_id"}}
        },
        "required": ["kind", "test", "test_reason", "files", "objects", "links", "external_libs", "cppflags", "entry_points", "embedded_api"]
      }
    },
    "entry_points": {"type": "array", "items": {"$ref": "#/definitions/function_id"}},
    "public_headers": {
      "type": ["object", "null"],
      "properties": {
        "method": {"type": ["string", "null"], "enum": ["install", "outside_source_dirs", "consumers", null]},
        "files": {"type": "array", "items": {"type": "string"}},
        "install": {"type": "string"}
      },
      "required": ["method", "files"]
    },
    "snapshot": {
      "type": ["object", "null"],
      "properties": {
        "root": {"type": "string"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {"type": "integer", "minimum": 0},
        "headers": {"type": "array", "items": {"$ref": "#/definitions/system_file"}},
        "libraries": {"type": "array", "items": {"$ref": "#/definitions/system_file"}},
        "excluded": {"type": "object"},
        "packages": {"type": "array", "items": {"type": "string"}},
        "extra": {"type": "array", "items": {"type": "string"}},
        "generated": {
          "$comment": "Headers the build generated (named by cc -M, absent from the target), copied into the snapshot.",
          "type": "object",
          "properties": {
            "headers": {"type": "array", "items": {"type": "string"}},
            "include_dirs": {"type": "array", "items": {"type": "string"}}
          }
        },
        "framac_libc_gaps": {
          "$comment": "Libc headers named by cc -M that Frama-C's libc lacks (linux-libc-dev's, glibc's elf.h), copied to <snapshot>/libc/<path> for Frama-C parses (scripts/target_env.py). `path` is where an #include finds the header, `source` the real path cc -M named when a symlinked system directory differs (Debian's x86_64-linux-gnu/asm). Absent in an older capture.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "package": {"type": ["string", "null"]},
              "source": {"type": "string", "minLength": 1}
            },
            "required": ["path", "package"],
            "additionalProperties": false
          }
        }
      },
      "required": ["root", "digest", "files", "headers", "libraries", "packages"]
    },
    "test_rule": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "seconds": {"type": "number", "minimum": 0}
  },
  "required": ["schema_version", "generated_at", "status", "target", "warnings"],
  "additionalProperties": false,
  "definitions": {
    "function_id": {"$comment": "A function id, `file#name`: the file relative to the target root (any character but `#`), then one symbol name. The name may carry what nm prints for a compiler clone or a versioned symbol (`parse.constprop.0`, `f@@VERS_1`).", "type": "string", "pattern": "^(?:[^#\\s]+|[^#\\s][^#\\r\\n]*\\/[^#/\\s]+)#[A-Za-z_$][A-Za-z0-9_$.@]*$"},
    "system_file": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "package": {"type": ["string", "null"]},
        "class": {"type": "string", "enum": ["package", "unowned"]},
        "via": {"type": "string", "enum": ["link", "needed"]}
      },
      "required": ["path", "package", "class"]
    }
  }
}
