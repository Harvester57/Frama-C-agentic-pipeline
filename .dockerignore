# Ignore everything by default to keep Docker build context minimal
*

# Allow only the directories copied by Dockerfile
!scripts/
!scripts/**
!templates/
!templates/**
!schemas/
!schemas/**
!skills/
!skills/**
# Only the greppable Frama-C manuals from docs/ (do not re-include docs/ itself: that would pull in all of it)
!docs/references/
!docs/references/**

# Exclude Python bytecode/caches inside allowed directories
**/__pycache__/
**/*.py[cod]
**/*$py.class
