/*
 * LibFuzzer Entry Point (Compiled via e-acsl-gcc or clang -fsanitize=fuzzer)
 * Do not define LLVMFuzzerInitialize here: E-ACSL builds link
 * templates/eacsl_runtime/fuzz_init.c, which defines it to initialize the
 * E-ACSL runtime (run_eacsl_fuzz.py refuses with eacsl_init_hook_conflict).
 *
 * An input that reaches no target code returns -1, so libFuzzer keeps it out of the corpus
 * (libFuzzer's input rejection; clang 19 of the analysis image has it): one longer than
 * MAX_INPUT_SIZE, and, through FRAMAC_FUZZ_REJECT(), one a dispatch harness turns away (no selector
 * byte, a case the campaign skips) or a case's own length guard rejects before any call.
 */
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
#ifdef __FRAMAC_EACSL__
    extern int __e_acsl_sound_verdict;
    __e_acsl_sound_verdict = 1;
#endif
    if (data == NULL) {
        return 0;
    }
    if (size > MAX_INPUT_SIZE) {
        return -1;
    }

    /*
     * Allocate an exact-sized heap buffer so E-ACSL / ASan shadow memory tracks
     * exact validity [0 .. size - 1]. For size == 0, pass a non-NULL pointer
     * one byte past a 1-byte allocation so any dereference faults immediately.
     * The copy also matters for E-ACSL's initialization checks
     * (-rte-initialized): libFuzzer writes `data` outside instrumented code,
     * so target code must only ever read fuzz_buf, never `data`.
     */
    uint8_t *alloc_ptr = (uint8_t *)malloc(size > 0 ? size : 1U);
    if (alloc_ptr == NULL) {
        return 0;
    }
    uint8_t *bounded_buf = (size > 0) ? alloc_ptr : (alloc_ptr + 1);
    if (size > 0) {
        memcpy(bounded_buf, data, size);
    }
    uint8_t *fuzz_buf = bounded_buf;
    size_t fuzz_len = size;
    (void)fuzz_buf;
    (void)fuzz_len;
    int harness_reject = 0;
#undef FRAMAC_FUZZ_REJECT
#define FRAMAC_FUZZ_REJECT() ((void)(harness_reject = 1))

    /* Invoke target module entry point */
    {{TARGET_INVOCATION_FUZZ}}

    free(alloc_ptr);
    return harness_reject ? -1 : 0;
}
