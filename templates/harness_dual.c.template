#if !defined(__FRAMAC__) && defined(FRAMAC_FUZZ_PROBE_TELEMETRY)
#  include <stdio.h>
#define FRAMAC_PROBE_MAX_CASES 4096U
#define FRAMAC_PROBE_MAX_UNIQUE 8U
typedef struct {
    unsigned long long runs;
    unsigned long long init_fail;
    int64_t unique_vals[FRAMAC_PROBE_MAX_UNIQUE];
    unsigned char unique_len;
    unsigned char unique_overflow;
    unsigned char ret_kind; /* 0=void, 1=i64, 2=ptr */
} framac_probe_slot_t;
static framac_probe_slot_t framac_probe_slots[FRAMAC_PROBE_MAX_CASES];
static int framac_probe_init_done = 0;
static const char *framac_probe_out_path = NULL;

static void framac_probe_flush(void) {
    if (framac_probe_out_path == NULL || framac_probe_out_path[0] == '\0') {
        return;
    }
    FILE *fp = fopen(framac_probe_out_path, "w");
    if (fp == NULL) {
        return;
    }
    fputs("{\"schema_version\":1,\"cases\":{", fp);
    int first_case = 1;
    for (unsigned int i = 0U; i < FRAMAC_PROBE_MAX_CASES; i++) {
        const framac_probe_slot_t *s = &framac_probe_slots[i];
        if (s->runs == 0ULL) {
            continue;
        }
        const char *rk = (s->ret_kind == 1U) ? "i64" : ((s->ret_kind == 2U) ? "ptr" : "void");
        if (!first_case) {
            fputc(',', fp);
        }
        first_case = 0;
        fprintf(
            fp,
            "\"%u\":{\"runs\":%llu,\"init_fail\":%llu,\"ret_kind\":\"%s\",\"unique_overflow\":%s,\"unique_vals\":[",
            i,
            s->runs,
            s->init_fail,
            rk,
            s->unique_overflow ? "true" : "false"
        );
        for (unsigned char j = 0U; j < s->unique_len && j < FRAMAC_PROBE_MAX_UNIQUE; j++) {
            if (j > 0U) {
                fputc(',', fp);
            }
            fprintf(fp, "%lld", (long long)s->unique_vals[j]);
        }
        fputs("]}", fp);
    }
    fputs("}}\n", fp);
    fclose(fp);
}

static inline int framac_probe_active(void) {
    if (!framac_probe_init_done) {
        framac_probe_init_done = 1;
        const char *p = getenv("FRAMAC_PROBE_OUT");
        if (p != NULL && p[0] != '\0') {
            framac_probe_out_path = p;
            atexit(framac_probe_flush);
        }
    }
    return framac_probe_out_path != NULL;
}

