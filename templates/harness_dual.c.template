        Frama_C_make_unknown((char *)input_buf, input_len);
    }
    uint8_t framac_input_init[MAX_INPUT_SIZE];
    Frama_C_make_unknown((char *)framac_input_init, MAX_INPUT_SIZE);
    (void)framac_input_init;
    uint8_t *fuzz_buf = input_buf;
    size_t fuzz_len = input_len;
    (void)fuzz_buf;
    (void)fuzz_len;

    /* Invoke target module entry point */
    {{TARGET_INVOCATION_EVA}}

    return 0;
}
#undef FRAMAC_FUZZ_COPY
