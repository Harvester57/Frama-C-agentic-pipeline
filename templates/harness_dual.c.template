    if (alloc_ptr == NULL) {
        return 0;
    }
    uint8_t *bounded_buf = (size > 0) ? alloc_ptr : (alloc_ptr + 1);
    if (size > 0) {
        memcpy(bounded_buf, data, size);
    }
    uint8_t *fuzz_buf = bounded_buf;
    size_t fuzz_len = size;
    (void)fuzz_buf;
    (void)fuzz_len;

