static inline int framac_fuzz_skip_case(unsigned int c) {
    static unsigned long long framac_fuzz_rt_skip_words[64];
    static int framac_fuzz_rt_only_case = -1;
    static int framac_fuzz_rt_skip_init = 0;
    if (!framac_fuzz_rt_skip_init) {
        const char *env = getenv("FRAMAC_FUZZ_SKIP_CASES");
        if (env != NULL) {
            const char *p = env;
            while (*p != '\0') {
                while (*p == ',' || *p == ' ' || *p == '\t') {
                    p++;
                }
                if (*p >= '0' && *p <= '9') {
                    unsigned int val = 0U;
                    int overflow = 0;
                    while (*p >= '0' && *p <= '9') {
                        unsigned int digit = (unsigned int)(*p - '0');
                        if (val > 4096U) {
                            overflow = 1;
                        } else {
                            val = val * 10U + digit;
                        }
                        p++;
                    }
                    if (!overflow && val < 4096U) {
                        framac_fuzz_rt_skip_words[val >> 6U] |= (1ULL << (val & 63U));
                    }
                }
                while (*p != '\0' && *p != ',') {
                    p++;
                }
            }
        }
        const char *only_env = getenv("FRAMAC_FUZZ_ONLY_CASE");
        if (only_env != NULL && *only_env >= '0' && *only_env <= '9') {
            char *endptr = NULL;
            long only_val = strtol(only_env, &endptr, 10);
            if (endptr != only_env && endptr != NULL && *endptr == '\0' && only_val >= 0L && only_val < 4096L) {
                framac_fuzz_rt_only_case = (int)only_val;
            }
        }
        framac_fuzz_rt_skip_init = 1;
    }
    if (framac_fuzz_rt_only_case >= 0 && c != (unsigned int)framac_fuzz_rt_only_case) {
        return 1;
    }
    if (c >= 4096U) {
        return 0;
    }
    return (int)((framac_fuzz_rt_skip_words[c >> 6U] >> (c & 63U)) & 1ULL);
}
