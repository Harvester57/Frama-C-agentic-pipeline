static inline void framac_probe_record_val(framac_probe_slot_t *s, int64_t v) {
    for (unsigned char j = 0U; j < s->unique_len; j++) {
        if (s->unique_vals[j] == v) {
            return;
        }
    }
    if (s->unique_len < FRAMAC_PROBE_MAX_UNIQUE) {
        s->unique_vals[s->unique_len++] = v;
    } else {
        s->unique_overflow = 1U;
    }
}

