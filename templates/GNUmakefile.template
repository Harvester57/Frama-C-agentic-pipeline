# Frama-C Modular Verification Makefile Template
# Supports: .parse, .eva, .wp, .eacsl, and .sarif targets per module slice

FRAMAC      ?= frama-c
EACSL_GCC   ?= $(shell command -v e-acsl-gcc 2>/dev/null || command -v e-acsl-gcc.sh 2>/dev/null || echo e-acsl-gcc)
MACHDEP     ?= gcc_x86_64
TARGET      ?= module_slice
MAIN_FN     ?= eva_main
WP_PROVERS  ?= alt-ergo,z3,cvc5
WP_PAR      ?= 8
WP_TIMEOUT  ?= 15

# Sources and Preprocessing Flags (populated by /framac-slice)
SOURCES     ?=
CPPFLAGS    ?= -I. -I/opt/framac-pipeline/templates/acsl
FC_STUBS    ?= /opt/framac-pipeline/templates/fc_stubs

# Kernel Flags
FCFLAGS     += -machdep $(MACHDEP) \
               -warn-signed-overflow \
               -warn-signed-downcast \
               -warn-left-shift-negative \
               -warn-right-shift-negative \
               -warn-pointer-downcast \
               -kernel-msg-key pp \
               -cpp-extra-args="$(CPPFLAGS) -I$(FC_STUBS) -include $(FC_STUBS)/fc_compat_types.h"

# Eva Flags
EVAFLAGS    += -eva-domains cvalue,equality,symbolic-locations,octagon,gauges \
               -eva-auto-loop-unroll 32 \
               -eva-slevel 100 \
               -eva-partition-history 2 \
               -eva-report-red-statuses "$(TARGET).eva/red_alarms.csv"

# WP Flags
WPFLAGS     += -wp \
               -wp-rte \
               -wp-model "Typed+ref+int" \
               -wp-prover $(WP_PROVERS) \
               -wp-par $(WP_PAR) \
               -wp-timeout $(WP_TIMEOUT) \
               -wp-status-all

.PHONY: all clean $(TARGET).wp $(TARGET).eacsl $(TARGET).sarif

all: $(TARGET).eva $(TARGET).sarif

$(TARGET).parse: $(SOURCES)
	@mkdir -p $@
	$(FRAMAC) $(FCFLAGS) $(SOURCES) \
		-save $@/framac.ast \
		-kernel-log i:$@/parse.log

$(TARGET).eva: $(TARGET).parse
	@mkdir -p $@
	$(FRAMAC) -load $</framac.ast \
		-main $(MAIN_FN) \
		-rte \
		-then -eva $(EVAFLAGS) \
		-then -metrics -metrics-eva-cover \
		-then -report -report-csv $@/alarms.csv \
		-save $@/framac.sav \
		-kernel-log i:$@/eva.log

$(TARGET).wp: $(TARGET).parse
	@mkdir -p $@
	$(FRAMAC) -load $</framac.ast \
		$(WPFLAGS) \
		-wp-out $@/wp_out \
		-wp-report-json $@/wp_report.json \
		-then -report -report-csv $@/wp_alarms.csv \
		-save $@/framac_wp.sav

$(TARGET).eacsl: $(SOURCES)
	@mkdir -p $@
	@if echo "$(EACSL_GCC)" | grep -q '\.sh$$'; then \
		$(EACSL_GCC) \
			--compiler=clang \
			--machdep=$(MACHDEP) \
			--rte=all \
			--cflag="-fsanitize=fuzzer -g -O1 -D__FRAMAC_EACSL__ -D_Float128=double $(CPPFLAGS)" \
			--ldflag="-fsanitize=fuzzer" \
			-o $@/fuzz_runner \
			-O $@/instrumented.c \
			$(SOURCES); \
	else \
		$(EACSL_GCC) \
			-G clang \
			-F "-rte -machdep $(MACHDEP)" \
			-E "-D__FRAMAC_EACSL__ -D_Float128=double $(CPPFLAGS)" \
			-e "-fsanitize=fuzzer -g -O1 -fcommon -D__FRAMAC_EACSL__ -D_Float128=double $(CPPFLAGS)" \
			-l "-fsanitize=fuzzer" \
			-o $@/instrumented.c \
			-O $@/fuzz_runner \
			$(SOURCES); \
	fi

$(TARGET).sarif: $(TARGET).eva
	$(FRAMAC) -load $</framac.sav \
		-mdr-gen sarif \
		-mdr-no-print-libc \
		-mdr-out $(TARGET).sarif

clean:
	rm -rf $(TARGET).parse $(TARGET).eva $(TARGET).wp $(TARGET).eacsl $(TARGET).sarif
