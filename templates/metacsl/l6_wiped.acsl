/*
 * L6, secrets: wiped before release. A postcondition of the release function (the secret's
 * `function` in the threat model): every element of the secret is zero when it returns, on every
 * path. A wipe the compiler may remove (memset of a dead buffer) still proves here: pair it with
 * explicit_bzero or a volatile write in the code.
 *   array   `count` elements: the threat model's `size`, else sizeof(x) / sizeof(x[0])
 *   scalar  a global scalar
 *   local   a secret held in a local array (plan step M6): a postcondition cannot name a local,
 *           so security_props.py writes this `check` into the work tree before each `return` in
 *           the local's scope and before the closing brace of its block. WP proves it with the
 *           function; E-ACSL executes it without stopping the run (a `check` does not abort).
 *   local_array  its predicate: `count` is the threat model's `size`, else sizeof(x) / sizeof(x[0])
 */
//# property
/*@ meta \prop, \name(${name}), \targets({${function}}), \context(\postcond),
      ${predicate};
*/
//# array
\fguard(\forall integer i; 0 <= i < ${count} ==> ${lv}[i] == 0)
//# scalar
\fguard(${lv} == 0)
//# local
/*@ check ${name}: ${predicate}; */
//# local_array
\forall integer i; 0 <= i < ${count} ==> ${lv}[i] == 0
