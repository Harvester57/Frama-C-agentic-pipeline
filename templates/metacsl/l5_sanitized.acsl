/*
 * L5, output sinks: what leaves the target through a sink is sanitized.
 *   emit    network, file, log, terminal, ipc and other sinks: checked at every call of the sink
 *           (context \calling, so it holds for a sink the target only declares), which puts the
 *           obligation on the writers, the sink's callers:
 *             text   (log, terminal) no CR or LF before the terminating NUL (the vocabulary's
 *                    `no_crlf_string`): no log or terminal injection (CWE-117, CWE-93);
 *             bytes  (a `length` parameter) every byte handed over is initialized: no disclosure of
 *                    uninitialized memory (CWE-457, CWE-200);
 *             object (no length) the object the parameter points to is initialized.
 *   entry   the same obligation for a sink the target defines and calls through a function pointer,
 *           as a precondition of the sink (context \precond), which WP proves at every call, the
 *           calls through a pointer included (they need a `calls` annotation naming the sink). At
 *           such a call MetAcsl cannot name the arguments: \called_arg has no callee to read the
 *           formals from, so an `emit` instance there is `!(pointer == &sink)`, which never proves.
 *           Clauses: text_formal, bytes_formal, object_formal.
 *   buffer  a sink that returns its output in a buffer: the out-parameters are initialized when it
 *           returns (a postcondition of the sink, which the target must define).
 *   handoff a wrapper sink (threat model `checked_at`): it completes the buffer itself, then hands it
 *           to other declared sinks. Not MetAcsl: a named `check` written into the wrapper before
 *           each call that hands the buffer on, on that call's arguments (`handoff_bytes` with a
 *           length, `handoff_object` without). MetAcsl cannot state it there: at a call through a
 *           function pointer \called_arg is refused, and \fguard turns the instance into \false.
 * The clauses use \fguard: a parameter of the wrong type makes the property \false (unproven), never
 * silently \true.
 * A bytes sink that only forwards its buffer to other declared sinks gets no MetAcsl text at all
 * (scripts/security_props.py, `forwarded_to`): its bytes are checked at those sinks.
 */
//# emit
/*@ meta \prop, \name(${name}), \targets(\ALL), \context(\calling),
      \tguard(\called == ${sink} ==> (${predicate}));
*/
//# entry
/*@ meta \prop, \name(${name}), \targets({${sink}}), \context(\precond),
      ${predicate};
*/
//# buffer
/*@ meta \prop, \name(${name}), \targets({${sink}}), \context(\postcond),
      ${predicate};
*/
//# text
\fguard(no_crlf_string(\called_arg(${param})))
//# bytes
\fguard(\initialized(\called_arg(${param}) + (0 .. \called_arg(${length}) - 1)))
//# object
\fguard(\initialized(\called_arg(${param})))
//# text_formal
\fguard(no_crlf_string(\formal(${param})))
//# bytes_formal
\fguard(\initialized(\formal(${param}) + (0 .. \formal(${length}) - 1)))
//# object_formal
\fguard(\initialized(\formal(${param})))
//# out_object
\fguard(\initialized(\formal(${param})))
//# handoff
/*@ check ${name}: ${predicate}; */
//# handoff_bytes
\initialized((${arg}) + (0 .. (${length}) - 1))
//# handoff_object
\initialized(${arg})
