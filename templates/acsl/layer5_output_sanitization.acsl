/*
 * Layer 5 Security Property Template: Output Grammar & Sanitization Invariants
 *
 * Purpose:
 * Prove that packet emitters and log formatters (e.g., RFC 5424 Syslog emitter,
 * HTTP header serializer, XML/JSON attribute escaper) never emit unescaped
 * control characters (CR/LF log injection, NUL truncation, delimiter breakout)
 * and strictly respect output buffer bounds.
 *
 * Pure-ACSL Rule:
 * Every predicate in this template is inside an ACSL annotation block so it
 * can be placed directly in target headers/sources without altering the C token stream.
 *
 * Works with:
 * - Frama-C WP (universal quantifier proofs over output buffer ranges)
 * - Frama-C E-ACSL + LibFuzzer (turns grammar/injection bugs into instant crashes)
 */

/*@
  predicate is_printable_ascii(char c) =
    (0x20 <= c <= 0x7E);

  predicate no_crlf_or_nul(char *buf, integer len) =
    \forall integer k; 0 <= k < len ==>
      (buf[k] != '\r' && buf[k] != '\n' && buf[k] != '\0');

  predicate syslog_sd_value_escaped(char *buf, integer len) =
    \forall integer k; 0 <= k < len ==>
      (is_printable_ascii(buf[k]) &&
       ((buf[k] == ']' || buf[k] == '"' || buf[k] == '\\') ==>
         (k > 0 && buf[k - 1] == '\\')));
*/

/*
 * Template Contract for Sanitized Field Appender / Formatter:
 *
 *   requires out_cap > 0;
 *   requires \valid(out_buf + (0 .. out_cap - 1));
 *   requires \valid_read(untrusted_in + (0 .. in_len - 1));
 *   requires \separated(out_buf + (0 .. out_cap - 1), untrusted_in + (0 .. in_len - 1));
 *   assigns out_buf[0 .. out_cap - 1];
 *   ensures 0 <= \result < out_cap;
 *   ensures \initialized(out_buf + (0 .. \result));
 *   ensures out_buf[\result] == '\0';
 *   ensures L5_no_crlf: no_crlf_or_nul(out_buf, \result);
 */
