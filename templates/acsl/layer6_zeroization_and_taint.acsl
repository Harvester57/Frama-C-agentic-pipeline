/*
 * Layer 6 Security Property Template: Secret Zeroization & Information Flow (Taint)
 *
 * Purpose:
 * 1. Prove that cryptographic keys, passwords, and sensitive session state are
 *    unconditionally zeroized before function exit (even on error paths).
 * 2. Use Frama-C Eva Taint domain (-eva-domains taint) and InOut/Deps analysis
 *    (-inout -deps) to verify that secret configuration fields never flow into
 *    untrusted output buffers (e.g., XML password leaking into Syslog packet).
 *
 * Pure-ACSL Rule:
 * Every predicate in this template is inside an ACSL annotation block so it
 * can be placed directly in target headers/sources without altering the C token stream.
 */

/*@
  predicate buffer_is_zeroed(uint8_t *buf, integer len) =
    \forall integer k; 0 <= k < len ==> buf[k] == 0;
*/

/*
 * 1. Secret Zeroization Contract Template
 * Attach this named postcondition to any function managing transient key material
 * or scrubbing a context struct on teardown:
 *
 *   requires \valid(secret_buf + (0 .. secret_len - 1));
 *   assigns secret_buf[0 .. secret_len - 1];
 *   ensures L6_secret_zeroed: buffer_is_zeroed(secret_buf, secret_len);
 */

/*
 * 2. Eva Taint Source / Sink Annotations (Non-Interference)
 * When running Frama-C with `-eva -eva-domains taint`:
 *
 * Mark secret buffers after parsing (e.g., XML config password field):
 *   //@ taint secret_cfg->snmp_priv_key[0 .. KEY_LEN - 1];
 *
 * Assert at network emission sink (e.g., syslog_send_packet) that no byte
 * of the outgoing packet is tainted by the secret source:
 *   //@ assert L6_no_secret_leak: !\tainted(syslog_out_buf[0 .. pkt_len - 1]);
 *
 * Alternative idiom (upstream plugins/eva/tests/secure_flow, vendored as
 * docs/upstream/sources/annot11.c + security_macro.h): mark the secret itself
 * private and assert the public status at the sink, under `-eva-secure-flow`
 * with `-cpp-extra-args="-include security_macro.h"` defining
 *   #define __fc_private __attribute__((private))
 *   #define __fc_public  __attribute__((public))
 *
 *   int __fc_private global_key[5];
 *   //@ assert L6_no_secret_leak: security_status(syslog_out_buf) == public;
 *
 * (security_status is registered by Eva's taint domain only, so keep these
 * annotations in comments here like the rest of this section: a live predicate
 * using it would not parse under WP.)
 */
