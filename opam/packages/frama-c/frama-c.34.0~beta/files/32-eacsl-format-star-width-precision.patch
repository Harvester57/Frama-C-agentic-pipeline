+/** \brief Read the variadic arguments described by `fmtdesc` from `ap`, each
+   with its own type, and store the value of each argument promoted to `int`
+   in `ints` (0 for the other arguments). A field width or a precision given
+   as '*' is such an argument. */
+static void fetch_int_arguments(const char *fmtdesc, va_list ap, int *ints) {
+  for (int i = 0; fmtdesc[i] != '\0'; i++) {
+    ints[i] = 0;
+    switch (fmtdesc[i]) {
+    case FFloat: /* promoted to double */
+    case FDouble:
+      (void)va_arg(ap, double);
+      break;
+    case FLongDouble:
+      (void)va_arg(ap, long double);
+      break;
+    case ILong:
+    case IULong:
+      (void)va_arg(ap, long);
+      break;
+    case ILongLong:
+    case IULongLong:
+      (void)va_arg(ap, long long);
+      break;
+    case PChar:
+    case PUChar:
+    case PShort:
+    case PUShort:
+    case PInt:
+    case PUInt:
+    case PLong:
+    case PULong:
+    case PLongLong:
+    case PULongLong:
+    case PVoid:
+      (void)va_arg(ap, void *);
+      break;
+    default: /* int, unsigned int and the types promoted to int */
+      ints[i] = va_arg(ap, int);
+    }
+  }
+}
+
+/** \brief A field width or a precision given as '*' takes an `int` argument
+   before the argument of the directive itself. Check the type of these
+   arguments, take the value of a '*' precision into account, and count them
+   in `*stars`, the number of such arguments taken by the directives before
+   (and now including) `dir`. The argument of a directive that is not
+   numbered is then the one at index `dir->arg.index + *stars`.
+
+   `ordinal` is the index of `dir` among the directives of the format. */
+static void fetch_star_arguments(format_directive *dir, int ordinal, int *stars,
+                                 const char *fmtdesc, const int *ints,
+                                 int arglen, const char *func) {
+  if (dir->arg.expl) {
+    /* Numbered '*' arguments ('*m$') are not supported */
+    if (dir->field_width == -1 || dir->precision == -1)
+      private_abort(FMT_ERROR "\"%s\": numbered and non-numbered arguments "
+                              "cannot be mixed\n",
+                    dir->format);
+    return;
+  }
+  /* A directive starting with the flag '0' is not given an index when it is
+     parsed (see ::fetch_format_argno) */
+  dir->arg.index = ordinal;
+  int is_star[2] = {dir->field_width == -1, dir->precision == -1};
+  for (int k = 0; k < 2; k++) {
+    if (is_star[k]) {
+      if (ordinal + *stars >= arglen)
+        private_abort("%s: directive %d (%s) in format \"%s\" has no argument "
+                      "for '*'\n",
+                      func, ordinal + 1, dir->directive, dir->format);
+      validate_format_type(IInt, fmtdesc + *stars, dir, func);
+      if (k == 1) {
+        /* A negative precision is taken as if it were omitted */
+        int precision = ints[ordinal + *stars];
+        dir->precision = precision >= 0 ? precision : INT_MIN;
+      }
+      (*stars)++;
+    }
+  }
+}
