 (* type the term [t] in a context [ctx] by taking --e-acsl-O-gmp-only into account
    iff [use_gmp_opt] is true. *)
+(* Run [f] and [g] so that an E-ACSL typing/unsupported error in [f] still
+   allows [g] to run, re-raising the first exception. *)
+let do_both f g =
+  match f () with
+  | () -> g ()
+  | exception ((Error.Not_yet _ | Error.Typing_error _) as exn) ->
+    (try g () with Error.Not_yet _ | Error.Typing_error _ -> ());
+    raise exn
+
+let do_all f xs =
+  let exn_o = ref None in
+  List.iter
+    (fun x ->
+       try f x
+       with (Error.Not_yet _ | Error.Typing_error _) as exn ->
+         if Option.is_none !exn_o then exn_o := Some exn)
+    xs;
+  Option.iter raise !exn_o
+
+(* Compute a typing context [mk_ctx ()], catching E-ACSL typing/unsupported
+   errors so that [type_children] still types every subterm before the error is
+   re-raised. *)
+let with_opt_ctx mk_ctx type_children =
+  match mk_ctx () with
+  | ctx ->
+    type_children (Some ctx);
+    ctx
+  | exception ((Error.Not_yet _ | Error.Typing_error _) as exn) ->
+    (try type_children None with Error.Not_yet _ | Error.Typing_error _ -> ());
+    raise exn
