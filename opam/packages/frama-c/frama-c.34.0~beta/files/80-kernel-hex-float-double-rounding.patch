+let normalize_hexadecimal integral fractional exponent format =
+  let concat = Z.of_string_base 16 (integral ^ fractional) in
+  let* numerator = normalize_zero_in_numerator ~format concat in
+  let fractional_bits = Z.of_int Stdlib.(4 * String.length fractional) in
+  let raw_exp = Z.sub (Z.of_string exponent) fractional_bits in
+  let sig_size = sig_size format in
+  let maximal_exponent = maximal_exponent_of ~format in
+  let minimal_exponent = Stdlib.(minimal_exponent_of ~format - sig_size + 1) in
+  let msb_exp = Z.add raw_exp (Z.of_int (Z.log2 numerator)) in
+  let* () =
+    if Z.Compare.(msb_exp > Z.of_int maximal_exponent)
+    then pos_inf_shortcut ~format
+    else Normalized ()
+  in
+  let* () =
+    if Z.Compare.(msb_exp < Z.of_int Stdlib.(minimal_exponent - 1))
+    then zero_shortcut ~format
+    else Normalized ()
+  in
+  let msb_exp_int = Z.to_int msb_exp in
+  let target_exp = Stdlib.max minimal_exponent Stdlib.(msb_exp_int - sig_size + 1) in
+  let shift = Z.to_int (Z.sub (Z.of_int target_exp) raw_exp) in
+  if Stdlib.(shift <= 0) then
+    let significant = Z.shift_left numerator Stdlib.(-shift) in
+    let exact = Float.ldexp (Z.to_float significant) target_exp in
+    let bound = represents ~float:exact ~in_format:format in
+    Normalized { lower = bound ; nearest = bound ; upper = bound ; format }
+  else
+    let significant = Z.shift_right numerator shift in
+    let tz = Z.trailing_zeros numerator in
+    let is_zero = Stdlib.(tz >= shift) in
+    let half_bit = Z.testbit numerator Stdlib.(shift - 1) in
+    let is_half = half_bit && Stdlib.(tz = shift - 1) in
+    let less_than_half = not half_bit in
+    let is_last_bit_zero = Z.(equal (logand significant one) zero) in
+    let tie_to_even = is_half && is_last_bit_zero in
+    let nearest_is_down = is_zero || less_than_half || tie_to_even in
+    let lower_bound = Float.ldexp (Z.to_float significant) target_exp in
+    let upper_bound = Float.ldexp Z.(succ significant |> to_float) target_exp in
+    let lower = represents ~float:lower_bound ~in_format:format in
+    let upper =
+      if is_zero then lower else represents ~float:upper_bound ~in_format:format
+    in
+    let nearest = if nearest_is_down then lower else upper in
+    Normalized { lower ; nearest ; upper ; format }
 
 
 
