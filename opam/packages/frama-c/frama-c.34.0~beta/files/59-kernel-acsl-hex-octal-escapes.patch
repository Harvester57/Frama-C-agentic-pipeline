# Upstream ref: unfiled-59
# Summary: kernel: fix ACSL hex/octal escapes and wide-character truncation (soundness)

diff --git a/src/kernel/internals/parsing/logic_lexer.mli b/src/kernel/internals/parsing/logic_lexer.mli
index b07acd1896..f3936fa9fd 100644
--- a/src/kernel/internals/parsing/logic_lexer.mli
+++ b/src/kernel/internals/parsing/logic_lexer.mli
@@ -15,6 +15,7 @@ val token : Lexing.lexbuf -> Logic_parser.token
 (** For plugins that need to call functions of [Logic_parser] themselves *)
 
 val chr : Lexing.lexbuf -> string
+val chr_codes : Lexing.lexbuf -> int64 list
 val is_acsl_keyword : string -> bool
 
 
diff --git a/src/kernel/internals/parsing/logic_lexer.mll b/src/kernel/internals/parsing/logic_lexer.mll
index 8b198bcbbc..e47a665fc8 100644
--- a/src/kernel/internals/parsing/logic_lexer.mll
+++ b/src/kernel/internals/parsing/logic_lexer.mll
@@ -437,12 +437,9 @@ rule token = parse
   | '0' rD+ rIS?            { INT_CONSTANT (lexeme lexbuf) }
   | rD+                     { INT_CONSTANT (lexeme lexbuf) }
   | rD+ rIS                 { INT_CONSTANT (lexeme lexbuf) }
-  | ('L'? "'" as prelude) (([^ '\\' '\'' '\n']|("\\"[^ '\n']))+ as content) "'"
+  | 'L'? "'" ([^ '\\' '\'' '\n']|("\\"[^ '\n']))+ "'"
       {
-        let b = Buffer.create 5 in
-        Buffer.add_string b prelude;
-        let lbf = Lexing.from_string content in
-        INT_CONSTANT (chr b lbf ^ "'")
+        INT_CONSTANT (lexeme lexbuf)
       }
 (* floating-point literals, both decimal and hexadecimal *)
   | rD+ rE rFS?
@@ -526,28 +523,19 @@ and chr buffer = parse
   | hex_escape
       { let s = lexeme lexbuf in
         let real_s = String.sub s 2 (String.length s - 2) in
-        let rec add_one_char s =
-          let l = String.length s in
-          if l = 0 then ()
-          else
-          let h = int_of_digit s.[0] in
-          let c,s =
-            if l = 1 then (h,"")
-            else
-              (16*h + int_of_digit s.[1],
-               String.sub s 2 (String.length s - 2))
-          in
-          Buffer.add_char buffer (Char.chr c); add_one_char s
-        in add_one_char real_s; chr buffer lexbuf
+        let v = Z.of_string_base 16 real_s in
+        if Z.gt v (Z.of_int 255) then
+          lex_error lexbuf
+            (Format.asprintf "hexadecimal escape sequence out of range: %s" s);
+        Buffer.add_char buffer (Char.chr (Z.to_int v)); chr buffer lexbuf
       }
   | oct_escape
       { let s = lexeme lexbuf in
         let real_s = String.sub s 1 (String.length s - 1) in
-        let rec value i s =
-          if s = "" then i
-          else value (8*i+int_of_digit s.[0])
-            (String.sub s 1 (String.length s -1))
-        in let c = value 0 real_s in
+        let c = int_of_string ("0o" ^ real_s) in
+        if c > 255 then
+          lex_error lexbuf
+            (Format.asprintf "octal escape sequence out of range: %s" s);
         Buffer.add_char buffer (Char.chr c); chr buffer lexbuf
       }
   | escape
@@ -617,6 +605,45 @@ and comment = parse
   | eof  { lex_error lexbuf "non-terminating block-comment" }
   | _    { comment lexbuf}
 
+and chr_codes = parse
+  | hex_escape
+      { let s = lexeme lexbuf in
+        let real_s = String.sub s 2 (String.length s - 2) in
+        let v = Z.of_string_base 16 real_s in
+        if Z.gt v (Z.of_int64 Int64.max_int) then
+          lex_error lexbuf
+            (Format.asprintf "hexadecimal escape sequence out of range: %s" s);
+        let code = Z.to_int64 v in
+        code :: chr_codes lexbuf
+      }
+  | oct_escape
+      { let s = lexeme lexbuf in
+        let real_s = String.sub s 1 (String.length s - 1) in
+        let code = Int64.of_int (int_of_string ("0o" ^ real_s)) in
+        code :: chr_codes lexbuf
+      }
+  | escape
+      { let c =
+          match (lexeme lexbuf).[1] with
+          | 'a' -> '\007'
+          | 'b' -> '\b'
+          | 'f' -> '\012'
+          | 'n' -> '\n'
+          | 'r' -> '\r'
+          | 't' -> '\t'
+          | 'v' -> '\011'
+          | '\'' -> '\''
+          | '"' -> '"'
+          | '?' -> '?'
+          | '\\' -> '\\'
+          | _ -> assert false
+        in
+        let code = Int64.of_int (Char.code c) in
+        code :: chr_codes lexbuf
+      }
+  | eof { [] }
+  | _ as c { let code = Int64.of_int (Char.code c) in code :: chr_codes lexbuf }
+
 {
