# Source-only opam patch extracted from docs/upstream/frama-c/patches/17-eacsl-memcmp-overlapping-buffers.patch
# Upstream ref: pub/frama-c#2803, pub/frama-c!34
# Summary: e-acsl: allow overlapping buffers in memcmp replacement

diff --git a/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_string.c b/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_string.c
index 18de67a564..c9369eb556 100644
--- a/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_string.c
+++ b/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_string.c
@@ -237,7 +237,6 @@ void *eacsl_builtin_memset(void *s, int c, size_t n) {
 int eacsl_builtin_memcmp(const void *s1, const void *s2, size_t n) {
   validate_allocated_space((void *)s1, n, "memcmp", "space 1 ");
   validate_allocated_space((void *)s2, n, "memcmp", "space 2 ");
-  validate_overlapping_spaces((uintptr_t)s1, n, (uintptr_t)s2, n, "memcpy");
   return memcmp(s1, s2, n);
 }
 
