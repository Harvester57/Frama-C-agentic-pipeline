From 084129889f7b4d6abbc11433d4cd3c5176e8177a Mon Sep 17 00:00:00 2001
From: Florian Stosse <florian.stosse@gmail.com>
Date: Sun, 15 Nov 2026 11:58:49 +0100
Subject: [PATCH] Don't set uNextNestLevel when consuming an array or map stops
 early

QCBORDecode_Private_ConsumeItem() walks the members of a non-empty
array or map with a local QCBORItem. When the input ends before the
first member, QCBORDecode_Private_GetNextMapOrArray() returns
QCBOR_ERR_NO_MORE_ITEMS without writing the item, and the loop's
break was followed by

   *puNextNestLevel = Item.uNextNestLevel;

which copies an uninitialized byte. The function's documentation says
the output is not set when traversal stops early.

QCBORDecode_VGetNextConsume() passes &pDecodedItem->uNextNestLevel,
so the 1 that QCBORDecode_VGetNext() had just stored for input 0x81
is replaced with stack contents. MemorySanitizer reports it at the
caller's first use. The other callers check the error first.

The NO_MORE_ITEMS case was commented "Should never occur", but a
truncated array or map such as 0x81 reaches it.

Return directly on both early stops, so the output is left as it was.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/qcbor_main_decode.c   | 11 ++++++-----
 test/qcbor_decode_tests.c | 16 ++++++++++++++++
 2 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/src/qcbor_main_decode.c b/src/qcbor_main_decode.c
index 26ccf08..bb5a4c1 100644
--- a/src/qcbor_main_decode.c
+++ b/src/qcbor_main_decode.c
@@ -2100,14 +2100,15 @@ QCBORDecode_Private_ConsumeItem(QCBORDecodeContext    *pMe,
    do {
       uReturn = QCBORDecode_Private_GetNextMapOrArray(pMe, pEnd, &Item, NULL);
 
+      /* On these two, Item may not have been written, so
+       * *puNextNestLevel is left unset as documented. */
       if(QCBORDecode_IsHaltingError(uReturn)) {
-         break;
+         return uReturn;
       }
       if(uReturn == QCBOR_ERR_NO_MORE_ITEMS) {
-         /* Should never occur. Errors are caught by check above;
-          * normal exit is by nest level check. Retained to to prevent
-          * infinite loop if understanding of this is wrong. */
-         break;
+         /* Occurs when the input ends before the array or map does,
+          * for example 0x81 with nothing after it. */
+         return uReturn;
       }
 
       /* Nest level end detection works for definite and indefinite lengths */
diff --git a/test/qcbor_decode_tests.c b/test/qcbor_decode_tests.c
index 17beea5..796ef7e 100644
--- a/test/qcbor_decode_tests.c
+++ b/test/qcbor_decode_tests.c
@@ -8624,6 +8624,11 @@ const unsigned char spBadConsumeInput5[] = {
    0xa1, 0x80, 0x00
 };
 
+/* An array of one item with no bytes for the item */
+const unsigned char spBadConsumeInput6[] = {
+   0x81
+};
+
 const unsigned char spOneInteger[] = {
    0x01
 };
@@ -9430,6 +9435,17 @@ int32_t EnterMapTest(void)
       return 3000;
    }
 
+   /* When consuming stops early, uNextNestLevel keeps the value
+    * QCBORDecode_VGetNext() returned for the array */
+   QCBORDecode_Init(&DCtx, UsefulBuf_FROM_BYTE_ARRAY_LITERAL(spBadConsumeInput6), 0);
+   QCBORDecode_VGetNextConsume(&DCtx, &Item1);
+   if(QCBORDecode_GetError(&DCtx) != QCBOR_ERR_NO_MORE_ITEMS) {
+      return 3001;
+   }
+   if(Item1.uDataType != QCBOR_TYPE_ARRAY || Item1.uNextNestLevel != 1) {
+      return 3002;
+   }
+
    /* GetItemsInMap search for nothing on an item that isn't a map */
    memset(SearchItems, 0, sizeof SearchItems);
    SearchItems[0].uLabelType = QCBOR_TYPE_NONE;
-- 
