From 085dedd5cf3132aff367f0f5eb7992a1cf86f447 Mon Sep 17 00:00:00 2001
From: Florian Stosse <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 15 Nov 2026 19:02:26 +0100
Subject: [PATCH 1/2] [e-acsl] no initialization guard on the fields of \result

With initialization checks on (-e-acsl-rte-initialized, or -rte
-rte-initialized), a postcondition that reads a field of a struct
\result, such as ensures \result.a == x, failed on every call with a
false "\initialized(&\result.a)". The wrapper stores the result in
__retres, which is registered in shadow memory but never marked
initialized.

needs_guard already skips the guard for \result, since the kernel
ensures that __retres is always initialized, but only without offset.
Extend the exemption to its fields. This matches what E-ACSL does for
any other struct copy (the caller's `struct S s = f();` is marked fully
initialized), and \result cannot appear in a user-written
\initialized(&\result...), so the guard was the only shadow-memory read
of __retres.

Add acsl-rte/struct_result.c as a regression test.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/e-acsl/src/analyses/rte_analysis.ml   |  5 +-
 .../acsl-rte/oracle/gen_struct_result.0.c     | 91 +++++++++++++++++++
 .../oracle/struct_result.0.res.oracle         |  2 +
 plugins/e-acsl/tests/acsl-rte/struct_result.c | 22 +++++
 4 files changed, 118 insertions(+), 2 deletions(-)
 create mode 100644 plugins/e-acsl/tests/acsl-rte/oracle/gen_struct_result.0.c
 create mode 100644 plugins/e-acsl/tests/acsl-rte/oracle/struct_result.0.res.oracle
 create mode 100644 plugins/e-acsl/tests/acsl-rte/struct_result.c

diff --git a/plugins/e-acsl/src/analyses/rte_analysis.ml b/plugins/e-acsl/src/analyses/rte_analysis.ml
index a9ec43c3a5..ffcd3b9d94 100644
--- a/plugins/e-acsl/src/analyses/rte_analysis.ml
+++ b/plugins/e-acsl/src/analyses/rte_analysis.ml
@@ -496,8 +496,9 @@ let rte_visitor =
         | TVar { lv_origin = Some vi }, TNoOffset ->
           not (vi.vglob || vi.vformal || vi.vtemp) &&
           not (Ast_types.C.is_struct_or_union typ)
-        (* Frama-C kernel ensures that '__retres' is always initialized. *)
-        | TResult _, TNoOffset -> false
+        (* Frama-C kernel ensures that '__retres' is always initialized,
+           and so are its fields. *)
+        | TResult _, _ -> false
         | _ -> not Ast_types.C.(is_fun typ || is_struct_or_union typ)
       in
       if Flags.needs_initialized self#current_kf && needs_guard lv then
