new file mode 100644
index 0000000000..64d5395b39
--- /dev/null
+++ b/plugins/e-acsl/tests/acsl-rte/oracle/gen_struct_result.0.c
@@ -0,0 +1,91 @@
+/* Generated by Frama-C */
+#include "pthread.h"
+#include "stddef.h"
+#include "stdint.h"
+#include "stdio.h"
+#include "time.h"
+extern  __attribute__((__FC_BUILTIN__)) int __e_acsl_sound_verdict;
+
+struct S {
+   int a ;
+   int b ;
+};
+/*@ requires 0 <= x < 100;
+    ensures \result.a == \old(x) && \result.b == \old(x) + 1;
+ */
+struct S __gen_e_acsl_make_s(int x);
+
+struct S make_s(int x)
+{
+  struct S s = {.a = x, .b = x + 1};
+  return s;
+}
+
+int main(void)
+{
+  int __retres;
+  __e_acsl_memory_init((int *)0,(char ***)0,8UL);
+  struct S s = __gen_e_acsl_make_s(0);
+  __retres = s.a;
+  __e_acsl_memory_clean();
+  return __retres;
+}
+
+/*@ requires 0 <= x < 100;
+    ensures \result.a == \old(x) && \result.b == \old(x) + 1;
+ */
+struct S __gen_e_acsl_make_s(int x)
+{
+  int __gen_e_acsl_at_2;
+  long __gen_e_acsl_at;
+  struct S __retres;
+  {
+    int __gen_e_acsl_and;
+    __gen_e_acsl_at = (long)x;
+    __gen_e_acsl_at_2 = x;
+    __e_acsl_assert_data_t __gen_e_acsl_assert_data = {.values = (void *)0};
+    __e_acsl_assert_register_int(& __gen_e_acsl_assert_data,"x",0,x);
+    if (0 <= x) {
+      __e_acsl_assert_register_int(& __gen_e_acsl_assert_data,"x",0,x);
+      __gen_e_acsl_and = x < 100;
+    }
+    else __gen_e_acsl_and = 0;
+    __gen_e_acsl_assert_data.blocking = 1;
+    __gen_e_acsl_assert_data.kind = "Precondition";
+    __gen_e_acsl_assert_data.pred_txt = "0 <= x < 100";
+    __gen_e_acsl_assert_data.file = "struct_result.c";
+    __gen_e_acsl_assert_data.fct = "make_s";
+    __gen_e_acsl_assert_data.line = 12;
+    __e_acsl_assert(__gen_e_acsl_and,& __gen_e_acsl_assert_data);
+    __e_acsl_assert_clean(& __gen_e_acsl_assert_data);
+  }
+  __retres = make_s(x);
+  {
+    int __gen_e_acsl_and_2;
+    __e_acsl_assert_data_t __gen_e_acsl_assert_data_2 =
+      {.values = (void *)0};
+    __e_acsl_assert_register_int(& __gen_e_acsl_assert_data_2,"\\result.a",0,
+                                 __retres.a);
+    __e_acsl_assert_register_int(& __gen_e_acsl_assert_data_2,"\\old(x)",0,
+                                 __gen_e_acsl_at_2);
+    if (__retres.a == __gen_e_acsl_at_2) {
+      __e_acsl_assert_register_int(& __gen_e_acsl_assert_data_2,"\\result.b",
+                                   0,__retres.b);
+      __e_acsl_assert_register_long(& __gen_e_acsl_assert_data_2,"\\old(x)",
+                                    0,__gen_e_acsl_at);
+      __gen_e_acsl_and_2 = (long)__retres.b == __gen_e_acsl_at + 1L;
+    }
+    else __gen_e_acsl_and_2 = 0;
+    __gen_e_acsl_assert_data_2.blocking = 1;
+    __gen_e_acsl_assert_data_2.kind = "Postcondition";
+    __gen_e_acsl_assert_data_2.pred_txt = "\\result.a == \\old(x) && \\result.b == \\old(x) + 1";
+    __gen_e_acsl_assert_data_2.file = "struct_result.c";
+    __gen_e_acsl_assert_data_2.fct = "make_s";
+    __gen_e_acsl_assert_data_2.line = 13;
+    __e_acsl_assert(__gen_e_acsl_and_2,& __gen_e_acsl_assert_data_2);
+    __e_acsl_assert_clean(& __gen_e_acsl_assert_data_2);
