diff --git a/plugins/e-acsl/tests/acsl-rte/struct_result.c b/plugins/e-acsl/tests/acsl-rte/struct_result.c
new file mode 100644
index 0000000000..ab26c2c608
--- /dev/null
+++ b/plugins/e-acsl/tests/acsl-rte/struct_result.c
@@ -0,0 +1,22 @@
+/* run.config
+   COMMENT: no initialization guard on the fields of a struct \result: the
+   COMMENT: kernel ensures that '__retres' is initialized
+   STDOPT: #"-e-acsl-rte-initialized"
+*/
+/* run.config_dev
+   MACRO: ROOT_EACSL_GCC_FC_EXTRA_EXT -e-acsl-rte-initialized
+*/
+
+struct S { int a; int b; };
+
+/*@ requires 0 <= x < 100;
+    ensures \result.a == x && \result.b == x + 1; */
+struct S make_s(int x) {
+  struct S s = { x, x + 1 };
+  return s;
+}
+
+int main(void) {
+  struct S s = make_s(0);
+  return s.a;
+}
