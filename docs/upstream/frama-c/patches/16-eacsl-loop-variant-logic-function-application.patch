 create mode 100644 plugins/e-acsl/tests/constructs/oracle/logic_app_reading_memory.0.res.oracle

diff --git a/plugins/e-acsl/src/analyses/typing.ml b/plugins/e-acsl/src/analyses/typing.ml
index 6263c8243b..e9406ee599 100644
--- a/plugins/e-acsl/src/analyses/typing.ml
+++ b/plugins/e-acsl/src/analyses/typing.ml
@@ -908,9 +908,15 @@ let unsafe_set t ?ctx ~logic_env ty =
 (** {2 Getters} *)
 (******************************************************************************)
 
-let get_number_ty ~logic_env t =
+(* [type_term] memoizes the information of the normalized form of a term (see
+   {!Logic_normalizer.get_term}), so look it up under the same key, as
+   {!Interval.get_from_profile} does. *)
+let get_info ~logic_env t =
+  let t = Logic_normalizer.get_term t in
   let profile = Logic_env.get_profile logic_env in
-  (Error.retrieve_preprocessing "typing" (Memo.get ~profile) t Printer.pp_term).ty
+  Error.retrieve_preprocessing "typing" (Memo.get ~profile) t Printer.pp_term
+
+let get_number_ty ~logic_env t = (get_info ~logic_env t).ty
 
 (* {!typ_of_integer}, but handle the not-integer cases. *)
 let extract_typ t ty =
@@ -928,18 +934,12 @@ let get_typ ~logic_env t =
   extract_typ t (get_number_ty ~logic_env t)
 
 let get_cast ~logic_env t =
-  let profile = Logic_env.get_profile logic_env in
-  let info =
-    Error.retrieve_preprocessing "typing" (Memo.get ~profile) t Printer.pp_term
-  in
+  let info = get_info ~logic_env t in
   try Option.map typ_of_number_ty info.cast
   with Not_a_number -> None
 
 let get_effective_ty ~logic_env t =
-  let profile = Logic_env.get_profile logic_env in
-  let info =
-    Error.retrieve_preprocessing "typing" (Memo.get ~profile) t Printer.pp_term
-  in
+  let info = get_info ~logic_env t in
   match info.cast with
   | Some ty -> ty
   | None -> info.ty
diff --git a/plugins/e-acsl/tests/constructs/logic_app_reading_memory.c b/plugins/e-acsl/tests/constructs/logic_app_reading_memory.c
new file mode 100644
index 0000000000..6631018110
--- /dev/null
+++ b/plugins/e-acsl/tests/constructs/logic_app_reading_memory.c
@@ -0,0 +1,35 @@
+/* run.config
+   COMMENT: An application of a logic function whose body reads memory is
+   COMMENT: replaced by an application of a specialized copy of the function
+   COMMENT: (Logic_normalizer). Its type must still be found when the
+   COMMENT: application is the whole term of a loop variant or is bound by
+   COMMENT: a \let.
+*/
+
+/*@ logic integer len3(char *s) =
+      s[0] == '\0' ? 0 : s[1] == '\0' ? 1 : s[2] == '\0' ? 2 : 3; */
+
+int walk(char *s) {
+  int n = 0;
+  /*@ loop variant len3(s); */
+  while (*s) {
+    s++;
+    n++;
+  }
+  return n;
+}
+
+int walk_let(char *s) {
+  int n = 0;
+  /*@ loop variant \let k = len3(s); k; */
+  while (*s) {
+    s++;
+    n++;
+  }
+  return n;
+}
+
+int main(void) {
+  char buf[4] = "abc";
+  return walk(buf) + walk_let(buf) - 6;
+}
