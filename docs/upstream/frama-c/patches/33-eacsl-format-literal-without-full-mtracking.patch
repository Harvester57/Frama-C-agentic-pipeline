+int main(void) {
+  char t[32];
+  char b[8] = "abc";
+  char u[3] = {'x', 'y', 'z'}; // not NUL-terminated
+  const char *p = b;
+  const char *q = u;
+  struct rec r = {1, "rec"};
+  int n;
+
+  // Literal format strings and arguments
+  OK(snprintf(t, sizeof t, "%u.%u.%u.%u", 192u, 168u, 1u, 200u));
+  OK(snprintf(t, sizeof t, "%s", "abc"));
+  // Local arrays, directly, through a pointer, a field or a formal
+  OK(snprintf(t, sizeof t, "%s", b));
+  OK(snprintf(t, sizeof t, "%s", p));
+  OK(snprintf(t, sizeof t, "%s|%d", r.name, r.id));
+  OK(print_str(b));
+  OK(snprintf(t, sizeof t, "%s%n", b, &n));
+  OK(snprintf(t, sizeof t, "%p", (void *)&n));
+
+  // Errors are still reported
+  ABRT(snprintf(t, sizeof t, "%d", "abc"));
+  ABRT(snprintf(t, sizeof t, "%s", u));
+  ABRT(snprintf(t, sizeof t, "%s", q));
+  ABRT(print_str(u));
+  return 0;
+}
