From ba6081af0bf23b3fdd329f936652e2f86d509db6 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:53:09 +0000
Subject: [PATCH] [libc] sigaction: assign *oldact from __fc_sigaction[signum]
 and use \old

In share/libc/signal.h, sigaction had two contract defects for oldact:
- assigns *oldact \from &__fc_sigaction passed the address of the array instead of its entry value, creating a garbled mix of &__fc_sigaction;
- ensures oldact_assigned read __fc_sigaction[signum] in the post-state instead of \old(__fc_sigaction[signum]).

Together, installing a non-null handler while saving oldact made the postcondition evaluate to false in Eva (stopping propagation with NON TERMINATING FUNCTION), and querying a previously installed handler with act == NULL made old.sa_handler == h1 invalid.

Assign *oldact from __fc_sigaction[signum], indirect:signum and refer to \old(__fc_sigaction[signum]) in oldact_assigned.

New test: tests/libc/sigaction_oldact.c. Updated oracles: tests/libc/oracle/signal_c_h.{0,1}.res.oracle (garbled-mix warning on *oldact disappears).
---
 share/libc/signal.h                           |   4 +-
 .../libc/oracle/sigaction_oldact.0.res.oracle | 195 ++++++++++++++++++
 tests/libc/oracle/signal_c_h.0.res.oracle     |  32 +--
 tests/libc/oracle/signal_c_h.1.res.oracle     |  32 +--
 tests/libc/sigaction_oldact.c                 |  27 +++
 5 files changed, 236 insertions(+), 54 deletions(-)
 create mode 100644 tests/libc/oracle/sigaction_oldact.0.res.oracle
 create mode 100644 tests/libc/sigaction_oldact.c

diff --git a/share/libc/signal.h b/share/libc/signal.h
index 0773ba4cea..e116f738db 100644
--- a/share/libc/signal.h
+++ b/share/libc/signal.h
@@ -244,13 +244,13 @@ __FC_EXTERN struct sigaction __fc_sigaction[SIGRTMAX+1];
   requires valid_oldact_or_null: oldact == \null || \valid(oldact);
   requires valid_read_act_or_null: act == \null || \valid_read(act);
   requires separation:separated_acts: \separated(act, oldact);
-  assigns *oldact \from &__fc_sigaction;
+  assigns *oldact \from __fc_sigaction[signum], indirect:signum;
   assigns __fc_sigaction[signum] \from *act;
   assigns \result \from indirect:signum, indirect:act, indirect:*act,
                         indirect:oldact, indirect:*oldact;
   ensures act_changed: act == \null || \subset(__fc_sigaction[signum], *act);
   ensures oldact_assigned: oldact == \null ||
-                           \subset({*oldact}, __fc_sigaction[signum]);
+                           \subset({*oldact}, \old(__fc_sigaction[signum]));
   ensures result_ok_or_error: \result == 0 || \result == -1;
  */
 extern int sigaction(int signum, const struct sigaction *restrict act,
