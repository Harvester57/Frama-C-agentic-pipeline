 plugins/e-acsl/src/code_generator/gmp.mli     |   3 +-
 .../tests/arith/oracle/gen_real_constants.0.c | 263 ++++++++++++++++++
 .../arith/oracle/real_constants.0.res.oracle  |  32 +++
