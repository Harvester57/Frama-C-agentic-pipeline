Date: Mon, 23 Nov 2026 00:13:55 +0000
Subject: [PATCH] [kernel] handle \e/\E and reject unknown escapes in ACSL
 lexer

---
 src/kernel/internals/parsing/logic_lexer.mll  |  9 ++++-
 tests/spec/acsl_escape_char.c                 | 28 ++++++++++++++
 .../spec/oracle/acsl_escape_char.0.err.oracle |  0
 .../spec/oracle/acsl_escape_char.0.res.oracle | 38 +++++++++++++++++++
 .../spec/oracle/acsl_escape_char.1.err.oracle |  0
 .../spec/oracle/acsl_escape_char.1.res.oracle |  5 +++
 .../spec/oracle/acsl_escape_char.2.err.oracle |  0
 .../spec/oracle/acsl_escape_char.2.res.oracle |  5 +++
 8 files changed, 83 insertions(+), 2 deletions(-)
 create mode 100644 tests/spec/acsl_escape_char.c
 create mode 100644 tests/spec/oracle/acsl_escape_char.0.err.oracle
 create mode 100644 tests/spec/oracle/acsl_escape_char.0.res.oracle
 create mode 100644 tests/spec/oracle/acsl_escape_char.1.err.oracle
 create mode 100644 tests/spec/oracle/acsl_escape_char.1.res.oracle
 create mode 100644 tests/spec/oracle/acsl_escape_char.2.err.oracle
 create mode 100644 tests/spec/oracle/acsl_escape_char.2.res.oracle

diff --git a/src/kernel/internals/parsing/logic_lexer.mll b/src/kernel/internals/parsing/logic_lexer.mll
index 8b198bcbbc..7f3a1762ee 100644
--- a/src/kernel/internals/parsing/logic_lexer.mll
+++ b/src/kernel/internals/parsing/logic_lexer.mll
@@ -384,7 +384,7 @@ let opIdentifier = (rL | rD | rOP)+
 (* Do not forget to update also the corresponding chr rule if you add
    a supported escape sequence here. *)
 let escape = '\\'
-   ('\'' | '"' | '?' | '\\' | 'a' | 'b' | 'f' | 'n' | 'r'
+   ('\'' | '"' | '?' | '\\' | 'a' | 'b' | 'e' | 'E' | 'f' | 'n' | 'r'
    | 't' | 'v')
 
 let hex_escape = '\\' ['x' 'X'] rH+
@@ -458,7 +458,9 @@ rule token = parse
                               INT_CONSTANT n }
 
   | 'L'? '"' as prelude (([^ '\\' '"' '\n']|("\\"[^ '\n']))* as content) '"'
-      { STRING_LITERAL (prelude.[0] = 'L',content) }
+      { if prelude.[0] <> 'L' then
+          ignore (chr (Buffer.create (String.length content)) (Lexing.from_string content));
+        STRING_LITERAL (prelude.[0] = 'L',content) }
   | '#'                     { hash lexbuf }
   | "==>"                   { IMPLIES }
   | "<==>"                  { IFF }
@@ -555,6 +557,7 @@ and chr buffer = parse
           (match (lexeme lexbuf).[1] with
                'a' -> '\007'
              | 'b' -> '\b'
+             | 'e' | 'E' -> '\027' (* ASCII code 27. This is a GCC extension *)
              | 'f' -> '\012'
              | 'n' -> '\n'
              | 'r' -> '\r'
@@ -566,6 +569,8 @@ and chr buffer = parse
              | '\\' -> '\\'
              | _ -> (* escape regex does not allow anything else *) assert false
           ); chr buffer lexbuf}
+  | '\\' _
+      { lex_error lexbuf ("unrecognized escape sequence: " ^ lexeme lexbuf) }
   | eof { Buffer.contents buffer }
   | _  { Buffer.add_string buffer (lexeme lexbuf); chr buffer lexbuf }
 
diff --git a/tests/spec/acsl_escape_char.c b/tests/spec/acsl_escape_char.c
new file mode 100644
index 0000000000..fa33be74bc
--- /dev/null
+++ b/tests/spec/acsl_escape_char.c
@@ -0,0 +1,28 @@
+/* run.config
+   PLUGIN: @EVA_PLUGINS@
+   EXIT: 0
+   OPT: -eva -print
+
+   EXIT: 1
+   OPT: -kernel-warn-key annot-error=abort -cpp-extra-args="-DUNKNOWN_CHAR"
+   OPT: -kernel-warn-key annot-error=abort -cpp-extra-args="-DUNKNOWN_STR"
+*/
+
+#ifdef UNKNOWN_CHAR
+void main(void) {
+  /*@ check '\z' == 0; */
+}
+#elif defined(UNKNOWN_STR)
+void main(void) {
+  /*@ check sizeof("\z") == 2; */
+}
+#else
+void main(void) {
+  int c_e = '\e';
+  int c_E = '\E';
+  /*@ check c_e == '\e'; */
+  /*@ check c_E == '\E'; */
+  /*@ check '\e' == 27 && '\E' == 27; */
+  /*@ check ("\e")[0] == 27; */
+}
+#endif
