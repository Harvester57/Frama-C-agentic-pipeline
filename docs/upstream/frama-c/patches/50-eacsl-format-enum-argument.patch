From 53ebd5fc4a9a3d0740f940c7e8c8ae6d3368613a Mon Sep 17 00:00:00 2001
From: Florian Stosse <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 19:10:57 +0000
Subject: [PATCH] [e-acsl] handle enum arguments and enum pointers in
 --validate-format-strings

With -e-acsl-validate-format-strings, Functions.Libc.get_printf_argument_str
(plugins/e-acsl/src/libraries/functions.ml) fell into `assert false` for any
variadic argument whose unrolled type is `TEnum _`, crashing Frama-C with:

  Unexpected error (File "plugins/e-acsl/src/libraries/functions.ml", line 156,
  characters 33-39: Assertion failed).

Because default_argument_promotion in cabs2cil.ml preserves `TEnum ei`, any
enum variable, typedef enum, or enum bit-field passed to printf, fprintf,
sprintf, snprintf, dprintf, or syslog triggered this assertion. In addition,
passing a pointer to an enum (such as `&s` for `%n` when the enum's underlying
type is `int`, or a mismatched `%p`/`%s`) fell through `get_pkind_str` to
`Options.fatal "unexpected argument type in printf"`.

Describe `TEnum { ekind }` via `get_ikind_str ekind` and recurse in
`get_pkind_str` on `Cil_const.mk_tint ekind` so enum values and enum pointers
are checked against their underlying integer type, matching C11 6.7.2.2p4 and
the rest of E-ACSL.

Regression test: plugins/e-acsl/tests/format/printf_enum.c.
---
 plugins/e-acsl/src/libraries/functions.ml     |   6 +-
 .../tests/format/oracle/gen_printf_enum.0.c   | 604 ++++++++++++++++++
 .../format/oracle/printf_enum.0.res.oracle    |  31 +
 .../oracle_dev/printf_enum.0.e-acsl.err.log   |  21 +
 plugins/e-acsl/tests/format/printf_enum.c     |  56 ++
 5 files changed, 716 insertions(+), 2 deletions(-)
 create mode 100644 plugins/e-acsl/tests/format/oracle/gen_printf_enum.0.c
 create mode 100644 plugins/e-acsl/tests/format/oracle/printf_enum.0.res.oracle
 create mode 100644 plugins/e-acsl/tests/format/oracle_dev/printf_enum.0.e-acsl.err.log
 create mode 100644 plugins/e-acsl/tests/format/printf_enum.c

diff --git a/plugins/e-acsl/src/libraries/functions.ml b/plugins/e-acsl/src/libraries/functions.ml
index 953d8969cb..e7315d0a6f 100644
--- a/plugins/e-acsl/src/libraries/functions.ml
+++ b/plugins/e-acsl/src/libraries/functions.ml
@@ -128,7 +128,7 @@ module Libc = struct
       | FLongDouble -> "E" (* [long double] *)
     in
     (* get a character representing a pointer type *)
-    let get_pkind_str a ty = match ty.tnode with
+    let rec get_pkind_str a ty = match ty.tnode with
       | TInt IChar | TInt ISChar -> "s" (* [char*] *)
       | TInt IUChar -> "S" (* [unsigned char*] *)
       | TInt IShort -> "q" (* [short*] *)
@@ -139,6 +139,7 @@ module Libc = struct
       | TInt IULong -> "Z" (* [unsigned long int*] *)
       | TInt ILongLong -> "w" (* [long int*] *)
       | TInt IULongLong -> "W" (* [unsigned long int*] *)
+      | TEnum { ekind } -> get_pkind_str a (Cil_const.mk_tint ekind)
       | TVoid -> "p" (* [void*] *)
       | _ ->
         Options.fatal "unexpected argument type in printf: type %a of arg %a@."
@@ -152,7 +153,8 @@ module Libc = struct
            | TInt k -> get_ikind_str k ^ acc
            | TFloat k -> get_fkind_str k ^ acc
            | TPtr ty -> get_pkind_str exp (Ast_types.C.unroll ty) ^ acc
-           | TVoid | TArray _ | TFun _ | TNamed _ | TComp _ | TEnum _
+           | TEnum { ekind } -> get_ikind_str ekind ^ acc
+           | TVoid | TArray _ | TFun _ | TNamed _ | TComp _
            | TBuiltin_va_list -> assert false)
         exps
         ""
