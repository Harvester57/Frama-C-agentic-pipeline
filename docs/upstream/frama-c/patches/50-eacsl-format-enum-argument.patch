@@ -0,0 +1,56 @@
+/* run.config
+   COMMENT: Check format validation of enumeration arguments and enum pointers
+   DEPS: @PTEST_DEPS@ utils/signalled.h
+   STDOPT:
+*/
+/* run.config_dev
+   MACRO: INCLUDED_HEADERS utils/signalled.h
+   COMMENT: This part is blank on purpose (test stability + Dune)
+
+*/
+
+#include "utils/signalled.h"
+#include <stdio.h>
+
+enum U { U_A = 0, U_B = 1 };
+enum S { S_NEG = -1, S_POS = 1 };
+enum L { L_BIG = 1ULL << 40 };
+enum SL { SL_NEG = -1, SL_BIG = 1LL << 40 };
+enum __attribute__((packed)) PU { PU_A = 0, PU_B = 1 };
+enum __attribute__((packed)) PS { PS_NEG = -1, PS_POS = 1 };
+typedef enum U u_t;
+struct BF {
+  enum U u : 3;
+  enum S s : 3;
+};
+
+int main(void) {
+  enum U u = U_B;
+  enum S s = S_NEG;
+  enum L l = L_BIG;
+  enum SL sl = SL_BIG;
+  enum PU pu = PU_B;
+  enum PS ps = PS_NEG;
+  const u_t cu = U_B;
+  struct BF bf = {U_B, S_NEG};
+  char t[32];
+
+  // Valid format directives matching each enum's underlying integer type
+  OK(printf("%u %o %x %X\n", u, u, u, u));
+  OK(printf("%d %i\n", s, s));
+  OK(printf("%lu %lx %ld %li\n", l, l, sl, sl));
+  OK(printf("%u %u %d\n", cu, bf.u, bf.s));
+  OK(printf("%d %d %hhu\n", ps, pu, pu));
+  OK(snprintf(t, sizeof t, "%u %d", u, s));
+  OK(printf("hi%n\n", &s));
+
+  // Mismatched format directives must still abort cleanly at run time
+  ABRT(printf("%s\n", s));
+  ABRT(printf("%d\n", u));
+  ABRT(printf("%u\n", s));
+  ABRT(printf("%lu\n", u));
+  ABRT(printf("%d\n", sl));
+  ABRT(printf("hi%n\n", &u));
+  ABRT(printf("%p\n", &s));
+  return 0;
+}
