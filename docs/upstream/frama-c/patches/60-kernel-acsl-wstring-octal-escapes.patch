From f5c568bb712933a075877ac3f127091784a90538 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 23 Nov 2026 00:06:53 +0000
Subject: [PATCH] [kernel] restrict ACSL wide-string octal escapes to 0-7 and
 support \v

---
 .../services/ast_queries/logic_typing.ml      |  5 ++--
 .../spec/oracle/wstring_escapes.0.res.oracle  | 26 +++++++++++++++++++
 tests/spec/wstring_escapes.c                  | 11 ++++++++
 3 files changed, 40 insertions(+), 2 deletions(-)
 create mode 100644 tests/spec/oracle/wstring_escapes.0.res.oracle
 create mode 100644 tests/spec/wstring_escapes.c

diff --git a/src/kernel/services/ast_queries/logic_typing.ml b/src/kernel/services/ast_queries/logic_typing.ml
index 0c4e2734c9..6fd360e0b6 100644
--- a/src/kernel/services/ast_queries/logic_typing.ml
+++ b/src/kernel/services/ast_queries/logic_typing.ml
@@ -27,7 +27,7 @@ let wcharlist_of_string s =
     if nb_pass > 2 then res:= n::!res
     else if !i >= String.length s then res:= n::!res
     else match String.get s !i with
-        x when '0' <= x && x <= '9' ->
+        x when '0' <= x && x <= '7' ->
         incr i;
         treat_escape_octal
           (Int64.add (Int64.mul (Int64.of_int 8) n)
@@ -59,7 +59,7 @@ let wcharlist_of_string s =
       Kernel.warning ~current:true "Ill-formed escape sequence in wide string"
     else begin
       match String.get s !i with
-        x when '0' <= x && x <= '9' ->
+        x when '0' <= x && x <= '7' ->
         treat_escape_octal Int64.zero 0
       | 'x' -> incr i; treat_escape_hexa Int64.zero
       | 'a' -> incr i; res:= Int64.of_int 7::!res
@@ -68,6 +68,7 @@ let wcharlist_of_string s =
       | 'n' -> incr i; res:= Int64.of_int (Char.code '\n') :: !res
       | 'r' -> incr i; res:=Int64.of_int (Char.code '\r')::!res
       | 't' -> incr i; res:= Int64.of_int (Char.code '\t') ::!res
+      | 'v' -> incr i; res:= Int64.of_int 11 :: !res
       | '\'' -> incr i; res:=Int64.of_int (Char.code '\'')::!res
       | '"' -> incr i; res:= Int64.of_int (Char.code '"') ::!res
       | '?' -> incr i; res:= Int64.of_int (Char.code '?') ::!res
diff --git a/tests/spec/oracle/wstring_escapes.0.res.oracle b/tests/spec/oracle/wstring_escapes.0.res.oracle
new file mode 100644
index 0000000000..30032a058f
--- /dev/null
+++ b/tests/spec/oracle/wstring_escapes.0.res.oracle
@@ -0,0 +1,26 @@
+[kernel] Parsing wstring_escapes.c (with preprocessing)
+/* Generated by Frama-C */
+int main(void)
+{
+  int __retres;
+  /*@
+  check
+    oct_18:
+      (\let tmp = L"\\001" "8" ; tmp[0]) ≡ 1 ∧
+      (\let tmp = L"\\001" "8" ; tmp[1]) ≡ '8';
+   */
+  ;
+  /*@
+  check
+    oct_79:
+      (\let tmp = L"\\a" "9" ; tmp[0]) ≡ 7 ∧
+      (\let tmp = L"\\a" "9" ; tmp[1]) ≡ '9';
+   */
+  ;
+  /*@ check oct_123: (\let tmp = L"S" ; tmp[0]) ≡ 83; */ ;
+  /*@ check esc_v: (\let tmp = L"\\v" ; tmp[0]) ≡ 11; */ ;
+  __retres = 0;
+  return __retres;
+}
+
+
diff --git a/tests/spec/wstring_escapes.c b/tests/spec/wstring_escapes.c
new file mode 100644
index 0000000000..542d8f60de
--- /dev/null
+++ b/tests/spec/wstring_escapes.c
@@ -0,0 +1,11 @@
+/* run.config
+   STDOPT:
+*/
+
+int main(void) {
+  //@ check oct_18: L"\18"[0] == 1 && L"\18"[1] == '8';
+  //@ check oct_79: L"\79"[0] == 7 && L"\79"[1] == '9';
+  //@ check oct_123: L"\123"[0] == 83;
+  //@ check esc_v: L"\v"[0] == 11;
+  return 0;
+}
-- 
2.47.3

