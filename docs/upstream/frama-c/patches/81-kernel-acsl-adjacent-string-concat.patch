From 180dfc11f317e2b8fac6c2f8b52455264f229c55 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 23 Nov 2026 00:12:23 +0000
Subject: [PATCH] [kernel] preserve escape boundaries when concatenating ACSL
 string literals

---
 src/kernel/internals/parsing/logic_parser.mly | 59 ++++++++++++++++++-
 .../oracle/string_concat_escape.0.err.oracle  |  0
 .../oracle/string_concat_escape.0.res.oracle  | 18 ++++++
 tests/spec/string_concat_escape.c             | 16 +++++
 4 files changed, 92 insertions(+), 1 deletion(-)
 create mode 100644 tests/spec/oracle/string_concat_escape.0.err.oracle
 create mode 100644 tests/spec/oracle/string_concat_escape.0.res.oracle
 create mode 100644 tests/spec/string_concat_escape.c

diff --git a/src/kernel/internals/parsing/logic_parser.mly b/src/kernel/internals/parsing/logic_parser.mly
index c0cd0c6c5c..792baa4f49 100644
--- a/src/kernel/internals/parsing/logic_parser.mly
+++ b/src/kernel/internals/parsing/logic_parser.mly
@@ -41,6 +41,63 @@
       post_cond = [];
     }
 
+  let is_hex_digit = function
+    | '0'..'9' | 'a'..'f' | 'A'..'F' -> true
+    | _ -> false
+
+  let is_oct_digit = function
+    | '0'..'7' -> true
+    | _ -> false
+
+  let hex_val c =
+    if c >= '0' && c <= '9' then Char.code c - Char.code '0'
+    else if c >= 'a' && c <= 'f' then Char.code c - Char.code 'a' + 10
+    else Char.code c - Char.code 'A' + 10
+
+  (* Preserve escape boundaries when concatenating adjacent raw ACSL string
+     literals (ISO C11 5.1.1.2p1 phase 6): a trailing hex or short octal escape
+     in [prefix] must not absorb digits from the start of [suffix]. *)
+  let concat_string_literal prefix suffix =
+    let n = String.length prefix in
+    if n = 0 || String.length suffix = 0 then prefix ^ suffix
+    else
+      let c0 = suffix.[0] in
+      let rec scan i =
+        if i >= n then prefix ^ suffix
+        else if prefix.[i] <> '\\' then scan (i + 1)
+        else if i + 1 >= n then prefix ^ suffix
+        else
+          match prefix.[i + 1] with
+          | 'x' | 'X' ->
+            let rec hex_end j acc =
+              if j < n && is_hex_digit prefix.[j] then
+                let acc' =
+                  if acc <= 0xff then acc * 16 + hex_val prefix.[j] else acc
+                in
+                hex_end (j + 1) acc'
+              else j, acc
+            in
+            let j, acc = hex_end (i + 2) 0 in
+            if j = n && j > i + 2 && is_hex_digit c0 && acc <= 0xff then
+              String.sub prefix 0 i ^ Printf.sprintf "\\%03o" acc ^ suffix
+            else
+              scan j
+          | c when is_oct_digit c ->
+            let rec oct_end j k =
+              if j < n && k < 3 && is_oct_digit prefix.[j] then
+                oct_end (j + 1) (k + 1)
+              else j, k
+            in
+            let j, k = oct_end (i + 1) 0 in
+            if j = n && k < 3 && c0 >= '0' && c0 <= '9' then
+              let pad = String.make (3 - k) '0' in
+              String.sub prefix 0 (i + 1) ^ pad ^ String.sub prefix (i + 1) k ^ suffix
+            else
+              scan j
+          | _ -> scan (i + 2)
+      in
+      scan 0
+
   let loc (start_pos, end_pos) =
     Errorloc.convert_loc (start_pos, end_pos)
 
@@ -679,7 +736,7 @@ string:
 | string STRING_LITERAL
     { let (is_wide,prefix) = $1 in
       let (is_wide2,suffix) = $2 in
-      (is_wide || is_wide2, prefix ^ suffix)
+      (is_wide || is_wide2, concat_string_literal prefix suffix)
     }
 ;
 
diff --git a/tests/spec/oracle/string_concat_escape.0.err.oracle b/tests/spec/oracle/string_concat_escape.0.err.oracle
new file mode 100644
index 0000000000..e69de29bb2
diff --git a/tests/spec/oracle/string_concat_escape.0.res.oracle b/tests/spec/oracle/string_concat_escape.0.res.oracle
new file mode 100644
index 0000000000..fa9950e6d9
--- /dev/null
+++ b/tests/spec/oracle/string_concat_escape.0.res.oracle
@@ -0,0 +1,18 @@
+[kernel] Parsing string_concat_escape.c (with preprocessing)
+/* Generated by Frama-C */
+void main(void)
+{
+  char const *a = "\0041";
+  char const *b = "\0012";
+  /*@ check c_hex: (\let tmp = "\0041"; tmp[0]) ≡ 4; */ ;
+  /*@ check c_hex_alpha: (\let tmp = "\004a"; tmp[0]) ≡ 4; */ ;
+  /*@ check c_oct: (\let tmp = "\0012"; tmp[0]) ≡ 1; */ ;
+  /*@ check c_oct_short: (\let tmp = "\a8"; tmp[0]) ≡ 7; */ ;
+  /*@ check c_bs: (\let tmp = "\\x41"; tmp[0]) ≡ '\\'; */ ;
+  /*@ check c_triple: (\let tmp = "\00412"; tmp[0]) ≡ 4; */ ;
+  /*@ check c_wide_hex: (\let tmp = L"\\004" "1" ; tmp[0]) ≡ 4; */ ;
+  /*@ check c_wide_oct: (\let tmp = L"\\001" "2" ; tmp[0]) ≡ 1; */ ;
+  return;
+}
+
+
diff --git a/tests/spec/string_concat_escape.c b/tests/spec/string_concat_escape.c
new file mode 100644
index 0000000000..1b7e57b0ef
--- /dev/null
+++ b/tests/spec/string_concat_escape.c
@@ -0,0 +1,16 @@
+/* run.config
+   STDOPT: +"-print"
+*/
+
+void main(void) {
+  const char *a = "\x4" "1";
+  const char *b = "\01" "2";
+  /*@ check c_hex: ("\x4" "1")[0] == 4; */
+  /*@ check c_hex_alpha: ("\x4" "a")[0] == 4; */
+  /*@ check c_oct: ("\01" "2")[0] == 1; */
+  /*@ check c_oct_short: ("\7" "8")[0] == 7; */
+  /*@ check c_bs: ("\\" "x41")[0] == '\\'; */
+  /*@ check c_triple: ("\x4" "1" "2")[0] == 4; */
+  /*@ check c_wide_hex: (L"\x4" "1")[0] == 4; */
+  /*@ check c_wide_oct: (L"\01" "2")[0] == 1; */
+}
