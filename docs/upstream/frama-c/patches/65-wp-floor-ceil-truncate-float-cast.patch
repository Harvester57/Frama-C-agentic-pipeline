From 7bcf117992f85b598c4a0b7aa484c20ef5165906 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:50:37 +0000
Subject: [PATCH] [wp] compute exact big-int floor/ceil/truncate on rational
 constants

Cmath.builtin_truncate computed `int_of_float (Q.to_float r)` on
rational constants `Kreal r`. Converting through IEEE 754 `double` and
63-bit OCaml `int` lost precision near integers (proving false facts
such as `\floor(0.99999999999999999999) == 1` and
`\floor(9007199254740993.5) == 9007199254740994`) and wrapped or
returned unspecified values above `2^62` (proving `(long long)5e18 ==
-4223372036854775808` and `\floor(1e30) == 0`).

Compute exact arbitrary-precision integers directly with Zarith
(`Z.fdiv`, `Z.cdiv`, and `Q.to_bigint`) whenever `Q.is_real r`.

New test: wp_acsl/truncate_const.i.
---
 plugins/wp/src/Cmath.ml                       |  20 +--
 .../oracle/truncate_const.0.res.oracle        | 133 ++++++++++++++++++
 plugins/wp/tests/wp_acsl/truncate_const.i     |  35 +++++
 3 files changed, 175 insertions(+), 13 deletions(-)
 create mode 100644 plugins/wp/tests/wp_acsl/oracle/truncate_const.0.res.oracle
 create mode 100644 plugins/wp/tests/wp_acsl/truncate_const.i

diff --git a/plugins/wp/src/Cmath.ml b/plugins/wp/src/Cmath.ml
index 6398f2f612..cb2d4bdfe4 100644
--- a/plugins/wp/src/Cmath.ml
+++ b/plugins/wp/src/Cmath.ml
@@ -44,19 +44,13 @@ let builtin_truncate f e =
   match F.repr e with
   | Kint _ -> e
   | Kreal r when Q.(equal r zero) -> e_zero
-  | Kreal r ->
-    begin
-      try
-        (* Waiting for Z-Arith to have truncation to big-int *)
-        let truncated = int_of_float (Q.to_float r) in
-        let reversed = Q.of_int truncated in
-        let base = F.e_int truncated in
-        if Q.equal r reversed then base else
-        if f == f_ceil && Q.(lt zero r) then F.(e_add base e_one) else
-        if f == f_floor && Q.(lt r zero) then F.(e_sub base e_one) else
-          base
-      with _ -> raise Not_found
-    end
+  | Kreal r when Q.is_real r ->
+    let z =
+      if f == f_floor then Z.fdiv r.Q.num r.Q.den
+      else if f == f_ceil then Z.cdiv r.Q.num r.Q.den
+      else Q.to_bigint r
+    in
+    F.e_zint z
   | Fun( f , [e] ) when f_real_of_int @= f -> e
   | _ -> raise Not_found
 
