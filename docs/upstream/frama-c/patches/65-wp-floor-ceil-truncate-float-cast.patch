+/* run.config
+   OPT:
+*/
+
+/*@ check lemma floor_near_ok:    \floor(0.99999999999999999999) == 0;
+    check lemma ceil_near_ok:     \ceil(0.99999999999999999999) == 1;
+    check lemma trunc_near_ok:    \truncate(-0.99999999999999999999) == 0;
+    check lemma floor_neg_ok:     \floor(-0.99999999999999999999) == -1;
+    check lemma ceil_neg_ok:      \ceil(-0.99999999999999999999) == 0;
+    check lemma floor_big_ok:     \floor(9007199254740993.5) ==
+   9007199254740993; check lemma cast_int_ok: (integer)0.99999999999999999999 ==
+   0; check lemma floor_huge_ok:    \floor(1e30) ==
+   1000000000000000000000000000000; check lemma ceil_huge_neg_ok: \ceil(-1e30)
+   == -1000000000000000000000000000000; check lemma trunc_huge_ok:
+   \truncate(1e30) == 1000000000000000000000000000000; check lemma
+   floor_near_bad:   \floor(0.99999999999999999999) == 1; check lemma
+   floor_huge_bad:   \floor(1e30) == 0; */
+
+/*@ ensures \result == 5000000000000000000; */
+long long trunc_ll_ok(void) {
+  double d = 5e18;
+  return (long long)d;
+}
+
+/*@ ensures \result == -4223372036854775808; */
+long long trunc_ll_bad(void) {
+  double d = 5e18;
+  return (long long)d;
+}
+
+/*@ ensures \result == 4611686018427387904ULL; */
+unsigned long long trunc_ull_ok(void) {
+  float f = 4611686018427387904.0f;
+  return (unsigned long long)f;
+}
