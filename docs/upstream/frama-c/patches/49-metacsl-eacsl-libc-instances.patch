diff --git a/tests/meta/no_footprint.i b/tests/meta/no_footprint.i
new file mode 100644
index 0000000..239f0bf
--- /dev/null
+++ b/tests/meta/no_footprint.i
@@ -0,0 +1,30 @@
+/* run.config*
+   OPT: @META@ @PRINT@
+   OPT: @META@ -meta-warn-key no-footprint=inactive @PRINT@
+*/
+
+int protected;
+int other;
+
+/* Declared without any specification, as libc functions are when the code is
+   parsed with the system headers: the call must give a warning. */
+extern void *copy(void *dst, const void *src, unsigned long n);
+
+/* A behavior without assigns: the call gives the same warning. */
+/*@ requires \true; */
+extern void touch(int *p);
+
+/* A footprint: the call is checked, no warning. */
+/*@ assigns ((char *)dst)[0 .. n - 1] \from ((char *)src)[0 .. n - 1]; */
+extern void copy_spec(void *dst, const void *src, unsigned long n);
+
+void f(const char *in)
+{
+  copy(&protected, in, sizeof(protected));
+  touch(&protected);
+  copy_spec(&other, in, sizeof(other));
+}
+
+/*@ meta \prop, \name(no_write), \targets({f}), \context(\writing),
+      \separated(\written, &protected);
+*/
diff --git a/tests/meta/oracle/no_footprint.0.res.oracle b/tests/meta/oracle/no_footprint.0.res.oracle
new file mode 100644
index 0000000..42ebd2f
--- /dev/null
+++ b/tests/meta/oracle/no_footprint.0.res.oracle
@@ -0,0 +1,39 @@
+[kernel] Parsing no_footprint.i (no preprocessing)
+[meta] Translation is enabled
+[meta] Will process 1 properties
+[meta:no-footprint] Warning: 
+  Cannot analyze footprint of function copy: no assigns clause. Assuming meta-properties with reading/writing contexts are valid in this function.
+[meta:no-footprint] Warning: 
+  Cannot analyze footprint of function touch: no assigns clause. Assuming meta-properties with reading/writing contexts are valid in this function.
+[meta] Successful translation
+/* Generated by Frama-C */
+int protected;
+int other;
+extern void *copy(void *dst, void const *src, unsigned long n);
+
+/*@ requires \true; */
+extern void touch(int *p);
+
+/*@ assigns *((char *)dst + (0 .. n - 1));
+    assigns *((char *)dst + (0 .. n - 1))
+      \from *((char *)src + (0 .. n - 1));
+ */
+extern void copy_spec(void *dst, void const *src, unsigned long n);
+
+void f(char const *in)
+{
+  copy((void *)(& protected),(void const *)in,sizeof(protected));
+  touch(& protected);
+  /*@ assert
+        no_write: meta:
+          \separated(
+            (char *)((void *)(&other)) + (0 .. sizeof(int) - 1), &protected
+            );
+  */
+  copy_spec((void *)(& other),(void const *)in,sizeof(other));
+  return;
+}
+
+/*@ \meta::meta "no_write";
+*/
+
