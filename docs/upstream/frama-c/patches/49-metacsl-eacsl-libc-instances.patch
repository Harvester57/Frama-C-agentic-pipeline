diff --git a/tests/meta/no_footprint.i b/tests/meta/no_footprint.i
new file mode 100644
index 0000000..24b190d
--- /dev/null
+++ b/tests/meta/no_footprint.i
@@ -0,0 +1,47 @@
+/* run.config*
+   OPT: @META@ @PRINT@
+   OPT: @META@ -meta-warn-key no-footprint=inactive @PRINT@
+*/
+
+int protected;
+int secret;
+int other;
+int buf;
+
+/* Declared without any specification, as libc functions are when the code is
+   parsed with the system headers: the call must give a warning. */
+extern void *copy(void *dst, const void *src, unsigned long n);
+
+/* A behavior without assigns: the call gives the same warning. */
+/*@ requires \true; */
+extern void touch(int *p);
+
+/* Assigns without \from: checked for \writing, warns for \reading. */
+/*@ assigns *p; */
+extern void assign_only(int *p);
+
+/* Both assigns and \from: checked for both contexts, no warning. */
+/*@ assigns ((char *)dst)[0 .. n - 1] \from ((char *)src)[0 .. n - 1]; */
+extern void copy_spec(void *dst, const void *src, unsigned long n);
+
+void f_write(int *p)
+{
+  copy(&protected, &secret, sizeof(protected));
+  touch(&protected);
+  assign_only(p);
+  copy_spec(&other, &buf, sizeof(other));
+}
+
+void f_read(void)
+{
+  copy(&protected, &secret, sizeof(protected));
+  touch(&protected);
+  assign_only(&other);
+  copy_spec(&other, &buf, sizeof(other));
+}
+
+/*@ meta \prop, \name(no_write), \targets({f_write}), \context(\writing),
+      \separated(\written, &protected);
+    meta \prop, \name(no_read), \targets({f_read}), \context(\reading),
+      \separated(\read, &secret);
+*/
