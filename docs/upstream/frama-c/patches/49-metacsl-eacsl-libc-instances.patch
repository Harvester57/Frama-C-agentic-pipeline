@@ -0,0 +1,68 @@
+[kernel] Parsing no_footprint.i (no preprocessing)
+[meta] Translation is enabled
+[meta] Will process 2 properties
+[meta:no-footprint] no_footprint.i:29: Warning: 
+  Cannot analyze footprint of function copy: no assigns clause. Assuming meta-properties with reading/writing contexts are valid in this function.
+[meta:no-footprint] no_footprint.i:30: Warning: 
+  Cannot analyze footprint of function touch: no assigns clause. Assuming meta-properties with reading/writing contexts are valid in this function.
+[meta:no-footprint] no_footprint.i:37: Warning: 
+  Cannot analyze footprint of function copy: no assigns clause. Assuming meta-properties with reading/writing contexts are valid in this function.
+[meta:no-footprint] no_footprint.i:38: Warning: 
+  Cannot analyze footprint of function touch: no assigns clause. Assuming meta-properties with reading/writing contexts are valid in this function.
+[meta:no-footprint] no_footprint.i:39: Warning: 
+  Cannot fully analyze read footprint of function assign_only: no \from part in some assigns clauses.
+[meta] Successful translation
+/* Generated by Frama-C */
+int protected;
+int secret;
+int other;
+int buf;
+extern void *copy(void *dst, void const *src, unsigned long n);
+
+/*@ requires \true; */
+extern void touch(int *p);
+
+/*@ assigns *p; */
+extern void assign_only(int *p);
+
+/*@ assigns *((char *)dst + (0 .. n - 1));
+    assigns *((char *)dst + (0 .. n - 1))
+      \from *((char *)src + (0 .. n - 1));
+ */
+extern void copy_spec(void *dst, void const *src, unsigned long n);
+
+void f_write(int *p)
+{
+  copy((void *)(& protected),(void const *)(& secret),sizeof(protected));
+  touch(& protected);
+  /*@ assert no_write: meta: \separated(p, &protected); */
+  assign_only(p);
+  /*@ assert
+        no_write: meta:
+          \separated(
+            (char *)((void *)(&other)) + (0 .. sizeof(int) - 1), &protected
+            );
+  */
+  copy_spec((void *)(& other),(void const *)(& buf),sizeof(other));
+  return;
+}
+
+void f_read(void)
+{
+  copy((void *)(& protected),(void const *)(& secret),sizeof(protected));
+  touch(& protected);
+  assign_only(& other);
+  /*@ assert
+        no_read: meta:
+          \separated(
+            (char *)((void const *)(&buf)) + (0 .. sizeof(int) - 1), &secret
+            );
+  */
+  copy_spec((void *)(& other),(void const *)(& buf),sizeof(other));
+  return;
+}
+
+/*@ \meta::meta "no_write"; */
+/*@ \meta::meta "no_read";
+*/
+
