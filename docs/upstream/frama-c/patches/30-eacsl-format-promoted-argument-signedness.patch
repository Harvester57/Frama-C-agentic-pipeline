index 0000000000..a23f8b6c59
--- /dev/null
+++ b/plugins/e-acsl/tests/format/printf_promoted.c
@@ -0,0 +1,48 @@
+/* run.config
+   COMMENT: Check format validation of arguments promoted to int
+   DEPS: @PTEST_DEPS@ utils/signalled.h
+   STDOPT:
+*/
+/* run.config_dev
+   MACRO: INCLUDED_HEADERS utils/signalled.h
+   COMMENT: This part is blank on purpose (test stability + Dune)
+
+*/
+
+#include "utils/signalled.h"
+#include <stdio.h>
+
+int main(void) {
+  unsigned char uc = 200;
+  unsigned short us = 60000;
+  _Bool b = 1;
+  signed char sc = -1;
+  short s = -2;
+  const unsigned char addr[4] = {192, 168, 1, 200};
+  char t[16];
+
+  // An argument of an unsigned type smaller than int is promoted to int, and
+  // each of its values is representable in both int and unsigned int
+  OK(printf("%u %o %x %X\n", uc, uc, uc, uc));
+  OK(printf("%u %o %x %X\n", us, us, us, us));
+  OK(printf("%u %x %d\n", b, b, b));
+  OK(printf("%d %i %c\n", uc, us, uc));
+  OK(printf("%hhu %hhd %hu %hd\n", uc, uc, us, us));
+  OK(snprintf(t, sizeof t, "%u.%u.%u.%u", addr[0], addr[1], addr[2], addr[3]));
+  OK(printf("%u\n", (unsigned char)(uc + 100)));
+
+  // A signed type smaller than int is promoted to int too, but a negative
+  // value is not representable in unsigned int
+  OK(printf("%d %i %hhd %hd\n", sc, s, sc, s));
+  ABRT(printf("%u\n", sc));
+  ABRT(printf("%x\n", s));
+
+  // int and unsigned int are still distinct types
+  ABRT(printf("%u\n", 7));
+  ABRT(printf("%d\n", 7u));
+
+  // The promoted argument is an int: it does not match a longer type
+  ABRT(printf("%lu\n", uc));
+  ABRT(printf("%llx\n", us));
+  return 0;
+}
