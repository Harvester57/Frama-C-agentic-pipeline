+                     neg_inf < 0.0)) + (nan_val != nan_val)) + (finf > 0.0f)) + (
+                  fnan != fnan)) + (h > 0.0)) + (g > 0.0)) + (nz == 0.0)) + (
+              f32_inf > 0.0f32)) + (f64_third > 0.0f64);
+  return __retres;
+}
