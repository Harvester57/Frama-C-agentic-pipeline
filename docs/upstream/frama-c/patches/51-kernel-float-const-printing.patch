+double nan_val = (0.0 / 0.0);
+float finf = (1.0f / 0.0f);
+float fnan = (0.0f / 0.0f);
+int main(void)
+{
+  int __retres;
+  double h = 6.283185307179586;
+  double g = 0.10000000149011612;
+  double nz = -0.;
