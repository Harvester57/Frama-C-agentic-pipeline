From 02950cc5accdf9aac947218244e97317cb3fc2a0 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:52:33 +0000
Subject: [PATCH] [kernel] check value preservation for target fkind in
 Cil.isExactFloat

---
 src/kernel/services/ast_queries/cil.ml        |  4 +-
 tests/spec/float_cast_exact.c                 | 24 +++++++
 .../spec/oracle/float_cast_exact.0.res.oracle | 33 ++++++++++
 .../spec/oracle/float_cast_exact.1.res.oracle | 63 +++++++++++++++++++
 4 files changed, 123 insertions(+), 1 deletion(-)
 create mode 100644 tests/spec/float_cast_exact.c
 create mode 100644 tests/spec/oracle/float_cast_exact.0.res.oracle
 create mode 100644 tests/spec/oracle/float_cast_exact.1.res.oracle

diff --git a/src/kernel/services/ast_queries/cil.ml b/src/kernel/services/ast_queries/cil.ml
index c9d63222f2..2f6ae69c99 100644
--- a/src/kernel/services/ast_queries/cil.ml
+++ b/src/kernel/services/ast_queries/cil.ml
@@ -2492,7 +2492,9 @@ let isFiniteFloat fk f =
   Floating_point.is_finite f
 
 let isExactFloat fk r =
-  r.r_upper = r.r_lower && isFiniteFloat fk r.r_nearest
+  r.r_upper = r.r_lower &&
+  let f = Floating_point.round_if_single_precision fk r.r_nearest in
+  Floating_point.is_finite f && Float.equal f r.r_nearest
 
 (* Construct an integer constant with possible truncation if the kind is not
    specified  *)
diff --git a/tests/spec/float_cast_exact.c b/tests/spec/float_cast_exact.c
new file mode 100644
index 0000000000..188d11ac7a
--- /dev/null
+++ b/tests/spec/float_cast_exact.c
@@ -0,0 +1,24 @@
+/* run.config
+   STDOPT:
+   STDOPT: +"-eva"
+*/
+
+/*@ check lemma exact_float: (float)16777216.0 == 16777216.0;
+    check lemma inexact_float: (float)16777217.0 == 16777216.0;
+    check lemma wrong_float: (float)16777217.0 == 16777217.0; */
+
+int g;
+void dead(int z) {
+  //@ assert (float)16777217.0 == 16777216.0;
+  g = 10 / z;
+}
+
+int main(void) {
+  float lim = 2147483647.0f;
+  float big = 1e11f;
+  //@ check true_1: lim <= (float)2147483647.0;
+  //@ check true_2: big == (float)1e11;
+  //@ check true_3: (float)1e11 == 99999997952.0;
+  dead(0);
+  return 0;
+}
diff --git a/tests/spec/oracle/float_cast_exact.0.res.oracle b/tests/spec/oracle/float_cast_exact.0.res.oracle
new file mode 100644
index 0000000000..3222093dc5
--- /dev/null
+++ b/tests/spec/oracle/float_cast_exact.0.res.oracle
@@ -0,0 +1,33 @@
+[kernel] Parsing float_cast_exact.c (with preprocessing)
+[kernel:parser:decimal-float] float_cast_exact.c:17: Warning: 
+  Floating-point constant 2147483647.0f is not represented exactly. Will use 0x1.0000000000000p31.
+  (warn-once: no further messages from category 'parser:decimal-float' will be emitted)
+/* Generated by Frama-C */
+/*@ check lemma exact_float: 16777216.0 ≡ 16777216.0;
+ */
+/*@ check lemma inexact_float: (float)16777217.0 ≡ 16777216.0;
+ */
+/*@ check lemma wrong_float: (float)16777217.0 ≡ 16777217.0;
+ */
+int g;
+void dead(int z)
+{
+  /*@ assert (float)16777217.0 ≡ 16777216.0; */ ;
+  g = 10 / z;
+  return;
+}
+
+int main(void)
+{
+  int __retres;
+  float lim = 2147483647.0f;
+  float big = 1e11f;
+  /*@ check true_1: lim ≤ (float)2147483647.0; */ ;
+  /*@ check true_2: big ≡ (float)1e11; */ ;
+  /*@ check true_3: (float)1e11 ≡ 99999997952.0; */ ;
+  dead(0);
+  __retres = 0;
+  return __retres;
+}
+
+
