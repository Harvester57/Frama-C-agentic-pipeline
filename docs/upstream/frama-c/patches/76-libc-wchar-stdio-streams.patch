From f75b1252a6d2a1134ca331fe24e23b9a9efc0640 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 23 Nov 2026 00:05:29 +0000
Subject: [PATCH] [libc] __fc_define_file.h: declare __fc_stdin/__fc_stdout for
 <wchar.h>

ISO C11 7.29.2.10-11 declares wprintf() and wscanf() in <wchar.h> without requiring <stdio.h>. The Variadic translation classifies both as StdIO and looks up __fc_stdout / __fc_stdin, which were declared only in share/libc/stdio.h. Including <wchar.h> alone therefore emitted kernel:libc:frama-c warnings and omitted stream assigns/from clauses on __fc_stdout->__fc_FILE_data and __fc_stdin->__fc_FILE_data.

Move the internal __fc_stderr, __fc_stdin, and __fc_stdout extern declarations into share/libc/__fc_define_file.h (included only by stdio.h and wchar.h) while keeping the stderr, stdin, and stdout macros exclusively in share/libc/stdio.h so <wchar.h> does not pollute the ISO C namespace.

New test: tests/libc/wchar_stdio_streams.c.
---
 share/libc/__fc_define_file.h                 |  4 ++
 share/libc/stdio.h                            |  6 +-
 .../oracle/wchar_stdio_streams.0.res.oracle   | 72 +++++++++++++++++++
 tests/libc/wchar_stdio_streams.c              | 11 +++
 4 files changed, 90 insertions(+), 3 deletions(-)
 create mode 100644 tests/libc/oracle/wchar_stdio_streams.0.res.oracle
 create mode 100644 tests/libc/wchar_stdio_streams.c

diff --git a/share/libc/__fc_define_file.h b/share/libc/__fc_define_file.h
index 90d42723cd..14db573d52 100644
--- a/share/libc/__fc_define_file.h
+++ b/share/libc/__fc_define_file.h
@@ -24,6 +24,10 @@ typedef struct __fc_FILE FILE;
 #define __FILE_defined 1
 #endif
 
+__FC_EXTERN_FOR_MACRO(stderr) FILE * __fc_stderr;
+__FC_EXTERN_FOR_MACRO(stdin) FILE * __fc_stdin;
+__FC_EXTERN_FOR_MACRO(stdout) FILE * __fc_stdout;
+
 __END_DECLS
 __POP_FC_STDLIB
 #endif
diff --git a/share/libc/stdio.h b/share/libc/stdio.h
index f8e11588b6..7c6e926d5d 100644
--- a/share/libc/stdio.h
+++ b/share/libc/stdio.h
@@ -49,13 +49,13 @@ __PUSH_FC_STDLIB
 
 __BEGIN_DECLS
 
-__FC_EXTERN_FOR_MACRO(stderr) FILE * __fc_stderr;
+/* __fc_stderr, __fc_stdin and __fc_stdout are declared in __fc_define_file.h
+   so that <wchar.h> can use them without exposing these ISO C macros. */
+
 #define stderr (__fc_stderr)
 
-__FC_EXTERN_FOR_MACRO(stdin) FILE * __fc_stdin;
 #define stdin (__fc_stdin)
 
-__FC_EXTERN_FOR_MACRO(stdout) FILE * __fc_stdout;
 #define stdout (__fc_stdout)
 
 /*
