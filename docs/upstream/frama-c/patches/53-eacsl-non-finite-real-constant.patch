From 99b6c2336b0937d4f838438947d55f92d3fde204 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:52:10 +0000
Subject: [PATCH] [e-acsl] reject non-finite floating-point constants as not
 yet supported

An overflowing suffixed floating-point literal in an ACSL annotation
(such as 1e40f, 1e400d, or 0x1p2000d) is parsed by Logic_utils.parse_float
into a logic_real with r_lower = r_upper = r_nearest = infinity.

Both Interval.infer_term and Translate_terms.constant_to_exp_old only
tested lr.r_lower = lr.r_upper without checking
Floating_point.is_finite lr.r_nearest (unlike Cil.isExactFloat). As a
result, E-ACSL emitted CReal(infinity, FDouble, None), which fails to
compile (error: 'inf' undeclared) and in rational contexts emits
__gmpq_set_d(..., (double)((float)inf)), where GMP mpq_set_d on infinity
raises SIGFPE at run time.

Guard both LReal checks with Floating_point.is_finite lr.r_nearest and
report non-finite floating-point constants via Error.not_yet.

New test: plugins/e-acsl/tests/arith/non_finite_real.c.
---
 plugins/e-acsl/src/analyses/interval.ml       |  6 ++-
 .../src/code_generator/translate_terms.ml     |  7 +++-
 plugins/e-acsl/tests/arith/non_finite_real.c  | 16 ++++++++
 .../arith/oracle/gen_non_finite_real.0.c      | 38 +++++++++++++++++++
 .../arith/oracle/non_finite_real.0.res.oracle | 17 +++++++++
 5 files changed, 81 insertions(+), 3 deletions(-)
 create mode 100644 plugins/e-acsl/tests/arith/non_finite_real.c
 create mode 100644 plugins/e-acsl/tests/arith/oracle/gen_non_finite_real.0.c
 create mode 100644 plugins/e-acsl/tests/arith/oracle/non_finite_real.0.res.oracle

diff --git a/plugins/e-acsl/src/analyses/interval.ml b/plugins/e-acsl/src/analyses/interval.ml
index d325b1c864..01311ecde3 100644
--- a/plugins/e-acsl/src/analyses/interval.ml
+++ b/plugins/e-acsl/src/analyses/interval.ml
@@ -528,7 +528,11 @@ let rec infer ~force ~logic_env t =
       in
       get_res (recurse ~logic_env t)
     | TConst (LReal lr) ->
-      if lr.r_lower = lr.r_upper then Float(FDouble, Some lr.r_nearest)
+      if lr.r_lower = lr.r_upper then
+        if Floating_point.is_finite lr.r_nearest then
+          Float(FDouble, Some lr.r_nearest)
+        else
+          Error.not_yet "non-finite floating-point constant"
       else Rational
     | Tlambda ([ _ ],lt) ->
       get_res (recurse lt)
diff --git a/plugins/e-acsl/src/code_generator/translate_terms.ml b/plugins/e-acsl/src/code_generator/translate_terms.ml
index 73a5f52039..0909b83796 100644
--- a/plugins/e-acsl/src/code_generator/translate_terms.ml
+++ b/plugins/e-acsl/src/code_generator/translate_terms.ml
@@ -126,8 +126,11 @@ let constant_to_exp_old ~loc env t c =
   | LStr _ | LWStr _ -> Options.not_yet_implemented "ACSL String literals"
   | LChr c -> Cil.new_exp ~loc (Const (CChr c)), Analyses_types.C_number
   | LReal lr ->
-    if lr.r_lower = lr.r_upper
-    then Cil.kfloat ~loc FDouble lr.r_nearest, Analyses_types.C_number
+    if lr.r_lower = lr.r_upper then
+      if Floating_point.is_finite lr.r_nearest then
+        Cil.kfloat ~loc FDouble lr.r_nearest, Analyses_types.C_number
+      else
+        Error.not_yet "non-finite floating-point constant"
     else mk_real lr.r_literal
   | LEnum e -> Cil.new_exp ~loc (Const (CEnum e)), Analyses_types.C_number
 
diff --git a/plugins/e-acsl/tests/arith/non_finite_real.c b/plugins/e-acsl/tests/arith/non_finite_real.c
new file mode 100644
index 0000000000..9df80e57ff
--- /dev/null
+++ b/plugins/e-acsl/tests/arith/non_finite_real.c
@@ -0,0 +1,16 @@
+/* run.config
+   COMMENT: non-finite suffixed floating-point constants (e.g. 1e40f, 1e400d)
+   COMMENT: are rejected as not yet supported rather than printed as 'inf'
+   COMMENT: or passed to __gmpq_set_d.
+*/
+
+int main(void) {
+  double x = 0.5;
+  /*@ assert x < 1e40f; */
+  /*@ assert x < 1e400d; */
+  /*@ assert x < 0x1p2000d; */
+  /*@ assert 0.1 < 1e40f; */
+  /*@ assert (float)1e40f > 0; */
+  /*@ assert x == 0.5; */
+  return 0;
+}
