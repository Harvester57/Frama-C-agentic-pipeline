new file mode 100644
index 0000000000..69a3415002
--- /dev/null
+++ b/plugins/e-acsl/tests/full-mtracking/const_globals.c
@@ -0,0 +1,41 @@
+/* run.config
+   COMMENT: const globals are marked read-only through their address
+*/
+
+/* run.config_dev
+   MACRO: ROOT_EACSL_GCC_OPTS_EXT --full-mtracking --rt-debug
+*/
+
+union u {
+  unsigned char b[4];
+  unsigned int w;
+};
+
+struct pair {
+  int a;
+  int b;
+};
+
+struct bf {
+  unsigned a : 3;
+  unsigned b : 5;
+};
+
+const unsigned long scalar = 23;
+const union u un = {{1}};
+static const union u zero_union;
+static const struct pair cp = {1, 2};
+const struct bf bits = {1, 2};
+int x;
+int *const ptr = &x;
+
+int main(void) {
+  /*@ assert \valid_read(&scalar) && !\valid(&scalar); */
+  /*@ assert \valid_read(&un) && !\valid(&un); */
+  /*@ assert \valid_read(&zero_union) && !\valid(&zero_union); */
+  /*@ assert \valid_read(&cp) && !\valid(&cp); */
+  /*@ assert \valid_read(&bits) && !\valid(&bits); */
+  /*@ assert \valid(ptr) && \valid_read(&ptr) && !\valid(&ptr); */
+  *ptr = 1;
+  return scalar + un.b[0] + zero_union.b[0] + cp.a + cp.b + bits.a + x != 29;
+}
