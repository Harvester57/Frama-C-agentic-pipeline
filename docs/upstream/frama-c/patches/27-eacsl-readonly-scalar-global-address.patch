 .../oracle/gen_sequential_threads.0.c         |   2 +-
 .../tests/full-mtracking/const_globals.c      |  41 ++
 .../oracle/const_globals.0.res.oracle         |   4 +
 .../oracle/gen_const_globals.0.c              | 360 ++++++++++++++++++
