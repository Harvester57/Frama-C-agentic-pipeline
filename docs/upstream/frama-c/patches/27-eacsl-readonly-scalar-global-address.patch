From 15a114119fdb499e2913c2e73bf9604a01773b42 Mon Sep 17 00:00:00 2001
From: Florian Stosse <florian.stosse@gmail.com>
Date: Sun, 15 Nov 2026 18:09:12 +0100
Subject: [PATCH] [e-acsl] mark const globals read-only through their address

__e_acsl_mark_readonly expects the address of the block to mark. For every
const global that is neither an array nor a struct, Global_observer passed
the value of the global instead:

- for a scalar (`const uint64_t k = 23;`), the runtime takes 23 as an
  address and aborts with "Use of invalid address 0x17 in predicate";
- for a union, the generated cast from the union to void * is rejected
  ("implicit cast: cast from union u to void *");
- for a pointer, the block it points to is marked instead of the pointer.

Pass the address of the global for those types, and keep the array, which
decays to its address. A struct with a bitfield member also aborted, in
Cil.mkAddrOf on that member ("Taking the address of a bitfield"): mark such
a struct through its own address too.

Regression test: tests/full-mtracking/const_globals.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/code_generator/global_observer.ml     |  12 +-
 .../tests/full-mtracking/const_globals.c      |  30 ++
 .../oracle/const_globals.0.res.oracle         |   4 +
 .../oracle/gen_const_globals.0.c              | 293 ++++++++++++++++++
 4 files changed, 337 insertions(+), 2 deletions(-)
 create mode 100644 plugins/e-acsl/tests/full-mtracking/const_globals.c
 create mode 100644 plugins/e-acsl/tests/full-mtracking/oracle/const_globals.0.res.oracle
 create mode 100644 plugins/e-acsl/tests/full-mtracking/oracle/gen_const_globals.0.c

diff --git a/plugins/e-acsl/src/code_generator/global_observer.ml b/plugins/e-acsl/src/code_generator/global_observer.ml
index 6ecf11fe8d..a1d38d4b1c 100644
--- a/plugins/e-acsl/src/code_generator/global_observer.ml
+++ b/plugins/e-acsl/src/code_generator/global_observer.ml
@@ -120,14 +120,22 @@ let mk_init_function () =
            let loc = vi.vdecl in
            let rec mark_readonly ty = match ty.tnode with
              | TNamed {ttype} -> mark_readonly ttype
-             | TComp {cstruct = true; cfields = Some fields} ->
+             | TComp {cstruct = true; cfields = Some fields}
+               when List.for_all (fun f -> f.fbitfield = None) fields ->
                List.map
                  (fun field ->
                     let lval = Var vi, Field (field, NoOffset) in
                     Smart_stmt.mark_readonly ~loc @@ Cil.mkAddrOf ~loc lval)
 
                  fields
-             | _ -> [Smart_stmt.mark_readonly ~loc @@ Cil.evar ~loc vi]
+             | TArray _ ->
+               (* the array decays to its address *)
+               [Smart_stmt.mark_readonly ~loc @@ Cil.evar ~loc vi]
+             | _ ->
+               (* scalars, pointers, unions and structures with a bitfield
+                  (which has no address): the runtime expects the address of
+                  the global, not its value *)
+               [Smart_stmt.mark_readonly ~loc @@ Cil.mkAddrOfVi vi]
            in
            let stmts =
              if Ast_types.C.is_const vi.vtype then
