From f64aad8cfd6a06e42ceca034b8743b47fecde2f2 Mon Sep 17 00:00:00 2001
From: Florian Stosse <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Wed, 18 Nov 2026 07:07:39 +0000
Subject: [PATCH] [libc] add the TIOCM_* modem line bits to sys/ioctl.h

sys/ioctl.h defines the requests TIOCMGET, TIOCMBIS, TIOCMBIC, TIOCMSET
and TIOCMIWAIT, but none of the bits they read and write. Serial-port
code that sets RTS or DTR, or tests CTS or the carrier, stops at
"Cannot resolve variable TIOCM_RTS".

Add the eleven names that glibc's <sys/ioctl.h> defines (in
bits/ioctl-types.h), with the same values: TIOCM_LE, TIOCM_DTR,
TIOCM_RTS, TIOCM_ST, TIOCM_SR, TIOCM_CTS, TIOCM_CAR, TIOCM_RNG and
TIOCM_DSR, and the aliases TIOCM_CD and TIOCM_RI.

New test: tests/libc/sys_ioctl_h.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 share/libc/sys/ioctl.h                     | 14 +++++++
 tests/libc/oracle/sys_ioctl_h.0.res.oracle | 46 ++++++++++++++++++++++
 tests/libc/sys_ioctl_h.c                   | 27 +++++++++++++
 3 files changed, 87 insertions(+)
 create mode 100644 tests/libc/oracle/sys_ioctl_h.0.res.oracle
 create mode 100644 tests/libc/sys_ioctl_h.c

diff --git a/share/libc/sys/ioctl.h b/share/libc/sys/ioctl.h
index 5b72f77779..7187883440 100644
--- a/share/libc/sys/ioctl.h
+++ b/share/libc/sys/ioctl.h
@@ -196,6 +196,20 @@ struct winsize
 
 #define TIOCSER_TEMT 0x01
 
+// Modem lines, read and written by TIOCMGET, TIOCMBIS, TIOCMBIC and TIOCMSET
+// (definitions from ioctl-types.h)
+#define TIOCM_LE 0x001
+#define TIOCM_DTR 0x002
+#define TIOCM_RTS 0x004
+#define TIOCM_ST 0x008
+#define TIOCM_SR 0x010
+#define TIOCM_CTS 0x020
+#define TIOCM_CAR 0x040
+#define TIOCM_RNG 0x080
+#define TIOCM_DSR 0x100
+#define TIOCM_CD TIOCM_CAR
+#define TIOCM_RI TIOCM_RNG
+
 __END_DECLS
 __POP_FC_STDLIB
 
