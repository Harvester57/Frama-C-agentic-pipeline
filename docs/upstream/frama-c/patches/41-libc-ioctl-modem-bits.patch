diff --git a/tests/libc/sys_ioctl_h.c b/tests/libc/sys_ioctl_h.c
new file mode 100644
index 0000000000..921eeacde1
--- /dev/null
+++ b/tests/libc/sys_ioctl_h.c
@@ -0,0 +1,27 @@
+#include <fcntl.h>
+#include <sys/ioctl.h>
+
+// The modem lines of a serial port: TIOCMGET, TIOCMBIS, TIOCMBIC and TIOCMSET
+// read and write the TIOCM_* bits.
+int main() {
+  int fd = open("/dev/ttyS0", O_RDWR | O_NOCTTY);
+  if (fd == -1)
+    return 1;
+  int lines = 0;
+  if (ioctl(fd, TIOCMGET, &lines) == -1)
+    return 1;
+  int carrier = (lines & TIOCM_CD) != 0;
+  int ring = (lines & TIOCM_RI) != 0;
+  int ready = (lines & (TIOCM_DSR | TIOCM_CTS)) == (TIOCM_DSR | TIOCM_CTS);
+  lines |= TIOCM_DTR | TIOCM_RTS;
+  if (ioctl(fd, TIOCMSET, &lines) == -1)
+    return 1;
+  int rts = TIOCM_RTS;
+  ioctl(fd, TIOCMBIC, &rts);
+  ioctl(fd, TIOCMBIS, &rts);
+  int all = TIOCM_LE | TIOCM_DTR | TIOCM_RTS | TIOCM_ST | TIOCM_SR | TIOCM_CTS |
+            TIOCM_CAR | TIOCM_RNG | TIOCM_DSR;
+  //@ assert all_lines: all == 0x1ff;
+  //@ assert aliases: TIOCM_CD == TIOCM_CAR && TIOCM_RI == TIOCM_RNG;
+  return carrier + ring + ready;
+}
