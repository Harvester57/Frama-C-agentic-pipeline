diff --git a/tests/meta/fold_location.c b/tests/meta/fold_location.c
new file mode 100644
index 0000000..5e6072c
--- /dev/null
+++ b/tests/meta/fold_location.c
@@ -0,0 +1,64 @@
+/* run.config*
+   PLUGIN: @PTEST_PLUGIN@ report
+   OPT: @META@ -meta-quantify-range -then-last -report
+*/
+
+/* Check that folded instances (-meta-fold / \flags(fold:yes)) and wrapped
+   callee instances (behavior assumes, -meta-quantify-range) keep the source
+   location of their meta-property instead of "generated by Frama-C kernel". */
+
+int secret;
+int cond;
+
+void direct_write(int *p) {
+  *p = 1;
+}
+
+/*@
+  behavior active:
+    assumes cond > 0;
+    assigns *dst \from *src;
+*/
+void copy_if(int *dst, const int *src);
+
+void call_assumes(int *dst, const int *src) {
+  copy_if(dst, src);
+}
+
+/*@ assigns dst[0 .. n-1] \from src[0 .. n-1]; */
+void copy_range(int *dst, const int *src, int n);
+
+void call_range(int *dst, const int *src, int n) {
+  copy_range(dst, src, n);
+}
+
+/*@ meta \prop, \name(direct_default),
+      \targets(direct_write), \context(\writing),
+      \separated(\written, &secret);
+*/
+
+/*@ meta \prop, \name(direct_folded),
+      \targets(direct_write), \context(\writing),
+      \flags(fold:yes),
+      \separated(\written, &secret);
+*/
+
+/*@ meta \prop, \name(write_assumes),
+      \targets(call_assumes), \context(\writing),
+      \separated(\written, &secret);
+*/
+
+/*@ meta \prop, \name(read_assumes),
+      \targets(call_assumes), \context(\reading),
+      \separated(\read, &secret);
+*/
+
+/*@ meta \prop, \name(write_range),
+      \targets(call_range), \context(\writing),
+      \separated(\written, &secret);
+*/
+
+/*@ meta \prop, \name(read_range),
+      \targets(call_range), \context(\reading),
+      \separated(\read, &secret);
+*/
