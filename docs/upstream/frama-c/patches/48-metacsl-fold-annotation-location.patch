From 6049f09175fb8826c01fbbcde11e2c52bb039378 Mon Sep 17 00:00:00 2001
From: Florian Stosse <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Fri, 20 Nov 2026 10:00:00 +0000
Subject: [PATCH] [fold] give folded instances the location of their property

With -meta-fold, an instance is a call to the generated predicate,
built by create_call with Logic_const.papp and no location, so it gets
the kernel's generated location. The assertion then shows up as
"generated by Frama-C kernel" in WP goals and in the report, and
E-ACSL reports its failure at "<unknown>:0", while the same property
unfolded keeps the location of the meta property. The oracle of
meta-wp/typing.c in the fold config recorded this.

The call now takes the location of the instance it stands for.

The wrappers added around an instance had the same defect, folded or
not: the implication from the assumes of a callee's behavior (post) and
the \forall from -meta-quantify-range (post_fold), in the writing and
reading contexts, were built with the default location. They now keep
the location of the predicate they wrap.

Only locations change. The tests of meta, meta-wp and meta-deduce give
the same results before and after in both configs, except this oracle
(the deduction checks of meta-deduce did not run: SWI-Prolog was not
installed).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 meta_annotate.ml                              | 20 ++++++++++++-------
 tests/meta-wp/oracle_fold/typing.0.res.oracle |  2 +-
 2 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/meta_annotate.ml b/meta_annotate.ml
index 03447cf..45c59ef 100644
--- a/meta_annotate.ml
+++ b/meta_annotate.ml
@@ -115,7 +115,7 @@ type instance_kind = Trivial | Folded of logic_info
 
 let dummy_type () = Ast_types.Acsl.make_set (Ctype Cil_const.voidType)
 
-let create_call li instance_types =
+let create_call ~loc li instance_types =
   let replace_one lab =
     match lab with
       | FormalLabel ("Before" | "After" | "ForceAfter") -> lab
@@ -128,7 +128,7 @@ let create_call li instance_types =
       ~none:(Logic_const.term Tempty_set (dummy_type())) ~some:(fun (_,_,t) -> t)
   in
   let args = List.map make_arg instance_types in
-  Logic_const.papp (li,labels,args)
+  Logic_const.papp ~loc (li,labels,args)
 
 let create_formals instance_types assoc_list =
   let nb_unused = ref 0 in
@@ -316,7 +316,11 @@ class context_visitor flags all_mp table = object(self)
         | Folded li ->
           let inst = create_predicate_body post kf stmt assoc_list ump in
           if Logic_utils.is_trivially_true inst then Logic_const.ptrue
-          else apply_opt post_fold (create_call li instance_types)
+          else
+            (* The call stands for this instance: give it the instance's
+               location, as an unfolded instance has. *)
+            let loc = inst.pred_loc in
+            apply_opt post_fold (create_call ~loc li instance_types)
         | Trivial -> Logic_const.ptrue
     end else begin
       let pred = ump.ump_property kf ~stmt assoc_list in
@@ -657,14 +661,15 @@ class writing_visitor flags all_mp table = object(self)
             | TLval t ->
               let post prop =
                 List.fold_left
-                  (fun prop prec -> Logic_const.pimplies (prec, prop))
+                  (fun prop prec ->
+                     Logic_const.pimplies ~loc:prop.pred_loc (prec, prop))
                   prop preconds
               in
               let post_fold prop =
                 List.fold_left
                   (fun prop (v, l, u) ->
                      Logic_const.(
-                       pforall
+                       pforall ~loc:prop.pred_loc
                          ([v],
                           pimplies
                             (pand (prel (Rle,l,tvar v), prel(Rle, tvar v, u)),
@@ -794,14 +799,15 @@ class reading_visitor flags all_mp table = object (self)
               | TLval t ->
                 let post property =
                   List.fold_left
-                    (fun prop prec -> Logic_const.pimplies (prec, prop))
+                    (fun prop prec ->
+                       Logic_const.pimplies ~loc:prop.pred_loc (prec, prop))
                     property preconds
                 in
                 let post_fold prop =
                   List.fold_left
                     (fun prop (v,l,u) ->
                        Logic_const.(
-                         pforall
+                         pforall ~loc:prop.pred_loc
                            ([v],
                             pimplies
                               (pand (prel (Rle,l,tvar v),prel (Rle,tvar v,u)),
diff --git a/tests/meta-wp/oracle_fold/typing.0.res.oracle b/tests/meta-wp/oracle_fold/typing.0.res.oracle
index 5281b90..b17e019 100644
--- a/tests/meta-wp/oracle_fold/typing.0.res.oracle
+++ b/tests/meta-wp/oracle_fold/typing.0.res.oracle
@@ -30,7 +30,7 @@ Prover CFG returns Valid
 
 ------------------------------------------------------------
 
-Goal Assertion 'test,meta' (generated by Frama-C kernel):
+Goal Assertion 'test,meta' ("typing.c", line 22):
 Assume {
   (* Heap *)
   Type: (region(s_1.base) <= 0) /\ (region(t.base) <= 0) /\
