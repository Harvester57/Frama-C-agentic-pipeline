+   unsigned long long _Alignas(16) u64[2] ;
+   unsigned char b[16] ;
+};
+struct s {
+   char c ;
+   char _Alignas(8) d ;
+   int _Alignas(16) *p ;
+   int _Alignas(8) *a[2] ;
+   int _Alignas(16) (*fp)(int ) ;
+   unsigned int _Alignas(4) x  __attribute__((__unused__));
+};
+int _Alignas(16) *gp;
+int _Alignas(16) (*gfp)(int );
+int _Alignas(16) ga[2][3];
+char const _Alignas(16) * const gcp = (char const *)0;
+char _Alignas(8) *gap[2];
+int main(void)
+{
+  int __retres;
+  int _Alignas(16) *lp = (int *)0;
+  char _Alignas(16) la[4] = {(char)0};
+  union blk u = {.b = {(unsigned char)0}};
+  struct s v =
+    {.c = (char)0,
+     .d = (char)0,
+     .p = (int *)0,
+     .a = {(int *)0, (int *)0},
+     .fp = (int (*)(int ))0,
+     .x = 0U};
+  __retres = ((((((((int)u.u64[0] + (int)v.c) + (lp == (int *)0)) + (int)la[0]) + (
+                 gp == (int *)0)) + (gfp == (int (*)(int ))0)) + ga[0][0]) + (
+              gcp == (char const *)0)) + (gap[0] == (char *)0);
+  return __retres;
+}
