@@ -0,0 +1,25 @@
+/* run.config
+   COMMENT: string literals are registered as named arrays, not as literals:
+   COMMENT: a literal may otherwise be stored inside another one (here "," at
+   COMMENT: the end of " ,", as clang and GNU ld do), and their blocks overlap
+*/
+
+int main(void) {
+  const char *comma = ",";
+  const char *again = ",";
+  const char *s = " ,";
+  char buf[] = "ab";
+  int in_loop = 0, found = 0;
+  for (int i = 0; i < 2; i++) {
+    const char *t = "loop";
+    /*@ assert \valid_read(t + 4) && !\valid(t); */
+    in_loop = t[i] == 'o';
+  }
+  for (int j = 0; j < 2; j++) {
+    /*@ assert \valid_read(s + j) && !\valid(s + j); */
+    found = s[j] == ',';
+  }
+  /*@ assert \valid_read(comma) && \valid_read(again); */
+  /*@ assert \valid(&buf[2]); */
+  return !(in_loop && found && comma[0] == again[0] && buf[1] == 'b');
+}
