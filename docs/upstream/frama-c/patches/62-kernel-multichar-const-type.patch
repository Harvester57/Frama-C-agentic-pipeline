+++ b/tests/syntax/oracle/define_string_logic_pp_bts2101.0.res.oracle
@@ -9,7 +9,7 @@ int main(void)
   char const d[5U] = "toto";
   char const e = (char)117;
   /*@ assert p((char [])"to/*to") ∧ p((char [])"toto"); */ ;
-  /*@ assert (char)7815260946135808373 ≡ 'u'; */ ;
+  /*@ assert (char)1768454517 ≡ 'u'; */ ;
   __retres = (int)c[sizeof(c) - (unsigned int)1];
   return __retres;
 }
