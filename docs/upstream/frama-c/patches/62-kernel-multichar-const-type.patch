From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 23 Nov 2026 00:11:53 +0000
Subject: [PATCH] [kernel] type multi-character constants as int in
 Cil.interpret_character_constant

---
 src/kernel/services/ast_queries/cil.ml        | 16 +++----
 tests/syntax/multichar_const_type.c           | 20 +++++++++
 ...efine_string_logic_pp_bts2101.0.res.oracle |  2 +-
 .../oracle/multichar_const_type.0.res.oracle  | 43 +++++++++++++++++++
 4 files changed, 71 insertions(+), 10 deletions(-)
 create mode 100644 tests/syntax/multichar_const_type.c
 create mode 100644 tests/syntax/oracle/multichar_const_type.0.res.oracle

diff --git a/src/kernel/services/ast_queries/cil.ml b/src/kernel/services/ast_queries/cil.ml
index c9d63222f2..25ce392e03 100644
--- a/src/kernel/services/ast_queries/cil.ml
+++ b/src/kernel/services/ast_queries/cil.ml
@@ -4149,16 +4149,14 @@ let reduce_multichar typ : int64 list -> int64 =
 
 let interpret_character_constant char_list =
   let value = reduce_multichar Cil_const.charType char_list in
-  if value < (Int64.of_int 256) then
+  match char_list with
+  | [ _ ] when value >= Int64.zero && value < 256L ->
     (* ISO C 6.4.4.4.10: single-character constants have type int *)
-    (CChr(Char.chr (Int64.to_int value))), Cil_const.intType
-  else begin
-    let orig_rep = None (* Some("'" ^ (String.escaped str) ^ "'") *) in
-    if value <= (Int64.of_int32 Int32.max_int) then
-      (CInt64(Z.of_int64 value,IULong,orig_rep)), Cil_const.ulongType
-    else
-      (CInt64(Z.of_int64 value,IULongLong,orig_rep)), Cil_const.ulongLongType
-  end
+    CChr (Char.chr (Int64.to_int value)), Cil_const.intType
+  | _ ->
+    (* ISO C 6.4.4.4.10: multi-character constants also have type int *)
+    let v, _ = truncateInteger64 IInt (Z.of_int64 value) in
+    CInt64 (v, IInt, None), Cil_const.intType
 
 let invalidStmt = mkStmt (Instr (Skip Kernel.gen_loc))
 
diff --git a/tests/syntax/multichar_const_type.c b/tests/syntax/multichar_const_type.c
new file mode 100644
index 0000000000..8d9cf5986b
--- /dev/null
+++ b/tests/syntax/multichar_const_type.c
@@ -0,0 +1,20 @@
+/* run.config
+PLUGIN: eva
+   STDOPT: +"-print -eva"
+*/
+
+int main(void) {
+  int lt = ('ab' - 30000) < 0;
+  int sz = sizeof('ab');
+  int cmp4 = ('\377\377\377\377' < 0);
+  long long hi4 = '\377\377\377\377';
+  int gen = _Generic('ab', int: 1, unsigned long: 2, default: 0);
+  int c0 = '\0\200';
+  //@ check t1: lt == 1;
+  //@ check t2: sz == sizeof(int);
+  //@ check t3: cmp4 == 1;
+  //@ check t4: hi4 == -1;
+  //@ check t5: gen == 1;
+  //@ check t6: c0 == 128;
+  return 0;
+}
