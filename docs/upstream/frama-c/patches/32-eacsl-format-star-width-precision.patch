--- /dev/null
+++ b/plugins/e-acsl/tests/format/printf_star.c
@@ -0,0 +1,48 @@
+/* run.config
+   COMMENT: Check that a field width or a precision given as '*' takes an int
+   COMMENT: argument before the argument of its directive
+   DEPS: @PTEST_DEPS@ utils/signalled.h
+   STDOPT:
+*/
+/* run.config_dev
+   MACRO: INCLUDED_HEADERS utils/signalled.h
+   COMMENT: This part is blank on purpose (test stability + Dune)
+
+*/
+
+#include "utils/signalled.h"
+#include <stdio.h>
+
+int main(void) {
+  char t[128];
+  const char *s = "abcdef";
+  char u[3] = {'a', 'b', 'c'}; // not NUL-terminated
+  int n;
+  long l = 5;
+
+  // '*' arguments are skipped before the argument of the directive
+  OK(snprintf(t, sizeof t, "RECORD:%.*s", 3, s));
+  OK(snprintf(t, sizeof t, "[%*d]", 5, 42));
+  OK(snprintf(t, sizeof t, "[%-*.*f]", 10, 2, 3.14159));
+  OK(snprintf(t, sizeof t, "[%*s|%s]", 4, s, s));
+  OK(snprintf(t, sizeof t, "[%.*s %d %s]", 2, s, 7, s));
+  OK(snprintf(t, sizeof t, "[%*.*s %p]", 8, 2, s, (void *)&n));
+  OK(snprintf(t, sizeof t, "[%.*s%n]", 2, s, &n));
+  // A '*' precision limits the characters read from a string
+  OK(snprintf(t, sizeof t, "[%.*s]", 3, u));
+  OK(snprintf(t, sizeof t, "[%.*s]", 2, u));
+  // A directive with the '0' flag takes the next argument too
+  OK(snprintf(t, sizeof t, "[%s %05d]", s, 5));
+
+  // A '*' takes an int
+  ABRT(snprintf(t, sizeof t, "[%*d]", l, 42));
+  // The argument of the directive must have the right type
+  ABRT(snprintf(t, sizeof t, "[%*s]", 4, 7));
+  // A precision larger than the string
+  ABRT(snprintf(t, sizeof t, "[%.*s]", 4, u));
+  // A negative '*' precision is taken as omitted
+  ABRT(snprintf(t, sizeof t, "[%.*s]", -1, u));
+  // An invalid string after a '*' is reported on its own directive
+  ABRT(snprintf(t, sizeof t, "[%*d %s]", 3, 1, u));
+  return 0;
+}
