diff --git a/tests/libc/strlcat.c b/tests/libc/strlcat.c
new file mode 100644
index 0000000000..16183e1a04
--- /dev/null
+++ b/tests/libc/strlcat.c
@@ -0,0 +1,43 @@
+#include <string.h>
+
+volatile int nondet;
+
+struct s {
+  char d[4];
+  char next;
+};
+
+// strlcat returns the length of the string it tried to create, counted from
+// the destination before the call, and writes at most n bytes.
+int main() {
+  // room for everything
+  char d[8] = "ab";
+  size_t r = strlcat(d, "cd", sizeof(d));
+  //@ check appended: r == 4;
+
+  // truncation
+  char t[4] = "ab";
+  size_t rt = strlcat(t, "cdef", sizeof(t));
+  //@ check truncated: rt == 6;
+
+  // no NUL within the first n bytes: nothing is written
+  char f[8] = "abcdef";
+  size_t rf = strlcat(f, "x", 3);
+  //@ check no_nul_within_n: rf == 4;
+
+  // n == 0: nothing is written either
+  size_t r0 = strlcat(f, "xy", 0);
+  //@ check zero_size: r0 == 2;
+
+  // the byte after the n bytes of the destination is not written
+  struct s v = {"a", 'Z'};
+  strlcat(v.d, "b", sizeof(v.d));
+  //@ check next_kept: v.next == 'Z';
+
+  // the source is read up to its NUL: a call that writes over it is rejected
+  // (precondition 'separation' invalid)
+  char buf[32] = "0123456789abcdefghij";
+  if (nondet)
+    strlcat(buf + 16, buf, 8);
+  return 0;
+}
