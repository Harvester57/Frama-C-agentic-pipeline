From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:54:28 +0000
Subject: [PATCH] [kernel] handle IBool range and conversion in Cil.fitsInInt
 and truncateInteger64

---
 src/kernel/services/ast_queries/cil.ml        | 72 ++++++++++---------
 tests/spec/bool_cast_literal.c                | 24 +++++++
 .../oracle/bool_cast_literal.0.res.oracle     | 31 ++++++++
 .../oracle/bool_cast_literal.1.res.oracle     | 54 ++++++++++++++
 4 files changed, 149 insertions(+), 32 deletions(-)
 create mode 100644 tests/spec/bool_cast_literal.c
 create mode 100644 tests/spec/oracle/bool_cast_literal.0.res.oracle
 create mode 100644 tests/spec/oracle/bool_cast_literal.1.res.oracle

diff --git a/src/kernel/services/ast_queries/cil.ml b/src/kernel/services/ast_queries/cil.ml
index c9d63222f2..887c13527d 100644
--- a/src/kernel/services/ast_queries/cil.ml
+++ b/src/kernel/services/ast_queries/cil.ml
@@ -2417,21 +2417,26 @@ let debugTruncation = false
 
 (* True if the integer fits within the kind's range *)
 let fitsInInt k i =
-  let signed = isSigned k in
-  let nrBits =
-    let unsignedbits = 8 * (bytesSizeOfInt k) in
-    if signed then
-      unsignedbits-1
-    else
-      unsignedbits
-  in
-  let max_strict_bound =
-    Z.(shift_left one nrBits)
-  in
-  let min_bound = if signed then Z.neg max_strict_bound
-    else Z.zero
+  let fits =
+    match k with
+    | IBool -> Z.(equal zero i || equal one i)
+    | _ ->
+      let signed = isSigned k in
+      let nrBits =
+        let unsignedbits = 8 * (bytesSizeOfInt k) in
+        if signed then
+          unsignedbits-1
+        else
+          unsignedbits
+      in
+      let max_strict_bound =
+        Z.(shift_left one nrBits)
+      in
+      let min_bound = if signed then Z.neg max_strict_bound
+        else Z.zero
+      in
+      Z.leq min_bound i && Z.lt i max_strict_bound
   in
-  let fits = Z.leq min_bound i && Z.lt i max_strict_bound in
   if debugTruncation then
     Kernel.debug "Fits in %a %a : %b@."
       !pp_ikind_ref k Z.pretty i fits;
@@ -2445,24 +2450,27 @@ let truncateInteger64 (k: ikind) i =
     i, false
   else
     let i' =
-      let nrBits = 8 * (bytesSizeOfInt k) in
-      let max_strict_bound = Z.(shift_left one nrBits) in
-      let modulo = Z.erem i max_strict_bound in
-      let signed = isSigned k in
-      if signed then
-        let max_signed_strict_bound =
-          Z.shift_right max_strict_bound 1
-        in
-        if Z.geq modulo max_signed_strict_bound then
-          Z.sub modulo max_strict_bound
-        else if Z.lt modulo (Z.neg max_signed_strict_bound)
-        then Z.add modulo max_strict_bound
-        else modulo
-      else
-      if Z.lt modulo Z.zero then
-        Z.add modulo max_strict_bound
-      else
-        modulo
+      match k with
+      | IBool -> Z.one
+      | _ ->
+        let nrBits = 8 * (bytesSizeOfInt k) in
+        let max_strict_bound = Z.(shift_left one nrBits) in
+        let modulo = Z.erem i max_strict_bound in
+        let signed = isSigned k in
+        if signed then
+          let max_signed_strict_bound =
+            Z.shift_right max_strict_bound 1
+          in
+          if Z.geq modulo max_signed_strict_bound then
+            Z.sub modulo max_strict_bound
+          else if Z.lt modulo (Z.neg max_signed_strict_bound)
+          then Z.add modulo max_strict_bound
+          else modulo
+        else
+        if Z.lt modulo Z.zero then
+          Z.add modulo max_strict_bound
+        else
+          modulo
     in
     if debugTruncation then
       Kernel.debug ~level:3 "Truncate %a to %a: %a"
diff --git a/tests/spec/bool_cast_literal.c b/tests/spec/bool_cast_literal.c
new file mode 100644
index 0000000000..8ae9d53190
--- /dev/null
+++ b/tests/spec/bool_cast_literal.c
@@ -0,0 +1,24 @@
+/* run.config
+   STDOPT:
+   STDOPT: +"-eva"
+*/
+
+/*@ check lemma bool_zero: (_Bool)0 == 0;
+    check lemma bool_one: (_Bool)1 == 1;
+    check lemma bool_two: (_Bool)2 == 1;
+    check lemma bool_two_bad: (_Bool)2 == 2;
+    check lemma bool_255: (_Bool)255 == 1; */
+
+enum { TWO = 2 };
+
+int main(void) {
+  int x = 2;
+  //@ check c1: (_Bool)2 == 1;
+  //@ check c2: (_Bool)2 == 2;
+  //@ check c3: (_Bool)x == 1;
+  //@ check c4: (_Bool)x == (_Bool)2;
+  //@ check c5: (_Bool)TWO == 1;
+  //@ check c6: (_Bool)TWO == 2;
+  //@ check c7: (_Bool)256 == 1;
+  return 0;
+}
