diff --git a/tests/libc/syslog_h.c b/tests/libc/syslog_h.c
new file mode 100644
index 0000000000..e18ffbc573
--- /dev/null
+++ b/tests/libc/syslog_h.c
@@ -0,0 +1,22 @@
+/* run.config
+   STDOPT:
+*/
+#include <syslog.h>
+
+volatile int nondet;
+
+int main(void) {
+  char ok[3] = {'a', 'b', '\0'};
+  syslog(LOG_INFO, "%s %.2s", ok, ok);
+  if (nondet) {
+    char bad[2] = {'a', 'b'};
+    syslog(LOG_ERR, "%s", bad); // invalid: not NUL-terminated
+    //@ assert unreachable: \false;
+  }
+  if (nondet) {
+    char short_buf[2] = {'a', 'b'};
+    syslog(LOG_ERR, "%.5s", short_buf); // invalid: shorter than 5 bytes
+    //@ assert unreachable2: \false;
+  }
+  return 0;
+}
