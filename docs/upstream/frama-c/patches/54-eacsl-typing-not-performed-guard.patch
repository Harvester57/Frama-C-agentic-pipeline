+/* run.config
+   COMMENT: When typing an unsupported subterm or quantifier guard raises
+   COMMENT: Error.Not_yet, sibling subterms (such as \old parameters with
+   COMMENT: RTE guards) and the quantifier goal must still be typed so code
+   COMMENT: generation ignores the annotation instead of aborting with
+   COMMENT: "typing was not performed".
+*/
+#include <string.h>
+
+/*@ logic integer undef_fn(int x); */
+/*@ logic integer reads_fn(char *p) reads *p; */
+
+/*@ ensures \result == reads_fn(a) + reads_fn(b); */
+int sum_reads(char *a, char *b) {
+  return (int)*a + (int)*b;
+}
+
+int main(void) {
+  int x = 0;
+  char a = 1, b = 2;
+  char d[8] = "a";
+  /*@ assert \forall integer i; undef_fn(x) <= i < 3 ==> i >= 0; */
+  sum_reads(&a, &b);
+  stpncpy(d, "ab", 4);
+  strlcat(d, "cd", 8);
+  /*@ assert a == 1; */
+  return 0;
+}
