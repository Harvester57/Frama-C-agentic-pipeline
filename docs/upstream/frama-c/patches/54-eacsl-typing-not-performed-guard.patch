-      ignore
-        (type_term ~use_gmp_opt:true ~arith_operand:false ~ctx ~profile t2);
-      ctx
-
+      with_opt_ctx
+        (fun () ->
+           mk_ctx ~use_gmp_opt:true @@
+           ty_of_interv @@
+           Interval.joins_from_profile ~profile [t2; t1; t])
+        (fun ctx ->
