Subject: [PATCH] [kernel] reject out-of-range escapes in narrow character
 constants

---
 src/kernel/internals/parsing/cparser.mly      |  6 ++++-
 tests/syntax/char_escape_range.c              | 24 +++++++++++++++++++
 .../oracle/char_escape_range.0.err.oracle     |  0
 .../oracle/char_escape_range.0.res.oracle     |  9 +++++++
 .../oracle/char_escape_range.1.err.oracle     |  0
 .../oracle/char_escape_range.1.res.oracle     | 11 +++++++++
 .../oracle/char_escape_range.2.err.oracle     |  0
 .../oracle/char_escape_range.2.res.oracle     | 11 +++++++++
 .../oracle/char_escape_range.3.err.oracle     |  0
 .../oracle/char_escape_range.3.res.oracle     | 11 +++++++++
 10 files changed, 71 insertions(+), 1 deletion(-)
 create mode 100644 tests/syntax/char_escape_range.c
 create mode 100644 tests/syntax/oracle/char_escape_range.0.err.oracle
 create mode 100644 tests/syntax/oracle/char_escape_range.0.res.oracle
 create mode 100644 tests/syntax/oracle/char_escape_range.1.err.oracle
 create mode 100644 tests/syntax/oracle/char_escape_range.1.res.oracle
 create mode 100644 tests/syntax/oracle/char_escape_range.2.err.oracle
 create mode 100644 tests/syntax/oracle/char_escape_range.2.res.oracle
 create mode 100644 tests/syntax/oracle/char_escape_range.3.err.oracle
 create mode 100644 tests/syntax/oracle/char_escape_range.3.res.oracle

diff --git a/src/kernel/internals/parsing/cparser.mly b/src/kernel/internals/parsing/cparser.mly
index e3b13397cd..7670766e16 100644
--- a/src/kernel/internals/parsing/cparser.mly
+++ b/src/kernel/internals/parsing/cparser.mly
@@ -739,7 +739,11 @@ constant:
 | FALSE           {CONST_BOOL (false), $1}
 | CST_INT         {CONST_INT (fst $1), snd $1}
 | CST_FLOAT       {CONST_FLOAT (fst $1), snd $1}
-| CST_CHAR        {CONST_CHAR (fst $1), snd $1}
+| CST_CHAR {
+    let loc = snd $1 in
+    List.iter (fun c -> ignore (int64_to_char ~loc c)) (fst $1);
+    CONST_CHAR (fst $1), loc
+  }
 | CST_WCHAR       {CONST_WCHAR (fst $1), snd $1}
 | string_constant {CONST_STRING (fst $1), snd $1}
 | wstring_list    {CONST_WSTRING (List.concat (fst $1)), snd $1}
diff --git a/tests/syntax/char_escape_range.c b/tests/syntax/char_escape_range.c
new file mode 100644
index 0000000000..b2f4b47b02
--- /dev/null
+++ b/tests/syntax/char_escape_range.c
@@ -0,0 +1,24 @@
+/* run.config
+   EXIT: 0
+   OPT: -print
+
+   EXIT: 1
+   OPT: -cpp-extra-args="-DOOB_OCT"
+   OPT: -cpp-extra-args="-DOOB_HEX"
+   OPT: -cpp-extra-args="-DOOB_MULTI"
+*/
+#include <stddef.h>
+
+#ifdef OOB_OCT
+int bad_oct = '\777';
+#elif defined(OOB_HEX)
+int bad_hex = '\x1ff';
+#elif defined(OOB_MULTI)
+int bad_multi = 'a\x100';
+#else
+int ok_oct = '\377';
+int ok_hex = '\xff';
+int ok_multi = 'ab';
+wchar_t ok_woct = L'\777';
+wchar_t ok_whex = L'\x1ff';
+#endif
