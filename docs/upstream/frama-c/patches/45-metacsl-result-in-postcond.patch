 # Version dev
 
 - options `-meta-fold` and `-meta-quantify-range` to obtain instances that are better suited to E-ACSL instrumentation
+- allow `\result` in `\postcond` meta-properties (for non-`void` target functions)
 
 # Version 0.11
 
diff --git a/README.md b/README.md
index b93d3d0..3902fd4 100644
--- a/README.md
+++ b/README.md
@@ -137,7 +137,10 @@ hold. It can be one of the following :
 - `\precond` : the property `P` is a precondition of the target function and it
     must hold at each of its callsites.
 - `\postcond` : the property `P` holds at the end of the target function for
-    every initial state satisfying the preconditions of the function.
+    every initial state satisfying the preconditions of the function. In this
+    context, `P` can refer to `\result` when the target function returns a
+    non-`void` value (for `void` targets, `\result` triggers a typing error and
+    can be guarded with `\tguard` or `\fguard`).
 - `\weak_invariant` : the property `P` is guaranteed to be verified at the
   beginning and end of the target function.
 - `\strong_invariant` : the property `P` must hold at every point of the target
diff --git a/meta_parse.ml b/meta_parse.ml
index 7740483..d5d0da7 100644
--- a/meta_parse.ml
+++ b/meta_parse.ml
@@ -177,7 +177,7 @@ let meta_type_term termassoc quantifiers kf loc orig_ctxt meta_ctxt env expr =
 (* Given an association table, combine the previous functions to type
  * a full custom predicate
  *)
-let process_meta_termassoc typing_context loc kf termassoc expr =
+let process_meta_termassoc ?(with_result=false) typing_context loc kf termassoc expr =
   let quantifiers = Str_Hashtbl.create 5 in
   let meta_tc =
     {typing_context with
@@ -188,7 +188,21 @@ let process_meta_termassoc typing_context loc kf termassoc expr =
   let fenv = Logic_typing.append_here_label meta_tc.pre_state in
   let fenv2 = Logic_typing.append_pre_label fenv in
   let fenv3 = Logic_typing.append_old_and_post_labels fenv2 in
-  let pred = meta_tc.type_predicate meta_tc fenv3 expr in
+  (* \result only has a meaning in a \postcond property, which becomes an
+     ensures clause of [kf]. Guard on [is_fun] because [Meta_deduce.dummy_unpack]
+     types properties with [Cil_datatype.Kf.dummy], whose type is [Typ.dummy]
+     rather than a function type. [add_result] leaves the environment unchanged
+     when [kf] returns void. *)
+  let fenv4 =
+    if with_result && Ast_types.C.is_fun (Kernel_function.get_type kf) then
+      let rt = Kernel_function.get_return_type kf in
+      let rt =
+        if Kernel_function.is_ghost kf then Ast_types.C.add_ghost rt else rt
+      in
+      Logic_typing.add_result fenv3 (Ctype rt)
+    else fenv3
+  in
+  let pred = meta_tc.type_predicate meta_tc fenv4 expr in
   Meta_bindings.after_parse meta_tc pred quantifiers
 
 (* Check that a given lexpr refer to a C function and return its varinfo *)
@@ -251,7 +265,7 @@ let typing_error hloc mp_name kf_name metavars (loc, error_msg) =
     error_msg
     metav_msg
 
-let delay_prop tc name lexpr kf aslist =
+let delay_prop ?(with_result=false) tc name lexpr kf aslist =
   let dfind_var ?label:_ var =
     (* Tweak find_var so it can find things after link *)
     try tc.find_var var
@@ -274,7 +288,7 @@ let delay_prop tc name lexpr kf aslist =
                             find_type = dft} in
   let loc = lexpr.lexpr_loc in
   delayed_tc.on_error
-    (process_meta_termassoc delayed_tc loc kf aslist)
+    (process_meta_termassoc ~with_result delayed_tc loc kf aslist)
     (typing_error loc name (Kernel_function.get_name kf) aslist)
     lexpr
 
@@ -544,7 +558,9 @@ let process_property tc loc = function
     (* Execute macros in property *)
     let expanded = expand_macros tc loc eproperty in
     (* Delegate typing of property *)
-    let mp_property = delay_prop tc mp_name expanded in
+    let mp_property =
+      delay_prop ~with_result:(mp_context = Postcond) tc mp_name expanded
+    in
     let mp_used_meta_vars = extract_meta_vars expanded in
     gathered_props :=
       {mp_name; mp_target; mp_context; mp_proof_method; mp_translation;
diff --git a/tests/meta/oracle/postcond_result.0.res.oracle b/tests/meta/oracle/postcond_result.0.res.oracle
new file mode 100644
index 0000000..a8f24de
--- /dev/null
+++ b/tests/meta/oracle/postcond_result.0.res.oracle
@@ -0,0 +1,91 @@
+[kernel] Parsing postcond_result.c (with preprocessing)
+[meta] Translation is enabled
+[meta] Will process 6 properties
+[meta] Successful translation
+/* Generated by Frama-C */
+typedef int ret_t;
+struct S {
+   int x ;
+   int const y ;
+};
+int auth_ok;
+int const g_cval = 2;
+/*@ ensures
+      unchanged_on_failure: meta: \result ≢ 0 ⇒ auth_ok ≡ \old(auth_ok);
+ */
+int login(int pw)
+{
+  int __retres;
+  if (pw != 42) {
+    __retres = -1;
+    goto return_label;
+  }
+  auth_ok = 1;
+  __retres = 0;
+  return_label: return __retres;
+}
+
+/*@ ensures res_zero_types: meta: \result ≡ 0;
+    ensures res_tguard: meta: \result ≡ 0;
+    ensures res_fguard: meta: \result ≡ 0;
+ */
+int get_const_int(void)
+{
+  int __retres;
+  __retres = 0;
+  return __retres;
+}
+
+/*@ ensures res_zero_types: meta: \result ≡ 0; */
+ret_t get_typedef(void)
+{
+  ret_t __retres;
+  __retres = 0;
+  return __retres;
+}
+
+/*@ ensures
+      res_ptr_const: meta:
+        \result ≢ \null ∧ \valid_read(\result) ∧ *\result ≡ 2;
+ */
+int const *get_ptr(void)
+{
+  int const *__retres;
+  __retres = & g_cval;
+  return __retres;
+}
+
+/*@ ensures res_struct: meta: \result.x ≡ 1 ∧ \result.y ≡ 2; */
+struct S get_struct(void)
+{
+  struct S s = {.x = 1, .y = 2};
+  return s;
+}
+
+/*@ ghost
+  /@ ensures res_zero_types: meta: \result ≡ 0; @/
+  int get_ghost(void)
+  {
+    int __retres;
+    __retres = 0;
+    return __retres;
+  }
+
+*/
+
+/*@ ensures res_tguard: meta: \true;
+    ensures res_fguard: meta: \false; */
+void do_void(void)
+{
+  auth_ok = 0;
+  return;
+}
+
+/*@ \meta::meta "unchanged_on_failure"; */
+/*@ \meta::meta "res_zero_types"; */
+/*@ \meta::meta "res_ptr_const"; */
+/*@ \meta::meta "res_struct"; */
+/*@ \meta::meta "res_tguard"; */
+/*@ \meta::meta "res_fguard";
+*/
+
