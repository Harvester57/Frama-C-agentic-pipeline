diff --git a/tests/meta/postcond_result.c b/tests/meta/postcond_result.c
new file mode 100644
index 0000000..989a5e2
--- /dev/null
+++ b/tests/meta/postcond_result.c
@@ -0,0 +1,108 @@
+/* run.config*
+   OPT: @META@ @PRINT@
+   EXIT: 1
+   OPT: -cpp-extra-args="-DVOID_ERR" @META@ @PRINT@
+   OPT: -cpp-extra-args="-DPRECOND_ERR" @META@ @PRINT@
+   OPT: -cpp-extra-args="-DCOND_INV_ERR" @META@ @PRINT@
+   OPT: -cpp-extra-args="-DWRITING_ERR" @META@ @PRINT@
+*/
+
+/* Check that \result is accepted in \postcond properties for non-void targets
+   (including const-qualified, pointer-to-const, typedef, struct and ghost
+   return types), while staying refused on void targets (unless guarded) and
+   in every non-\postcond context. */
+
+typedef int ret_t;
+struct S {
+  int x;
+  const int y;
+};
+
+int auth_ok;
+const int g_cval = 2;
+
+int login(int pw) {
+  if (pw != 42)
+    return -1;
+  auth_ok = 1;
+  return 0;
+}
+
+const int get_const_int(void) {
+  return 0;
+}
+
+ret_t get_typedef(void) {
+  return 0;
+}
+
+const int *get_ptr(void) {
+  return &g_cval;
+}
+
+struct S get_struct(void) {
+  struct S s = {1, 2};
+  return s;
+}
+
+/*@ ghost
+  int get_ghost(void) {
+    return 0;
+  }
+*/
+
+void do_void(void) {
+  auth_ok = 0;
+}
+
+/*@ meta \prop, \name(unchanged_on_failure), \targets({login}),
+      \context(\postcond),
+      \result != 0 ==> auth_ok == \old(auth_ok);
+
+    meta \prop, \name(res_zero_types),
+      \targets({get_const_int, get_typedef, get_ghost}),
+      \context(\postcond),
+      \result == 0;
+
+    meta \prop, \name(res_ptr_const), \targets({get_ptr}),
+      \context(\postcond),
+      \assert_type((const int *) \result) && \result != \null &&
+      \valid_read(\result) && *\result == 2;
+
+    meta \prop, \name(res_struct), \targets({get_struct}),
+      \context(\postcond),
+      \result.x == 1 && \result.y == 2;
+
+    meta \prop, \name(res_tguard), \targets({do_void, get_const_int}),
+      \context(\postcond),
+      \tguard(\result == 0);
+
+    meta \prop, \name(res_fguard), \targets({do_void, get_const_int}),
+      \context(\postcond),
+      \fguard(\result == 0);
+*/
+
+#ifdef VOID_ERR
+/*@ meta \prop, \name(void_err), \targets({do_void}), \context(\postcond),
+      \result == 0;
+*/
+#endif
+
+#ifdef PRECOND_ERR
+/*@ meta \prop, \name(precond_err), \targets({login}), \context(\precond),
+      \result == 0;
+*/
+#endif
+
+#ifdef COND_INV_ERR
+/*@ meta \prop, \name(cond_inv_err), \targets({login}),
+      \context(\conditional_invariant),
+      \result == 0;
+*/
+#endif
+
+#ifdef WRITING_ERR
+/*@ meta \prop, \name(writing_err), \targets({login}), \context(\writing),
+      \result == 0;
+*/
+#endif
