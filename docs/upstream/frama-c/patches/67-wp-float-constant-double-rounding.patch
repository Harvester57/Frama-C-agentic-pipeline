From a848f293f215c4e87f5ae607e87508e7927965d2 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:53:37 +0000
Subject: [PATCH] [wp] avoid double rounding when converting rational constants
 to float32

Cfloat.qmake rounded rational constants to IEEE 754 binary32 via
`fmake Float32 (Q.to_float q)`, which first rounds to binary64 and then
rounds a second time to binary32. Constants close to a binary32
midpoint or just below the `FLT_MAX` overflow threshold were rounded to
the wrong `float` (proving
`(float)1.0000000596046447753906250000000000000001 == 1.0` and
`(float)1152921573326323713LL == 1152921504606846976.0`, and refuting
`(float)340282356779733661637539395458142568447.0 == FLT_MAX`).

Round rational constants directly to IEEE 754 binary32 (round to
nearest even, handling normals, subnormals, and overflow) in
`Cfloat.qmake` for `Float32`.

New test: wp_acsl/float_double_rounding.i.
---
 plugins/wp/src/Cfloat.ml                      | 44 +++++++++-
 .../wp/tests/wp_acsl/float_double_rounding.i  | 35 ++++++++
 .../oracle/float_double_rounding.0.res.oracle | 86 +++++++++++++++++++
 3 files changed, 164 insertions(+), 1 deletion(-)
 create mode 100644 plugins/wp/tests/wp_acsl/float_double_rounding.i
 create mode 100644 plugins/wp/tests/wp_acsl/oracle/float_double_rounding.0.res.oracle

diff --git a/plugins/wp/src/Cfloat.ml b/plugins/wp/src/Cfloat.ml
index d87f66ff5d..6b5bf589fc 100644
--- a/plugins/wp/src/Cfloat.ml
+++ b/plugins/wp/src/Cfloat.ml
@@ -128,7 +128,49 @@ let fmake ulp value = match ulp with
   | Float32 -> F.e_fun !@fq32 [F.e_float (rfloat value)]
   | Float64 -> F.e_fun !@fq64 [F.e_float value]
 
-let qmake ulp q = fmake ulp (Q.to_float q)
+(* Exact round-to-nearest-even of a rational [q] directly to IEEE 754 binary32,
+   avoiding double rounding through binary64. *)
+let q_to_float32 q =
+  match Q.classify q with
+  | Q.ZERO -> 0.0
+  | Q.INF -> infinity
+  | Q.MINF -> neg_infinity
+  | Q.UNDEF -> nan
+  | Q.NZERO ->
+    let neg = Q.sign q < 0 in
+    let n = Z.abs q.Q.num in
+    let d = q.Q.den in
+    let e = Z.numbits n - Z.numbits d in
+    let below =
+      if e >= 0 then Z.lt n (Z.shift_left d e)
+      else Z.lt (Z.shift_left n (-e)) d
+    in
+    let e = if below then e - 1 else e in
+    if e > 127 then
+      if neg then neg_infinity else infinity
+    else if e < -150 then
+      0.0
+    else
+      let shift = if e >= -126 then e - 23 else -149 in
+      let num, den =
+        if shift >= 0 then n, Z.shift_left d shift
+        else Z.shift_left n (-shift), d
+      in
+      let quo, rem = Z.ediv_rem num den in
+      let cmp = Z.compare (Z.shift_left rem 1) den in
+      let m =
+        if cmp > 0 || (cmp = 0 && Z.is_odd quo) then Z.succ quo else quo
+      in
+      if e = 127 && Z.equal m (Z.shift_left Z.one 24) then
+        if neg then neg_infinity else infinity
+      else
+        let v = ldexp (Z.to_float m) shift in
+        if neg then -. v else v
+
+let qmake ulp q =
+  match ulp with
+  | Float32 -> fmake Float32 (q_to_float32 q)
+  | Float64 -> fmake Float64 (Q.to_float q)
 
 let re_float = Str.regexp ".*[fldFLD]$"
 let re_mantissa = Str.regexp "[-+]?[0-9]*"
