 .../e-acsl/tests/libc/oracle/gen_getenv.0.c   | 110 +++++++++++++++++
 .../e-acsl/tests/libc/oracle/gen_getenv.1.c   | 114 ++++++++++++++++++
 .../tests/libc/oracle/getenv.0.res.oracle     |  18 +++
 .../tests/libc/oracle/getenv.1.res.oracle     |  18 +++
