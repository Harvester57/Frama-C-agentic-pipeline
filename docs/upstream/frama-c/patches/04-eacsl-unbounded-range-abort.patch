From 6732c2ea1960e55b35a7459139e11a0383d570ee Mon Sep 17 00:00:00 2001
From: Florian Stosse <florian.stosse@gmail.com>
Date: Sun, 15 Nov 2026 14:07:45 +0100
Subject: [PATCH] [e-acsl] ignore annotations with unbounded ranges instead of
 aborting

E-ACSL cannot check an unbounded range (p + (0..)) at runtime, but the
four places that meet one (interval inference, typing, memory tracking
and the translation of memory built-ins) reacted with Options.abort.
That stops the whole run: the program is not instrumented at all, and
every other annotation is lost with it.

The abort is also reached for contracts the user did not write: with
e-acsl-gcc -L, E-ACSL instruments the libc contracts of the called
functions. The contracts of strtok_r, getsockopt and wcschr (among
others) use unbounded ranges, so a program that calls one of them
cannot be instrumented at all.

Raise Error.untypable instead, like the other constructs that E-ACSL
cannot translate: the annotation that contains the range is ignored
with a warning, and the rest of the program is instrumented. This also
fixes the "E-ACSl" typo of two of the messages, which are now the
standard "invalid E-ACSL construct" warning.

Add memory/unbounded_range.c as a regression test.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/e-acsl/src/analyses/interval.ml       |  2 +-
 .../e-acsl/src/analyses/memory_tracking.ml    |  2 +-
 plugins/e-acsl/src/analyses/typing.ml         |  2 +-
 .../src/code_generator/memory_translate.ml    |  2 +-
 .../memory/oracle/gen_unbounded_range.0.c     | 97 +++++++++++++++++++
 .../oracle/unbounded_range.0.res.oracle       | 10 ++
 plugins/e-acsl/tests/memory/unbounded_range.c | 19 ++++
 7 files changed, 130 insertions(+), 4 deletions(-)
 create mode 100644 plugins/e-acsl/tests/memory/oracle/gen_unbounded_range.0.c
 create mode 100644 plugins/e-acsl/tests/memory/oracle/unbounded_range.0.res.oracle
 create mode 100644 plugins/e-acsl/tests/memory/unbounded_range.c

diff --git a/plugins/e-acsl/src/analyses/interval.ml b/plugins/e-acsl/src/analyses/interval.ml
index d65eb9ae8a..1a9af96279 100644
--- a/plugins/e-acsl/src/analyses/interval.ml
+++ b/plugins/e-acsl/src/analyses/interval.ml
@@ -517,7 +517,7 @@ let rec infer ~force ~logic_env t =
       let i2 = recurse n2 in
       Error.map2 join i1 i2
     | Trange(None, _) | Trange(_, None) ->
-      Options.abort ~current:true "unbounded ranges are not part of E-ACSl"
+      Error.untypable "unbounded range"
 
     | Tlet (li,t) ->
       let li_t = Terms.of_li li in
diff --git a/plugins/e-acsl/src/analyses/memory_tracking.ml b/plugins/e-acsl/src/analyses/memory_tracking.ml
index f44418b66f..d0b0bc0e40 100644
--- a/plugins/e-acsl/src/analyses/memory_tracking.ml
+++ b/plugins/e-acsl/src/analyses/memory_tracking.ml
@@ -387,7 +387,7 @@ module rec Transfer
       let varinfos = register_term kf varinfos t1 in
       register_term kf varinfos t2
     | Trange(None, _) | Trange(_, None) ->
-      Options.abort "unbounded ranges are not part of E-ACSL"
+      Error.untypable "unbounded range"
 
   and register_body kf varinfos = function
     | LBnone | LBreads _ -> varinfos
diff --git a/plugins/e-acsl/src/analyses/typing.ml b/plugins/e-acsl/src/analyses/typing.ml
index 6263c8243b..c0bfcc5757 100644
--- a/plugins/e-acsl/src/analyses/typing.ml
+++ b/plugins/e-acsl/src/analyses/typing.ml
@@ -663,7 +663,7 @@ let rec type_term
     | Tcomprehension (_,_,_) -> Error.not_yet "tset comprehension"
 
     | Trange(None, _) | Trange(_, None) ->
-      Options.abort ~current:true "unbounded ranges are not part of E-ACSl"
+      Error.untypable "unbounded range"
     | Trange(Some n1, Some n2) ->
       ignore (type_term ~use_gmp_opt ~profile n1);
       ignore (type_term ~use_gmp_opt ~profile n2);
diff --git a/plugins/e-acsl/src/code_generator/memory_translate.ml b/plugins/e-acsl/src/code_generator/memory_translate.ml
index cfad697df9..93f279d402 100644
--- a/plugins/e-acsl/src/code_generator/memory_translate.ml
+++ b/plugins/e-acsl/src/code_generator/memory_translate.ml
@@ -177,7 +177,7 @@ let range_to_ptr_and_size ~adata ~loc kf env ptr r p =
     | Trange(Some n1, Some n2) ->
       n1, n2
     | Trange(None, _) | Trange(_, None) ->
-      Options.abort ~current:true "unbounded ranges are not part of E-ACSL"
+      Error.untypable "unbounded range"
     | _ ->
       assert false
   in
