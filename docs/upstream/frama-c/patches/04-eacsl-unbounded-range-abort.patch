diff --git a/plugins/e-acsl/tests/memory/unbounded_range.c b/plugins/e-acsl/tests/memory/unbounded_range.c
new file mode 100644
index 0000000000..cc0592d77d
--- /dev/null
+++ b/plugins/e-acsl/tests/memory/unbounded_range.c
@@ -0,0 +1,19 @@
+/* run.config
+   COMMENT: an annotation that contains an unbounded range is ignored with a
+   COMMENT: warning, and the rest of the program is still instrumented
+*/
+
+/*@ requires \valid_read(p + (0..));
+    requires n >= 0; */
+int first(const char *p, int n) {
+  return n > 0 ? p[0] : 0;
+}
+
+int main(void) {
+  char b[2] = "a";
+  int x = first(b, 1);
+  /*@ assert \valid(b + (0..)); */
+  /*@ assert \initialized(b + (..1)); */
+  /*@ assert x == 'a'; */
+  return 0;
+}
