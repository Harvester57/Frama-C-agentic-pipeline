+
+extern void __gmpz_add_ui(eacsl_mpz_t rop, const eacsl_mpz_t op1,
+                          unsigned long int op2);
+extern double __gmpz_get_d(const eacsl_mpz_t op);
+extern size_t __gmpz_sizeinbase(const eacsl_mpz_t op, int base);
+extern void __gmpz_tdiv_qr(eacsl_mpz_t q, eacsl_mpz_t r, const eacsl_mpz_t n,
+                           const eacsl_mpz_t d);
+extern int __gmpz_tstbit(const eacsl_mpz_t op, eacsl_mp_bitcnt_t bit_index);
+
+/* Convert a GMP rational q = num / den to an IEEE 754 binary floating-point
+   value with `prec` significand bits and exponent range [emin, emax], using
+   round-to-nearest, ties-to-even. Because prec <= 53, the returned double is
+   already exact in the target format (so casting to float for prec == 24
+   performs no second rounding). */
+static double eacsl_mpq_get_ieee(const eacsl_mpq_t q, int prec, int emin,
+                                 int emax) {
+  int sgn = q->_mp_num._mp_size;
+  if (sgn == 0)
+    return 0.0;
+  int neg = sgn < 0;
+  if (q->_mp_den._mp_size < 0)
+    neg = !neg;
+
+  eacsl_mpz_t a, b;
+  __gmpz_init_set(a, &q->_mp_num);
+  __gmpz_init_set(b, &q->_mp_den);
+  if (a->_mp_size < 0)
+    __gmpz_neg(a, a);
+  if (b->_mp_size < 0)
+    __gmpz_neg(b, b);
+
+  /* sizeinbase(x, 2) gives k >= 1 with 2^(k-1) <= x < 2^k,
+     so 2^(na - nb - 1) < a / b < 2^(na - nb + 1). */
+  size_t na = __gmpz_sizeinbase(a, 2);
+  size_t nb = __gmpz_sizeinbase(b, 2);
+  int esub = emin - (prec - 1);
+
+  if (na > nb && (na - nb - 1) > (size_t)emax) {
+    __gmpz_clear(a);
+    __gmpz_clear(b);
+    return neg ? -INFINITY : INFINITY;
+  }
+  if (nb > na && (nb - na) > (size_t)(2 - esub)) {
+    __gmpz_clear(a);
+    __gmpz_clear(b);
+    return neg ? -0.0 : 0.0;
+  }
+
+  int e = (na >= nb) ? (int)(na - nb) : -(int)(nb - na);
+  eacsl_mpz_t tmp;
+  __gmpz_init(tmp);
+  if (e >= 0) {
+    __gmpz_mul_2exp(tmp, b, (eacsl_mp_bitcnt_t)e);
+    if (__gmpz_cmp(a, tmp) < 0)
+      e--;
+  } else {
+    __gmpz_mul_2exp(tmp, a, (eacsl_mp_bitcnt_t)(-e));
+    if (__gmpz_cmp(tmp, b) < 0)
+      e--;
+  }
+
+  if (e > emax) {
+    __gmpz_clear(tmp);
+    __gmpz_clear(a);
+    __gmpz_clear(b);
+    return neg ? -INFINITY : INFINITY;
+  }
+
+  int shift = (e >= emin) ? (e - (prec - 1)) : esub;
+  eacsl_mpz_t quot, rem;
+  __gmpz_init(quot);
+  __gmpz_init(rem);
+  if (shift >= 0) {
+    __gmpz_mul_2exp(tmp, b, (eacsl_mp_bitcnt_t)shift);
+    __gmpz_tdiv_qr(quot, rem, a, tmp);
+    __gmpz_mul_2exp(rem, rem, 1);
+    int cmp = __gmpz_cmp(rem, tmp);
+    if (cmp > 0 || (cmp == 0 && __gmpz_tstbit(quot, 0)))
+      __gmpz_add_ui(quot, quot, 1UL);
+  } else {
+    __gmpz_mul_2exp(tmp, a, (eacsl_mp_bitcnt_t)(-shift));
+    __gmpz_tdiv_qr(quot, rem, tmp, b);
+    __gmpz_mul_2exp(rem, rem, 1);
+    int cmp = __gmpz_cmp(rem, b);
+    if (cmp > 0 || (cmp == 0 && __gmpz_tstbit(quot, 0)))
+      __gmpz_add_ui(quot, quot, 1UL);
+  }
+
+  double res;
+  if (e >= emin && __gmpz_tstbit(quot, (eacsl_mp_bitcnt_t)prec)) {
+    if (e + 1 > emax)
+      res = INFINITY;
+    else
+      res = ldexp(1.0, e + 1);
+  } else {
+    res = ldexp(__gmpz_get_d(quot), shift);
+  }
+
+  __gmpz_clear(quot);
+  __gmpz_clear(rem);
+  __gmpz_clear(tmp);
+  __gmpz_clear(a);
+  __gmpz_clear(b);
+  return neg ? -res : res;
+}
+
+double eacsl_mpq_get_d(const eacsl_mpq_t q) {
+  return eacsl_mpq_get_ieee(q, 53, -1022, 1023);
+}
+
+float eacsl_mpq_get_f(const eacsl_mpq_t q) {
+  return (float)eacsl_mpq_get_ieee(q, 24, -126, 127);
+}
