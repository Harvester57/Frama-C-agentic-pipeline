diff --git a/plugins/e-acsl/tests/arith/rational_cast.c b/plugins/e-acsl/tests/arith/rational_cast.c
new file mode 100644
index 0000000000..9ddfdea7db
--- /dev/null
+++ b/plugins/e-acsl/tests/arith/rational_cast.c
@@ -0,0 +1,61 @@
+/* run.config
+   COMMENT: Casting a mathematical real/rational to double or float must use
+   COMMENT: IEEE 754 round-to-nearest-even (not GMP mpq_get_d truncation, and
+   COMMENT: without double rounding for float).
+*/
+
+int main(void) {
+  /* Double: 0.1 rounds up to 0x1.999999999999ap-4 (mpq_get_d truncated down). */
+  double d = 0.1;
+  double d_below = 0x1.9999999999999p-4;
+  /*@ assert d == (double)0.1; */
+  /*@ assert d_below != (double)0.1; */
+  /*@ assert (double)0.1 > 0.1; */
+
+  /* Negative rational: -0.1 rounds down (away from zero). */
+  double nd = -0.1;
+  /*@ assert nd == (double)(0 - 0.1); */
+  /*@ assert (double)(0 - 0.1) < 0 - 0.1; */
+
+  /* Exact midpoint ties-to-even for double (around 1.0, ulp = 2^-52):
+     1 + 2^-53 ties to even -> 1.0; 1 + 3*2^-53 ties to even -> 1 + 2^-51. */
+  double one = 1.0;
+  double half_ulp = 0x1p-53;
+  double one_plus_2ulp = 0x1.0000000000002p0;
+  /*@ assert one == (double)(1 + half_ulp); */
+  /*@ assert one_plus_2ulp == (double)(1 + 3 * half_ulp); */
+
+  /* Float: single rounding avoids double rounding at binary32 midpoints.
+     16777217.0000000001 is strictly above the midpoint 16777217.0 between
+     16777216.0f and 16777218.0f, so it must round to 16777218.0f. */
+  float f = 16777218.0f;
+  /*@ assert f == (float)16777217.0000000001; */
+  float f_tenth = 0.1f;
+  /*@ assert f_tenth == (float)0.1; */
+
+  /* Subnormal double & float rounding (use exact subnormal constants divided
+     in rational arithmetic so the test does not depend on hex-rational literal
+     parsing). */
+  double d_sub = 0x1p-1074;
+  /*@ assert d_sub == (double)(3 * d_sub / 4); */
+  /*@ assert 0.0 == (double)(d_sub / 2); */
+  float f_sub = 0x1p-149f;
