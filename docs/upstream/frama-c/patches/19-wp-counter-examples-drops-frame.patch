diff --git a/plugins/wp/tests/wp_ce/probes_frame.i b/plugins/wp/tests/wp_ce/probes_frame.i
new file mode 100644
index 0000000000..d334e8f6f4
--- /dev/null
+++ b/plugins/wp/tests/wp_ce/probes_frame.i
@@ -0,0 +1,41 @@
+/* run.config
+   OPT: -wp-counter-examples
+   OPT:
+*/
+/* run.config_qualif
+   DONTRUN:
+*/
+/* run.config_ce
+   DONTRUN:
+*/
+
+/* A probe must not hide the relation between the memory states of a goal:
+   'keep_ptr' is trivially valid since the pointer memory is never written,
+   with or without probes. */
+
+typedef struct {
+  const void *ptr;
+  unsigned long len;
+  int err;
+} buf;
+
+/*@ requires \valid(p);
+    assigns p->len, p->err;
+    ensures keep_ptr: p->ptr == \old(p->ptr);
+*/
+void reset_ce(buf *p)
+{
+  p->len = 0;
+  p->err = 0;
+}
+
+/*@ requires \valid(p);
+    assigns p->len, p->err;
+    ensures keep_ptr: p->ptr == \old(p->ptr);
+*/
+void reset_probe(buf *p)
+{
+  //@ probe P: p;
+  p->len = 0;
+  p->err = 0;
+}
