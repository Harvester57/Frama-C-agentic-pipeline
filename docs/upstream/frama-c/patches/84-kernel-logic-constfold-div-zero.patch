From edac4e1d2604dba3182a03ff5bf4160c13a6fa69 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:55:46 +0000
Subject: [PATCH] [kernel] fix division-by-zero crash in
 Logic_utils.constFoldBinOpToInt

---
 .../services/ast_queries/logic_utils.ml       |  4 +--
 .../misc/oracle/unroll_div_zero.0.err.oracle  |  0
 .../misc/oracle/unroll_div_zero.0.res.oracle  | 31 +++++++++++++++++++
 .../misc/oracle/unroll_div_zero.1.err.oracle  |  0
 .../misc/oracle/unroll_div_zero.1.res.oracle  | 27 ++++++++++++++++
 tests/misc/unroll_div_zero.i                  | 17 ++++++++++
 6 files changed, 76 insertions(+), 3 deletions(-)
 create mode 100644 tests/misc/oracle/unroll_div_zero.0.err.oracle
 create mode 100644 tests/misc/oracle/unroll_div_zero.0.res.oracle
 create mode 100644 tests/misc/oracle/unroll_div_zero.1.err.oracle
 create mode 100644 tests/misc/oracle/unroll_div_zero.1.res.oracle
 create mode 100644 tests/misc/unroll_div_zero.i

diff --git a/src/kernel/services/ast_queries/logic_utils.ml b/src/kernel/services/ast_queries/logic_utils.ml
index b67ab970f8..9a8d0b7091 100644
--- a/src/kernel/services/ast_queries/logic_utils.ml
+++ b/src/kernel/services/ast_queries/logic_utils.ml
@@ -2382,9 +2382,7 @@ and constFoldBinOpToInt ~machdep bop e1 e2 =
       | MinusA -> Some (Z.sub i1 i2)
       | PlusPI | MinusPI | MinusPP -> None
       | Mult -> Some (Z.mul i1 i2)
-      | Div ->
-        if Z.(equal zero i2) && Z.(is_zero (erem i1 i2)) then None
-        else Some (Z.ediv i1 i2)
+      | Div -> if Z.(equal zero i2) then None else Some (Z.ediv i1 i2)
       | Mod -> if Z.(equal zero i2) then None else Some (Z.erem i1 i2)
       | BAnd -> Some (Z.logand i1 i2)
       | BOr -> Some (Z.logor i1 i2)
