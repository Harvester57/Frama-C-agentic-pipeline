From 6f2eb7fd83c4c6fc26cfbeba8a01a4cbdb055347 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 23 Nov 2026 00:08:32 +0000
Subject: [PATCH] [kernel] respect Machine.char_is_unsigned in
 Cil.charConstToInt

---
 src/kernel/services/ast_queries/cil.ml        |  9 ++--
 tests/syntax/char_const_unsigned.c            | 24 +++++++++++
 .../oracle/char_const_unsigned.0.res.oracle   | 41 +++++++++++++++++++
 .../oracle/char_const_unsigned.1.res.oracle   | 41 +++++++++++++++++++
 4 files changed, 110 insertions(+), 5 deletions(-)
 create mode 100644 tests/syntax/char_const_unsigned.c
 create mode 100644 tests/syntax/oracle/char_const_unsigned.0.res.oracle
 create mode 100644 tests/syntax/oracle/char_const_unsigned.1.res.oracle

diff --git a/src/kernel/services/ast_queries/cil.ml b/src/kernel/services/ast_queries/cil.ml
index c9d63222f2..2a130418b1 100644
--- a/src/kernel/services/ast_queries/cil.ml
+++ b/src/kernel/services/ast_queries/cil.ml
@@ -2540,13 +2540,12 @@ let lzero ?(loc=Kernel.gen_loc) () = lconstant ~loc Z.zero
 let lone  ?(loc=Kernel.gen_loc) () = lconstant ~loc Z.one
 let lmone ?(loc=Kernel.gen_loc) () = lconstant ~loc (Z.minus_one)
 
-(** Given the character c in a (CChr c), sign-extend it to 32 bits.
-    (This is the official way of interpreting character constants, according
-    to ISO C 6.4.4.4.10, which says that character constants are chars cast
-    to ints) *)
+(** Given the character c in a (CChr c), convert it to an int according to
+    ISO C 6.4.4.4.10: zero-extend if [char] is unsigned on the current machdep,
+    and sign-extend otherwise. *)
 let charConstToInt c =
   let c' = Char.code c in
-  if c' < 128
+  if Machine.char_is_unsigned () || c' < 128
   then Z.of_int c'
   else Z.of_int (c' - 256)
 
diff --git a/tests/syntax/char_const_unsigned.c b/tests/syntax/char_const_unsigned.c
new file mode 100644
index 0000000000..43e6cf2532
--- /dev/null
+++ b/tests/syntax/char_const_unsigned.c
@@ -0,0 +1,24 @@
+/* run.config
+PLUGIN: eva
+   STDOPT: +"-machdep ppc_32 -print -eva"
+   STDOPT: +"-machdep x86_64 -eva"
+*/
+
+int main(void) {
+  int h = '\377';
+  char c = 255;
+  char a[] = "\377";
+  int eq = (a[0] == '\377');
+  int sz = sizeof(char[('\377' > 0) ? 2 : 1]);
+  //@ check h_eq_c: h == c;
+  //@ check a0_eq_chr: eq == 1;
+  //@ check chr_val: '\377' == c;
+#ifdef __CHAR_UNSIGNED__
+  //@ check uchar_h: h == 255;
+  //@ check uchar_sz: sz == 2;
+#else
+  //@ check schar_h: h == -1;
+  //@ check schar_sz: sz == 1;
+#endif
+  return 0;
+}
