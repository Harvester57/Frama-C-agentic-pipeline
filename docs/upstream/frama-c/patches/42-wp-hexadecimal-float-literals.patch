diff --git a/plugins/wp/src/Cfloat.ml b/plugins/wp/src/Cfloat.ml
index d87f66ff5d..35c4ad4524 100644
--- a/plugins/wp/src/Cfloat.ml
+++ b/plugins/wp/src/Cfloat.ml
@@ -130,14 +130,35 @@ let fmake ulp value = match ulp with
 
 let qmake ulp q = fmake ulp (Q.to_float q)
 
-let re_float = Str.regexp ".*[fldFLD]$"
 let re_mantissa = Str.regexp "[-+]?[0-9]*"
 let re_decimal = Str.regexp "\\.[0-9]*"
 let re_exponent = Str.regexp "[eE][-+]?[0-9]*"
+let re_hexadecimal = Str.regexp
+    "\\([-+]?\\)0[xX]\\([0-9a-fA-F]*\\)\\.?\\([0-9a-fA-F]*\\)[pP]\\([-+]?[0-9]+\\)$"
+
+(* Exact value of the literal last matched by [re_hexadecimal] *)
+let parse_hexadecimal r =
+  let sign = Str.matched_group 1 r in
+  let integer = Str.matched_group 2 r in
+  let fraction = Str.matched_group 3 r in
+  if integer = "" && fraction = "" then raise Not_found ;
+  let digits = Z.of_string_base 16 (sign ^ integer ^ fraction) in
+  (* each digit of the fractional part weighs four bits *)
+  let exponent =
+    int_of_string (Str.matched_group 4 r) - 4 * String.length fraction in
+  if exponent < 0 then
+    Q.make digits (Z.shift_left Z.one (-exponent))
+  else
+    Q.of_bigint (Z.shift_left digits exponent)
 
 let parse_literal ~model v r =
   try
-    if model = Float && Str.string_match re_float r 0 then Q.of_float v
+    (* from here on, [r] is the literal without its suffix *)
+    let r, suffix = match Floating_point.extract_suffix r with
+      | Some (r, suffix, _) -> r, suffix
+      | None -> raise Not_found in
+    if model = Float && suffix <> "" then Q.of_float v
+    else if Str.string_match re_hexadecimal r 0 then parse_hexadecimal r
     else
       begin
         if not @@ Str.string_match re_mantissa r 0 then
@@ -156,8 +177,7 @@ let parse_literal ~model v r =
             n, String.sub r (q + 1) (n - q - 1)
           else
             q, "0" in
-        if n <> String.length r && not @@ Str.string_match re_float r n then
-          raise Not_found ;
+        if n <> String.length r then raise Not_found ;
         let digits = Z.of_string @@ mantissa ^ decimal in
         let decades = int_of_string exponent - String.length decimal in
         let power n =
diff --git a/plugins/wp/tests/wp_acsl/float_literals.i b/plugins/wp/tests/wp_acsl/float_literals.i
new file mode 100644
index 0000000000..2c84c5ebf1
--- /dev/null
+++ b/plugins/wp/tests/wp_acsl/float_literals.i
@@ -0,0 +1,40 @@
+/* run.config
+   OPT: -wp-prop="-real_only"
+   OPT: -wp-model +real -wp-prop="-float_only"
+PLUGIN: @PTEST_PLUGIN@,eva,scope,inout,reduc
+   OPT: -no-wp -float-print hex -main neg_hex_reduc -eva -eva-verbose 0 -then -reduc -reduc-gen-annot all -then -no-reduc -wp -wp-fct neg_hex_reduc -wp-prop=@ensures -wp-status-all
+*/
+/* run.config_qualif
+   OPT: -wp-prop="-real_only"
+   OPT: -wp-model +real -wp-prop="-float_only"
+PLUGIN: @PTEST_PLUGIN@,eva,scope,inout,reduc
+   OPT: -no-wp -float-print hex -main neg_hex_reduc -eva -eva-verbose 0 -then -reduc -reduc-gen-annot all -then -no-reduc -wp -wp-fct neg_hex_reduc -wp-prop=@ensures -wp-status-all
+*/
+
+/* Every goal is decided by Qed, in both models. */
+
+/*@ lemma hexa: 0x1.8p1 == 3.0 && 0X.8P+1 == 1.0 && 0x1.p-1 == 0.5 ; */
+/*@ lemma hexa_neg: -0x1.8p1 == -3.0 && -0x.8p0 == -0.5 && -0x0p0 == 0.0 ; */
+/*@ lemma hexa_max: 0x1.fffffffffffffp+1023 == 0x1p1024 - 0x1p971 ; */
+/*@ lemma hexa_suffix:
+      0x1.8p1f == 3.0 && 0x1.8p1d == 3.0 && 0x1.8p1L == 3.0
+      && 0x1.8p1f32 == 3.0 && 0x1.8p1F64 == 3.0 ; */
+/*@ lemma hexa_not_zero: 0x1.8p1f != 0.0 ; */
+/*@ lemma decimal_suffix: 1.5f32 == 1.5 && 1.5F64 == 1.5 ; */
+/*@ lemma non_exact_suffix:
+      0.1f32 == 0.1f && 0.1F64 == 0.1d && 0.1f32 != 0.0 ; */
+/*@ check lemma float_only:
+      0.1f32 == 0x1.99999ap-4 && 0.1f32 != 0.1
+      && 0.1F64 == 0x1.999999999999ap-4 && 0.1F64 != 0.1 ; */
+/*@ check lemma real_only: 0.1f32 == 0.1 && 0.1F64 == 0.1 ; */
+
+/*@ requires 0x1p-1 <= x <= 0x1.8p1 ;
+    ensures 0.5 <= x <= 3.0 ; */
+void contract(double x) { return; }
+
+/*@ ensures \result == 3.0 ; */
+float code(void) { return 0x1.8p1f; }
+
+/*@ requires -0x1.8p1023 <= x <= -0x1p0 ;
+    ensures x <= -1.0 ; */
+double neg_hex_reduc(double x) { return x + x; }
