index 0000000000..830cfa27c5
--- /dev/null
+++ b/plugins/e-acsl/tests/special/e-acsl-bittree-std-streams.c
@@ -0,0 +1,20 @@
+/* run.config
+   COMMENT: The standard streams are safe locations in every memory model
+*/
+/* run.config_dev
+   MACRO: ROOT_EACSL_GCC_OPTS_EXT --memory-model bittree
+   EXECNOW: LOG @EACSL_ERR@ @EACSL_EXEC@
+   MACRO: ROOT_EACSL_GCC_OPTS_EXT --memory-model segment
+*/
+
+#include <stdio.h>
+
+int main(int argc, char **argv) {
+  /* \valid(stdout) is resolved at instrumentation time: use copies, which
+     are checked at run time */
+  FILE *out = stdout, *err = stderr, *in = stdin;
+  //@ check out: \valid(out);
+  //@ check err: \valid(err);
+  //@ check in: \valid_read(in);
+  return 0;
+}
