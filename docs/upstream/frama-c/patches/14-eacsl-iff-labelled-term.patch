diff --git a/plugins/e-acsl/src/code_generator/translate_predicates.ml b/plugins/e-acsl/src/code_generator/translate_predicates.ml
index b093ed27c1..d20248a515 100644
--- a/plugins/e-acsl/src/code_generator/translate_predicates.ml
+++ b/plugins/e-acsl/src/code_generator/translate_predicates.ml
@@ -175,17 +175,15 @@ let rec predicate_content_to_exp_old ?(inplace=false) ?name ~loc ~adata ~env ~kf
     Typing.preprocess_predicate ~logic_env rewritten;
     to_exp ~adata ~name:"implies" kf env rewritten
   | Piff(p1, p2) ->
-    let rewritten = (* (p1 <==> p2) <==> (p1 ==> p2 && p2 ==> p1) *)
-      let p1' = Terms.Id.deep_copy_predicate p1 in
-      let p2' = Terms.Id.deep_copy_predicate p2 in
-      Rte_analysis.preprocess_predicate ~kf p1';
-      Rte_analysis.preprocess_predicate ~kf p2';
-      Logic_const.pand ~loc
-        (Logic_const.pimplies ~loc (p1, p2),
-         Logic_const.pimplies ~loc (p2', p1'))
-    in
-    Typing.preprocess_predicate ~logic_env rewritten;
-    to_exp ~adata ~name:"equiv" kf env rewritten
+    (* (p1 <==> p2) <==> (!p1 == !p2). Both operands are always evaluated, so
+       translate each of them once, as the interlang translation does. Do not
+       rewrite the predicate with copies of [p1] and [p2]: the labels
+       pre-analysis does not know the labelled terms of the copies. *)
+    let e1, adata, env = to_exp ~adata kf env p1 in
+    let e2, adata, env = to_exp ~adata kf env p2 in
+    Misc.make_binop ~loc Eq (Smart_exp.lnot ~loc e1) (Smart_exp.lnot ~loc e2),
+    adata,
+    env
   | Pnot p ->
     let e, adata, env = to_exp ~adata kf env p in
     Smart_exp.lnot ~loc e, adata, env
diff --git a/plugins/e-acsl/tests/constructs/iff_labelled_terms.c b/plugins/e-acsl/tests/constructs/iff_labelled_terms.c
new file mode 100644
index 0000000000..57eb416728
--- /dev/null
+++ b/plugins/e-acsl/tests/constructs/iff_labelled_terms.c
@@ -0,0 +1,25 @@
+/* run.config
+   COMMENT: Equivalences whose operands contain labelled terms: \old, \at, and
+   COMMENT: a formal in a postcondition (read as \old by the kernel)
+*/
+
+struct s {
+  int n;
+};
+
+/*@ requires \valid(b);
+    assigns b->n;
+    ensures (\result != 0) <==> (\old(b->n) == 0);
+    ensures (b->n == 5) <==> (b != \null); */
+int f(struct s *b) {
+  int r = b->n == 0;
+  b->n = 5;
+  /*@ assert (r != 0) <==> (\at(b->n, Pre) == 0); */
+  return r;
+}
+
+int main(void) {
+  struct s x = {0};
+  struct s y = {1};
+  return f(&x) + f(&y) - 1;
+}
