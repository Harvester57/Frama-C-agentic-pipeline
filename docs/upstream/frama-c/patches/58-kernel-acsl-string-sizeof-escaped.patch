+/* Generated by Frama-C */
+char out[sizeof("hello\n")];
+/*@ ensures len: \result ≡ sizeof("hello\n");
+    assigns \nothing; */
+unsigned long greeting_size(void)
+{
+  unsigned long __retres;
+  __retres = (unsigned long)sizeof("hello\n");
+  return __retres;
+}
+
+/*@ requires room: \valid(buf + (0 .. sizeof("hello\n") - 1));
+    assigns *(buf + (0 .. sizeof("hello\n") - 1));
+ */
+void greet(char *buf)
+{
+  *(buf + 0) = (char)'h';
+  return;
+}
+
+int main(void)
+{
+  int __retres;
+  /*@ check c1: sizeof("\n") ≡ 2; */ ;
+  /*@ check c2: sizeof("a\000b") ≡ 4; */ ;
+  /*@ check c3: sizeof("A") ≡ 2; */ ;
+  /*@ check c4: sizeof("\\") ≡ 2; */ ;
+  /*@ check c5: sizeof("hello\n") ≡ sizeof(out); */ ;
+  greet(out);
+  __retres = 0;
+  return __retres;
+}
+
+
diff --git a/tests/spec/string_sizeof_escape.c b/tests/spec/string_sizeof_escape.c
new file mode 100644
index 0000000000..76566fa368
--- /dev/null
+++ b/tests/spec/string_sizeof_escape.c
@@ -0,0 +1,29 @@
+/* run.config
+   STDOPT: +"-eva"
+*/
+
+#define GREETING "hello\n"
+
+char out[sizeof(GREETING)];
+
+/*@ assigns \nothing;
+    ensures len: \result == sizeof(GREETING); */
+unsigned long greeting_size(void) {
+  return sizeof(GREETING);
+}
+
+/*@ requires room: \valid(buf + (0 .. sizeof(GREETING) - 1));
+    assigns buf[0 .. sizeof(GREETING) - 1]; */
+void greet(char *buf) {
+  buf[0] = 'h';
+}
+
+int main(void) {
+  //@ check c1: sizeof("\n") == 2;
+  //@ check c2: sizeof("a\0b") == 4;
+  //@ check c3: sizeof("\x41") == 2;
+  //@ check c4: sizeof("\\") == 2;
+  //@ check c5: sizeof(GREETING) == sizeof(out);
+  greet(out);
+  return 0;
+}
