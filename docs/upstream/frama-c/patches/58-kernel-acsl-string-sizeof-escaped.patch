From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:56:27 +0000
Subject: [PATCH] [kernel] type ACSL string literals from their unescaped
 contents

---
 .../services/ast_queries/logic_typing.ml      |  3 +-
 .../oracle/string_sizeof_escape.0.res.oracle  | 60 +++++++++++++++++++
 tests/spec/string_sizeof_escape.c             | 29 +++++++++
 3 files changed, 91 insertions(+), 1 deletion(-)
 create mode 100644 tests/spec/oracle/string_sizeof_escape.0.res.oracle
 create mode 100644 tests/spec/string_sizeof_escape.c

diff --git a/src/kernel/services/ast_queries/logic_typing.ml b/src/kernel/services/ast_queries/logic_typing.ml
index 0c4e2734c9..d134beadda 100644
--- a/src/kernel/services/ast_queries/logic_typing.ml
+++ b/src/kernel/services/ast_queries/logic_typing.ml
@@ -2682,7 +2682,8 @@ struct
       let t = Logic_utils.parse_float ~loc s in
       t.term_node , t.term_type
     | PLconstant (StringConstant s) ->
-      TConst (LStr (unescape s)), typeOf_string_literal loc s
+      let s = unescape s in
+      TConst (LStr s), typeOf_string_literal loc s
     | PLconstant (WStringConstant s) ->
       let l = wcharlist_of_string s in
       TConst (LWStr l), typeOf_wstring_literal loc l
diff --git a/tests/spec/oracle/string_sizeof_escape.0.res.oracle b/tests/spec/oracle/string_sizeof_escape.0.res.oracle
new file mode 100644
index 0000000000..13026124e3
--- /dev/null
+++ b/tests/spec/oracle/string_sizeof_escape.0.res.oracle
@@ -0,0 +1,60 @@
+[kernel] Parsing string_sizeof_escape.c (with preprocessing)
+[eva] Analyzing a complete application starting at main
+[eva:initial-state] Values of globals at initialization
+  out[0..6] ∈ {0}
+[eva] ====== VALUES COMPUTED ======
+[eva:final-states] Values at end of function greet:
+  out[0] ∈ {104}
+     [1..6] ∈ {0}
+[eva:final-states] Values at end of function main:
