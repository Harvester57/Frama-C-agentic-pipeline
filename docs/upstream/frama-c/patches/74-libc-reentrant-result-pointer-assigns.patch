From 949faf06dbcbd865f508d961f7fa7ca45b6e80c3 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:54:50 +0000
Subject: [PATCH] [libc] pwd.h/utmp.h: assign reentrant result pointer from
 caller struct

In share/libc/pwd.h (getpwnam_r, getpwuid_r) and share/libc/utmp.h (getutent_r, getutid_r, getutline_r), the output pointer parameter (*result / *ubufp) was assigned \from &__fc_pwd / &__fc_utmp instead of the caller-supplied struct pointer (pwd / ubuf).

In Eva, intersecting *result (\from &__fc_pwd) with ensures *result == \null || *result == pwd eliminated pwd and left *result == {0}, making the entire success branch dead code. In utmp.h, *ubufp became a garbled mix of &__fc_utmp, raising spurious pointer-comparison/alignment alarms and making res == &ub dead.

Split *pwd and *result assigns in pwd.h (matching grp.h and dirent.h) and assign *ubufp from ubuf with ensures result_null_or_ubuf in utmp.h.

New test: tests/libc/reentrant_result_ptr.c.
---
 share/libc/pwd.h                              |  6 +-
 share/libc/utmp.h                             |  9 +-
 .../oracle/reentrant_result_ptr.0.res.oracle  | 90 +++++++++++++++++++
 tests/libc/reentrant_result_ptr.c             | 31 +++++++
 4 files changed, 131 insertions(+), 5 deletions(-)
 create mode 100644 tests/libc/oracle/reentrant_result_ptr.0.res.oracle
 create mode 100644 tests/libc/reentrant_result_ptr.c

diff --git a/share/libc/pwd.h b/share/libc/pwd.h
index 5ff889c5a7..f537f969d7 100644
--- a/share/libc/pwd.h
+++ b/share/libc/pwd.h
@@ -65,7 +65,8 @@ extern struct passwd *getpwuid(uid_t uid);
   requires valid_result: \valid(result);
   assigns \result \from indirect:&__fc_pwd, indirect:name[0..];
   assigns __fc_pwd \from indirect:name[0..];
-  assigns *pwd, *result \from &__fc_pwd;
+  assigns *pwd \from __fc_pwd, buf, indirect:buflen;
+  assigns *result \from pwd, indirect:__fc_pwd;
   assigns buf[0 .. buflen-1] \from indirect:__fc_pwd;
   ensures result_null_or_assigned:
     *result == \null || *result == pwd;
@@ -82,7 +83,8 @@ extern int getpwnam_r(const char *name, struct passwd *pwd,
   requires valid_result: \valid(result);
   assigns \result \from indirect:&__fc_pwd;
   assigns __fc_pwd \from indirect:uid;
-  assigns *pwd, *result \from &__fc_pwd;
+  assigns *pwd \from __fc_pwd, buf, indirect:buflen;
+  assigns *result \from pwd, indirect:__fc_pwd;
   assigns buf[0 .. buflen-1] \from indirect:__fc_pwd;
   ensures result_null_or_assigned:
     *result == \null || *result == pwd;
diff --git a/share/libc/utmp.h b/share/libc/utmp.h
index b4a8b889ce..d3efbf6ed8 100644
--- a/share/libc/utmp.h
+++ b/share/libc/utmp.h
@@ -121,14 +121,16 @@ extern struct utmp *pututline (const struct utmp *utmp_ptr);
 /*@
   assigns \result \from indirect:__fc_utmp;
   assigns *ubuf \from __fc_utmp;
-  assigns *ubufp \from &__fc_utmp;
+  assigns *ubufp \from ubuf;
+  ensures result_null_or_ubuf: *ubufp == \null || *ubufp == ubuf;
 */
 extern int getutent_r (struct utmp *ubuf, struct utmp **ubufp);
 
 /*@
   assigns \result \from indirect:*ut, indirect:__fc_utmp;
   assigns *ubuf \from indirect:*ut, __fc_utmp;
-  assigns *ubufp \from indirect:*ut, &__fc_utmp;
+  assigns *ubufp \from ubuf, indirect:*ut;
+  ensures result_null_or_ubuf: *ubufp == \null || *ubufp == ubuf;
 */
 extern int getutid_r (const struct utmp *ut, struct utmp *ubuf,
                       struct utmp **ubufp);
@@ -136,7 +138,8 @@ extern int getutid_r (const struct utmp *ut, struct utmp *ubuf,
 /*@
   assigns \result \from indirect:*ut, indirect:__fc_utmp;
   assigns *ubuf \from indirect:*ut, __fc_utmp;
-  assigns *ubufp \from indirect:*ut, &__fc_utmp;
+  assigns *ubufp \from ubuf, indirect:*ut;
+  ensures result_null_or_ubuf: *ubufp == \null || *ubufp == ubuf;
 */
 extern int getutline_r (const struct utmp *ut,
                         struct utmp *ubuf, struct utmp **ubufp);
