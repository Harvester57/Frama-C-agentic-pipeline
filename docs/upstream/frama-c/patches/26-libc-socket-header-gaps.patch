diff --git a/tests/libc/socket_glibc_compat.c b/tests/libc/socket_glibc_compat.c
new file mode 100644
index 0000000000..181f15e12f
--- /dev/null
+++ b/tests/libc/socket_glibc_compat.c
@@ -0,0 +1,29 @@
+// Definitions that glibc provides in its default mode.
+#include <sys/socket.h> // must make fd_set visible, through <sys/types.h>
+#include <netinet/in.h>
+#include <string.h>
+
+int nfds(fd_set *s) {
+  return s != 0;
+}
+
+int main() {
+  // sin_zero pads struct sockaddr_in to the size of struct sockaddr
+  //@ assert sizeof(struct sockaddr_in) == sizeof(struct sockaddr);
+  struct sockaddr_in sin;
+  memset(&sin, 0, sizeof(struct sockaddr));
+  sin.sin_family = AF_INET;
+  sin.sin_port = 0;
+  sin.sin_addr.s_addr = INADDR_ANY;
+  memset(sin.sin_zero, 0, sizeof sin.sin_zero);
+
+  struct ip_mreq mreq;
+  mreq.imr_multiaddr.s_addr = INADDR_ANY;
+  mreq.imr_interface.s_addr = INADDR_ANY;
+  struct ip_mreq_source mreq_src;
+  mreq_src.imr_multiaddr = mreq.imr_multiaddr;
+  mreq_src.imr_interface = mreq.imr_interface;
+  mreq_src.imr_sourceaddr = sin.sin_addr;
+
+  return nfds(0) + (int)mreq_src.imr_sourceaddr.s_addr;
+}
