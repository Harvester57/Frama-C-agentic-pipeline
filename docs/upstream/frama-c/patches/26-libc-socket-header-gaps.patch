diff --git a/share/libc/__fc_inet.h b/share/libc/__fc_inet.h
index dfe70de65c..4bb2ec11d4 100644
--- a/share/libc/__fc_inet.h
+++ b/share/libc/__fc_inet.h
@@ -40,6 +40,8 @@ struct sockaddr_in {
   sa_family_t     sin_family;
   in_port_t       sin_port;
   struct in_addr  sin_addr;
+  // Non-POSIX: padding to the size of struct sockaddr, as in glibc
+  unsigned char   sin_zero[8];
 };
 
 struct in6_addr {
@@ -76,6 +78,19 @@ struct ipv6_mreq {
   unsigned         ipv6mr_interface;
 };
 
+// Non-POSIX: IPv4 multicast requests (IP_ADD_MEMBERSHIP, IP_DROP_MEMBERSHIP
+// and the *_SOURCE_MEMBERSHIP / *_BLOCK_SOURCE options below)
+struct ip_mreq {
+  struct in_addr imr_multiaddr; /* IP multicast address of group */
+  struct in_addr imr_interface; /* local IP address of interface */
+};
+
+struct ip_mreq_source {
+  struct in_addr imr_multiaddr; /* IP multicast address of group */
+  struct in_addr imr_interface; /* IP address of interface */
+  struct in_addr imr_sourceaddr; /* IP address of source */
+};
+
 
 struct in6_pktinfo
   {
