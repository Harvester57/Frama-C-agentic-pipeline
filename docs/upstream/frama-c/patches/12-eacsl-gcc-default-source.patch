--- a/plugins/e-acsl/doc/Changelog
+++ b/plugins/e-acsl/doc/Changelog
@@ -25,6 +25,10 @@
 Plugin E-ACSL <next-release>
 ###############################################################################
 
+-* e-acsl-gcc [2026-11-15] Compile with -D_DEFAULT_SOURCE, as Frama-C
+                           preprocesses, so that POSIX functions such as
+                           strdup are declared
+
 ###############################################################################
 Plugin E-ACSL 34.0 (Selenium)
 ###############################################################################
diff --git a/plugins/e-acsl/scripts/e-acsl-gcc b/plugins/e-acsl/scripts/e-acsl-gcc
index 81e8f8ae7a..4e51de1d14 100755
--- a/plugins/e-acsl/scripts/e-acsl-gcc
+++ b/plugins/e-acsl/scripts/e-acsl-gcc
@@ -890,7 +890,7 @@ fi
 # Gcc and related flags
 CC="$OPTION_CC"
 CFLAGS="$OPTION_CFLAGS
-  -std=c99 $GCCMACHDEP $OPT_CFLAGS
+  -std=c99 -D_DEFAULT_SOURCE $GCCMACHDEP $OPT_CFLAGS
   -fno-builtin -fno-merge-constants
   -Wall \
   -Wno-long-long \
diff --git a/plugins/e-acsl/tests/libc/default_source.c b/plugins/e-acsl/tests/libc/default_source.c
new file mode 100644
index 0000000000..f1e2691a9b
--- /dev/null
+++ b/plugins/e-acsl/tests/libc/default_source.c
@@ -0,0 +1,18 @@
+/* run.config
+   COMMENT: POSIX functions that glibc declares only with _DEFAULT_SOURCE (or
+   COMMENT: an equivalent feature macro), such as stpcpy, must also be
+   COMMENT: declared when e-acsl-gcc compiles the program with -std=c99.
+*/
+/* run.config_dev
+   COMMENT: with Frama-C's libc (-L), the instrumented code includes <string.h>
+   MACRO: ROOT_EACSL_GCC_OPTS_EXT -L
+*/
+
+#include <string.h>
+
+int main() {
+  char dest[8];
+  char *end = stpcpy(dest, "abc");
+  //@ assert end == dest + 3;
+  return 0;
+}
