+[kernel] Parsing callee_labels.c (with preprocessing)
+[meta] Translation is enabled
+[meta] Will process 5 properties
+[meta] Successful translation
+/* Generated by Frama-C */
+int secret;
+int n;
+/*@ logic ℤ len{L}(int *p) = \at(*p,L);
+ */
+/*@ assigns *(d + (0 .. len{Old}(p))); */
+void fill_len(char *d, int *p);
+
+/*@ assigns *(d + (0 .. \old(*p))); */
+void fill_old(char *d, int *p);
+
+/*@ assigns *(d + (0 .. \at(*p,Pre))); */
+void fill_pre(char *d, int *p);
+
+/*@ assigns *(d + (0 .. \at(*p,Here))); */
+void fill_here(char *d, int *p);
+
+/*@ assigns *(d + 0);
+    assigns *(d + 0) \from *(s + (0 .. len{Old}(p))); */
+void read_len(char *d, char *s, int *p);
+
+/*@ assigns *(d + 0);
+    assigns *(d + 0) \from *(s + (0 .. \old(*p))); */
+void read_old(char *d, char *s, int *p);
+
+/*@ assigns *(d + 0);
+    assigns *(d + 0) \from *(s + (0 .. \at(*p,Pre))); */
+void read_pre(char *d, char *s, int *p);
+
+/*@ behavior big:
+      assumes \at(*p,Pre) > 2;
+      assigns *(d + 0);
+      assigns *(d + 0) \from *(s + (0 .. len{Old}(p)));
+    
+    behavior small:
+      assumes \valid(p) ∧ len(p) ≤ 2;
+      assigns *(d + 0);
+      assigns *(d + 0) \from *(s + (0 .. \old(*p)));
+ */
+void copy(char *d, char const *s, int *p);
+
+/*@ behavior active:
+      assumes \valid(p);
+      assumes len(p) > 0;
+      assumes \at(*p,Here) > 0;
+      assumes \at(*p,Pre) > 0;
+      assigns *(d + (0 .. len{Old}(p)));
+ */
+void fill_checked(char *d, int *p);
+
+void before(char *buf)
+{
+  /*@ assert
+        no_write_secret: meta: \separated(buf + (0 .. len(&n)), &secret);
+  */
+  fill_len(buf,& n);
+  /*@ assert
+        no_write_secret: meta:
+          \separated(buf + (0 .. \at(*(&n),Here)), &secret);
+  */
+  fill_old(buf,& n);
+  /*@ assert
+        no_write_secret: meta:
+          \separated(buf + (0 .. \at(*(&n),Here)), &secret);
+  */
+  fill_pre(buf,& n);
+  /*@ assert
+        no_write_secret: meta:
+          \separated(buf + (0 .. \at(*(&n),Here)), &secret);
+  */
+  fill_here(buf,& n);
+  return;
+}
+
+void after(char *buf)
+{
+  meta_pre_0: fill_len(buf,& n);
+  /*@
+  assert
+    secret_unchanged: meta:
+      \separated(buf + (0 .. len{meta_pre_0}(&n)), &secret) ∨
+      \at(secret,Here) ≡ \at(secret,meta_pre_0);
+   */
+  ;
+  meta_pre_1: fill_here(buf,& n);
+  /*@
+  assert
+    secret_unchanged: meta:
+      \separated(buf + (0 .. \at(*(&n),meta_pre_1)), &secret) ∨
+      \at(secret,Here) ≡ \at(secret,meta_pre_1);
+   */
+  ;
+  return;
+}
+
+void after_assumes(char *buf)
+{
+  meta_pre_2: fill_checked(buf,& n);
+  /*@
+  assert
+    secret_unchanged_assumes: meta:
+      \valid{meta_pre_2}(&n) ⇒
+      len{meta_pre_2}(&n) > 0 ⇒
+      \at(*(&n),meta_pre_2) > 0 ⇒
+      \at(*(&n),meta_pre_2) > 0 ⇒
+      \separated(buf + (0 .. len{meta_pre_2}(&n)), &secret) ∨
+      \at(secret,Here) ≡ 0;
+   */
+  ;
+  return;
+}
+
+void reader(char *d, char *s)
+{
+  /*@ assert no_read_secret: meta: \separated(s + (0 .. len(&n)), &secret);
+  */
+  read_len(d,s,& n);
+  /*@ assert
+        no_read_secret: meta: \separated(s + (0 .. \at(*(&n),Here)), &secret);
+  */
+  read_old(d,s,& n);
+  /*@ assert
+        no_read_secret: meta: \separated(s + (0 .. \at(*(&n),Here)), &secret);
+  */
+  read_pre(d,s,& n);
+  return;
+}
+
+void reader_behaviors(char *d, char const *s)
+{
+  /*@ assert
+        no_read_secret_behaviors: meta:
+          \at(*(&n),Here) > 2 ⇒ \separated(s + (0 .. len(&n)), &secret);
+  */
+  /*@ assert
+        no_read_secret_behaviors: meta:
+          \valid(&n) ∧ len(&n) ≤ 2 ⇒
+          \separated(s + (0 .. \at(*(&n),Here)), &secret);
+  */
+  copy(d,s,& n);
+  return;
+}
+
+/*@ \meta::meta "no_write_secret"; */
+/*@ \meta::meta "secret_unchanged"; */
+/*@ \meta::meta "no_read_secret"; */
+/*@ \meta::meta "secret_unchanged_assumes"; */
+/*@ \meta::meta "no_read_secret_behaviors";
+*/
+
