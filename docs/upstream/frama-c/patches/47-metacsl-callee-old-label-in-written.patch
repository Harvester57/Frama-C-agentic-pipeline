+  \separated(_read, &secret);
+ */
+/*@
+predicate meta_no_read_secret{Before}(set<char const *>  _read) =
+  \at(*(&n),Before) > 2 ⇒ \separated(_read, &secret);
+ */
+/*@ assigns *(d + (0 .. len{Old}(p))); */
+void fill_len(char *d, int *p);
+
+/*@ assigns *(d + (0 .. \old(*p))); */
+void fill_old(char *d, int *p);
+
+/*@ assigns *(d + (0 .. \at(*p,Pre))); */
+void fill_pre(char *d, int *p);
+
+/*@ behavior big:
+      assumes \at(*p,Pre) > 2;
+      assigns *(d + 0);
+      assigns *(d + 0) \from *(s + (0 .. len{Old}(p)));
+    
+    behavior small:
+      assumes *p ≤ 2;
+      assigns *(d + 0);
+      assigns *(d + 0) \from *(s + (0 .. \old(*p)));
+ */
+void copy(char *d, char const *s, int *p);
+
+void before(char *buf)
+{
+  /*@ assert
+        no_write_secret: meta: meta_no_write_secret(buf + (0 .. len(&n)));
+  */
+  fill_len(buf,& n);
+  /*@ assert
+        no_write_secret: meta:
+          meta_no_write_secret(buf + (0 .. \at(*(&n),Here)));
+  */
+  fill_old(buf,& n);
+  /*@ assert
+        no_write_secret: meta:
+          meta_no_write_secret(buf + (0 .. \at(*(&n),Here)));
+  */
+  fill_pre(buf,& n);
+  return;
+}
+
+void after(char *buf)
+{
+  meta_pre_0: fill_len(buf,& n);
+  /*@
+  assert
+    secret_unchanged: meta:
+      meta_secret_unchanged{Here, meta_pre_0}(buf +
+                                              (0 .. len{meta_pre_0}(&n)));
+   */
+  ;
+  return;
+}
+
+void reader(char *d, char const *s)
+{
+  /*@ assert no_read_secret: meta: meta_no_read_secret(s + (0 .. len(&n)));
+  */
