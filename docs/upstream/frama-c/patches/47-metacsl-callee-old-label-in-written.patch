diff --git a/meta_annotate.ml b/meta_annotate.ml
index 03447cf..d9db2af 100644
--- a/meta_annotate.ml
+++ b/meta_annotate.ml
@@ -563,6 +563,16 @@ let inspect_contract process stmt ckf args =
           (Option.get oargs) args ;
       h
 
+    (* In the contract of the callee, Old and Pre denote its pre-state, that is
+       the state just before the call. The instance is a statement annotation,
+       where Old is not allowed and Pre denotes the pre-state of the caller.
+       Use the meta label Before instead: replace_after_before turns it into
+       Here when the annotation precedes the call, and into a label on the call
+       when it follows it. *)
+    method! vlogic_label = function
+      | BuiltinLabel (Old | Pre) -> Cil.ChangeTo (FormalLabel "Before")
+      | _ -> Cil.DoChildren
+
     method! vterm _ =
       Cil.DoChildrenPost (fun term -> match term.term_node with
           | TLval (host, _) | TAddrOf (host, _) | TStartOf (host, _) ->
diff --git a/tests/meta/callee_labels.c b/tests/meta/callee_labels.c
new file mode 100644
index 0000000..fea7a1f
--- /dev/null
+++ b/tests/meta/callee_labels.c
@@ -0,0 +1,58 @@
+/* run.config*
+OPT: @META@ @PRINT@
+OPT: @META@ -meta-quantify-range @PRINT@
+*/
+
+/* The \written and \read instances of a call come from the assigns clauses
+   and their \from parts in the contract of the callee. Old and Pre in these
+   clauses, and Pre in the assumes clauses, denote the pre-state of the callee,
+   that is the state just before the call. */
+
+int secret;
+int n;
+
+/*@ logic integer len{L}(int *p) = \at(*p, L); */
+
+/*@ assigns d[0 .. len(p)]; */ // implicit label Old
+void fill_len(char *d, int *p);
+
+/*@ assigns d[0 .. \old(*p)]; */
+void fill_old(char *d, int *p);
+
+/*@ assigns d[0 .. \at(*p, Pre)]; */
+void fill_pre(char *d, int *p);
+
+/*@ behavior big:
+      assumes \at(*p, Pre) > 2;
+      assigns d[0] \from s[0 .. len(p)];
+    behavior small:
+      assumes *p <= 2;
+      assigns d[0] \from s[0 .. \old(*p)];
+*/
+void copy(char *d, const char *s, int *p);
+
+void before(char *buf) {
+  fill_len(buf, &n);
+  fill_old(buf, &n);
+  fill_pre(buf, &n);
+}
+
+void after(char *buf) {
+  fill_len(buf, &n);
+}
+
+void reader(char *d, const char *s) {
+  copy(d, s, &n);
+}
+
+/*@ meta \prop, \name(no_write_secret), \targets({before}), \context(\writing),
+      \separated(\written, &secret);
+*/
+
+/*@ meta \prop, \name(secret_unchanged), \targets({after}), \context(\writing),
+      \separated(\written, &secret) || \at(secret, After) == \at(secret, Before);
+*/
+
+/*@ meta \prop, \name(no_read_secret), \targets({reader}), \context(\reading),
+      \separated(\read, &secret);
+*/
diff --git a/tests/meta/oracle/callee_labels.0.res.oracle b/tests/meta/oracle/callee_labels.0.res.oracle
new file mode 100644
index 0000000..e7d9d87
--- /dev/null
+++ b/tests/meta/oracle/callee_labels.0.res.oracle
@@ -0,0 +1,81 @@
+[kernel] Parsing callee_labels.c (with preprocessing)
+[meta] Translation is enabled
+[meta] Will process 3 properties
+[meta] Successful translation
+/* Generated by Frama-C */
+int secret;
+int n;
+/*@ logic ℤ len{L}(int *p) = \at(*p,L);
+ */
+/*@ assigns *(d + (0 .. len{Old}(p))); */
+void fill_len(char *d, int *p);
+
+/*@ assigns *(d + (0 .. \old(*p))); */
+void fill_old(char *d, int *p);
+
+/*@ assigns *(d + (0 .. \at(*p,Pre))); */
+void fill_pre(char *d, int *p);
+
+/*@ behavior big:
+      assumes \at(*p,Pre) > 2;
+      assigns *(d + 0);
+      assigns *(d + 0) \from *(s + (0 .. len{Old}(p)));
+    
+    behavior small:
+      assumes *p ≤ 2;
+      assigns *(d + 0);
+      assigns *(d + 0) \from *(s + (0 .. \old(*p)));
+ */
+void copy(char *d, char const *s, int *p);
+
+void before(char *buf)
+{
+  /*@ assert
+        no_write_secret: meta: \separated(buf + (0 .. len(&n)), &secret);
+  */
+  fill_len(buf,& n);
+  /*@ assert
+        no_write_secret: meta:
+          \separated(buf + (0 .. \at(*(&n),Here)), &secret);
+  */
+  fill_old(buf,& n);
+  /*@ assert
+        no_write_secret: meta:
+          \separated(buf + (0 .. \at(*(&n),Here)), &secret);
+  */
+  fill_pre(buf,& n);
+  return;
+}
+
+void after(char *buf)
+{
+  meta_pre_0: fill_len(buf,& n);
+  /*@
+  assert
+    secret_unchanged: meta:
+      \separated(buf + (0 .. len{meta_pre_0}(&n)), &secret) ∨
+      \at(secret,Here) ≡ \at(secret,meta_pre_0);
+   */
+  ;
+  return;
+}
+
+void reader(char *d, char const *s)
+{
+  /*@ assert
+        no_read_secret: meta:
+          \at(*(&n),Here) > 2 ⇒ \separated(s + (0 .. len(&n)), &secret);
+  */
+  /*@ assert
+        no_read_secret: meta:
+          *(&n) ≤ 2 ⇒ \separated(s + (0 .. \at(*(&n),Here)), &secret);
+  */
+  copy(d,s,& n);
+  return;
+}
+
+/*@ \meta::meta "no_write_secret"; */
+/*@ \meta::meta "secret_unchanged"; */
+/*@ \meta::meta "no_read_secret";
+*/
+
