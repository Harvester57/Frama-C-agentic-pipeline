diff --git a/meta_annotate.ml b/meta_annotate.ml
index 03447cf..1f34319 100644
--- a/meta_annotate.ml
+++ b/meta_annotate.ml
@@ -563,6 +563,17 @@ let inspect_contract process stmt ckf args =
           (Option.get oargs) args ;
       h
 
+    (* In the contract of the callee, Old, Pre and Here in assumes and assigns
+       clauses denote its pre-state, that is the state just before the call.
+       The instance is a statement annotation, where Old is not allowed, Pre
+       denotes the pre-state of the caller, and Here under an After property
+       denotes the post-state after the call. Use the meta label Before
+       instead: replace_after_before turns it into Here when the annotation
+       precedes the call, and into a label on the call when it follows it. *)
+    method! vlogic_label = function
+      | BuiltinLabel (Old | Pre | Here) -> Cil.ChangeTo (FormalLabel "Before")
+      | _ -> Cil.DoChildren
+
     method! vterm _ =
       Cil.DoChildrenPost (fun term -> match term.term_node with
           | TLval (host, _) | TAddrOf (host, _) | TStartOf (host, _) ->
diff --git a/tests/meta/callee_labels.c b/tests/meta/callee_labels.c
new file mode 100644
index 0000000..1385362
--- /dev/null
+++ b/tests/meta/callee_labels.c
@@ -0,0 +1,104 @@
+/* run.config*
+OPT: @META@ @PRINT@
+OPT: @META@ -meta-quantify-range @PRINT@
+*/
+
+/* The \written and \read instances of a call come from the assigns clauses
+   and their \from parts in the contract of the callee. Old, Pre and Here in
+   these clauses and in the assumes clauses denote the pre-state of the callee,
+   that is the state just before the call. */
+
+int secret;
+int n;
+
+/*@ logic integer len{L}(int *p) = \at(*p, L); */
+
+/*@ assigns d[0 .. len(p)]; */ // implicit label Old
+void fill_len(char *d, int *p);
+
+/*@ assigns d[0 .. \old(*p)]; */
+void fill_old(char *d, int *p);
+
+/*@ assigns d[0 .. \at(*p, Pre)]; */
+void fill_pre(char *d, int *p);
+
+/*@ assigns d[0 .. \at(*p, Here)]; */
+void fill_here(char *d, int *p);
+
+/*@ assigns d[0] \from s[0 .. len(p)]; */
+void read_len(char *d, char *s, int *p);
+
+/*@ assigns d[0] \from s[0 .. \old(*p)]; */
+void read_old(char *d, char *s, int *p);
+
+/*@ assigns d[0] \from s[0 .. \at(*p, Pre)]; */
+void read_pre(char *d, char *s, int *p);
+
+/*@ behavior big:
+      assumes \at(*p, Pre) > 2;
+      assigns d[0] \from s[0 .. len(p)];
+    behavior small:
+      assumes \valid(p) && len(p) <= 2;
+      assigns d[0] \from s[0 .. \old(*p)];
+*/
+void copy(char *d, const char *s, int *p);
+
+/*@ behavior active:
+      assumes \valid(p);
+      assumes len(p) > 0;
+      assumes \at(*p, Here) > 0;
+      assumes \at(*p, Pre) > 0;
+      assigns d[0 .. len(p)];
+*/
+void fill_checked(char *d, int *p);
+
+void before(char *buf) {
+  fill_len(buf, &n);
+  fill_old(buf, &n);
+  fill_pre(buf, &n);
+  fill_here(buf, &n);
+}
+
+void after(char *buf) {
+  fill_len(buf, &n);
+  fill_here(buf, &n);
+}
+
+void after_assumes(char *buf) {
+  fill_checked(buf, &n);
+}
+
+void reader(char *d, char *s) {
+  read_len(d, s, &n);
+  read_old(d, s, &n);
+  read_pre(d, s, &n);
+}
+
+void reader_behaviors(char *d, const char *s) {
+  copy(d, s, &n);
+}
+
+/*@ meta \prop, \name(no_write_secret), \targets({before}), \context(\writing),
+      \separated(\written, &secret);
+*/
+
+/*@ meta \prop, \name(secret_unchanged), \targets({after}), \context(\writing),
+      \separated(\written, &secret) || \at(secret, After) == \at(secret, Before);
+*/
+
+/*@ meta \prop, \name(no_read_secret), \targets({reader}), \context(\reading),
+      \separated(\read, &secret);
+*/
+
+/* \flags(fold:no): -meta-fold shares folded predicates by type signature
+   across behaviors, so keep behavior-guarded checks unfolded here. */
+
+/*@ meta \prop, \name(secret_unchanged_assumes), \targets({after_assumes}),
+      \context(\writing), \flags(fold:no),
+      \separated(\written, &secret) || \at(secret, After) == 0;
+*/
+
+/*@ meta \prop, \name(no_read_secret_behaviors), \targets({reader_behaviors}),
+      \context(\reading), \flags(fold:no),
+      \separated(\read, &secret);
+*/
