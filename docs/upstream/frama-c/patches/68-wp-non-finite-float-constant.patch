From be392e80454e5c3b69bf5d69aba030d11be8c9e7 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 23 Nov 2026 00:02:06 +0000
Subject: [PATCH] [wp] reject non-finite float constants from Qed real
 simplification

Cfloat.fmake, Cfloat.code_lit, and Cfloat.parse_literal passed
non-finite OCaml floats (such as overflowed `1e308 * 10.0`,
`(float)1e39`, `1e40f`, or constant-folded `1.0 / 0.0`) into `F.e_float`
and `Q.of_float`, producing infinite `Kreal` constants in Qed. This
caused Qed to prove false real equalities (`y + 1.0 == z`,
`(float)1e39 + 1.0 == (float)1e39`), refute true ones
(`(float)1e39 - (float)1e39 == 0.0`), and crash Why3 export with
`Invalid_argument("Wp.Cfloat.const_float")` on any remaining goal
(including the RTE `is_nan_or_infinite` guard itself).

Raise `Not_found` in `fmake` when the rounded float is non-finite (so
Why3 handles overflow symbolically, matching the existing `DIV` guard),
reject non-finite suffixed literals in `parse_literal`, and emit a
`Warning.error` instead of `F.e_float` for non-finite values in
`code_lit`.

New test: wp_acsl/float_non_finite.i.
---
 plugins/wp/src/Cfloat.ml                      |  28 +++--
 plugins/wp/tests/wp_acsl/float_non_finite.i   |  26 +++++
 .../oracle/float_non_finite.0.res.oracle      | 104 ++++++++++++++++++
 .../oracle/float_non_finite.1.res.oracle      |  82 ++++++++++++++
 4 files changed, 233 insertions(+), 7 deletions(-)
 create mode 100644 plugins/wp/tests/wp_acsl/float_non_finite.i
 create mode 100644 plugins/wp/tests/wp_acsl/oracle/float_non_finite.0.res.oracle
 create mode 100644 plugins/wp/tests/wp_acsl/oracle/float_non_finite.1.res.oracle

diff --git a/plugins/wp/src/Cfloat.ml b/plugins/wp/src/Cfloat.ml
index d87f66ff5d..adf9ec6685 100644
--- a/plugins/wp/src/Cfloat.ml
+++ b/plugins/wp/src/Cfloat.ml
@@ -124,9 +124,15 @@ let () = Context.register
 
 let rfloat = Floating_point.round_to_single_precision
 
-let fmake ulp value = match ulp with
-  | Float32 -> F.e_fun !@fq32 [F.e_float (rfloat value)]
-  | Float64 -> F.e_fun !@fq64 [F.e_float value]
+let fmake ulp value =
+  let v = match ulp with
+    | Float32 -> rfloat value
+    | Float64 -> value
+  in
+  if not (Float.is_finite v) then raise Not_found ;
+  match ulp with
+  | Float32 -> F.e_fun !@fq32 [F.e_float v]
+  | Float64 -> F.e_fun !@fq64 [F.e_float v]
 
 let qmake ulp q = fmake ulp (Q.to_float q)
 
@@ -176,13 +182,21 @@ let parse_literal ~model v r =
 
 let acsl_lit l =
   let open Cil_types in
-  F.e_real (parse_literal ~model:(Context.get model) l.r_nearest l.r_literal)
+  let q = parse_literal ~model:(Context.get model) l.r_nearest l.r_literal in
+  if Q.is_real q then F.e_real q
+  else Warning.error "Unexpected constant literal %S" l.r_literal
 
 let code_lit ulp value original =
   match Context.get model , ulp , original with
-  | Float , Float32 , _ -> F.e_fun ~result:!@f32 !@fq32 [F.e_float value]
-  | Float , Float64 , _ -> F.e_fun ~result:!@f64 !@fq64 [F.e_float value]
-  | Real , _ , None -> F.e_float value
+  | Float , Float32 , _ when Float.is_finite value ->
+    F.e_fun ~result:!@f32 !@fq32 [F.e_float value]
+  | Float , Float64 , _ when Float.is_finite value ->
+    F.e_fun ~result:!@f64 !@fq64 [F.e_float value]
+  | Float , _ , _ ->
+    Warning.error "Non-finite floating-point constant"
+  | Real , _ , None when Float.is_finite value -> F.e_float value
+  | Real , _ , None ->
+    Warning.error "Non-finite floating-point constant"
   | Real , _ , Some r -> F.e_real (parse_literal ~model:Real value r)
 
 (* -------------------------------------------------------------------------- *)
diff --git a/plugins/wp/tests/wp_acsl/float_non_finite.i b/plugins/wp/tests/wp_acsl/float_non_finite.i
new file mode 100644
index 0000000000..cfb353307c
--- /dev/null
+++ b/plugins/wp/tests/wp_acsl/float_non_finite.i
@@ -0,0 +1,26 @@
+/* run.config
+   OPT:
+   OPT: -wp-rte -wp-gen -wp-prover alt-ergo -wp-fct ovf_mul,ovf_lit
+*/
+
+/*@ check lemma ovf_f32_plus1_bad: (float)1e39 + 1.0 == (float)1e39;
+    check lemma ovf_f32_sub_ok:    (float)1e39 - (float)1e39 == 0.0; */
+
+double ovf_mul(void) {
+  double x = 1e308;
+  double y = x * 10.0;
+  double z = x * 20.0;
+  //@ check plus1_bad: y + 1.0 == z;
+  //@ check twice_bad: y + y == z + 5.0;
+  return y;
+}
+
+float ovf_lit(void) {
+  float f = 1e40f;
+  //@ check lit_bad: f + 1.0 == f;
+  return f;
+}
+
+void acsl_lit_inf(void) {
+  //@ check acsl_bad: 1e40f + 1.0 == 1e40f;
+}
