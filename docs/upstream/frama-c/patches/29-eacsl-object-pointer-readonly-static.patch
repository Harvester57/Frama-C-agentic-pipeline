@@ -0,0 +1,32 @@
+/* run.config
+   COMMENT: \object_pointer holds for pointers into read-only objects
+*/
+
+#include <stdio.h>
+
+static const char table[4] = {1, 2, 3, 0};
+
+int main(void) {
+  const char *t = table;
+  const char *s = "abc";
+
+  /* a const global array: read-only, but an object */
+  //@ check RO_T: \valid_read(t) && !\valid(t);
+  //@ check T0:   \object_pointer(t);
+  //@ check T3:   \object_pointer(t + 3);
+  //@ check T4:   \object_pointer(t + 4);
+  //@ check T5:  !\object_pointer(t + 5);
+  //@ check TM1: !\object_pointer(t - 1);
+
+  /* a string literal */
+  //@ check RO_S: \valid_read(s) && !\valid(s);
+  //@ check S0:   \object_pointer(s);
+  //@ check S4:   \object_pointer(s + 4);
+  //@ check S5:  !\object_pointer(s + 5);
+  //@ check SM1: !\object_pointer(s - 1);
+
+  /* a read-only standard stream */
+  //@ check IN:   \object_pointer(stdin);
+
+  return t[0] + s[0] != 'b';
+}
