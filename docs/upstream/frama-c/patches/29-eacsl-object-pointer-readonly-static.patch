+/*! \brief Implementation of the \b \\object_pointer predicate of E-ACSL.
+ *
+ * Returns `true` if the `size` bytes from `ptr`, or the `size` bytes before
+ * `ptr` (one past the end of an object), are allocated, as in
+ * ::eacsl_valid_read: the object does not need to be writable. */
 /*@ assigns \result \from *(((char*)ptr)+(-size..size-1)), ptr, size;
   @ behavior valid:
-  @   assumes \valid(((char *)ptr)+(0..size-1));
+  @   assumes \valid_read(((char *)ptr)+(0..size-1));
   @   assumes
   @     size <= 0 ||
   @     ! \separated(((char *)ptr)+(0..size-1),
   @                  ((char *)\base_addr(base))+(0..\block_length(base)-1));
   @   ensures \result == 1;
   @ behavior minus_one:
-  @   assumes \valid(((char *)ptr)+(-size..-1));
-  @   assumes ! \valid(((char *)ptr)+(0..size-1));
+  @   assumes \valid_read(((char *)ptr)+(-size..-1));
+  @   assumes ! \valid_read(((char *)ptr)+(0..size-1));
   @   assumes
   @     size <= 0 ||
   @     ! \separated(((char *)ptr)+(-size..-1),
   @                  ((char *)\base_addr(base))+(0..\block_length(base)-1));
   @   ensures \result == 1;
   @ behavior invalid_pointer_ptr:
-  @   assumes ! \valid(((char *)ptr)+(-size..-1));
-  @   assumes ! \valid(((char *)ptr)+(0..size-1));
+  @   assumes ! \valid_read(((char *)ptr)+(-size..-1));
+  @   assumes ! \valid_read(((char *)ptr)+(0..size-1));
   @   ensures \result == 0;
   @ behavior separated_ptr:
   @   assumes size > 0;
