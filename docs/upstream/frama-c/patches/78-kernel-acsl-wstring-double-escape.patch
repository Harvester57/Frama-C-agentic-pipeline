From 31e09e87d5925b0c3d3e572688c97e6b83b850db Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:54:17 +0000
Subject: [PATCH] [kernel] avoid double-escaping ACSL wide strings and handle
 empty L""

In Cil_printer.logic_constant (cil_printer.ml), the LWStr case passed
the output of Escape.escape_char through Format's "%S" specifier,
escaping every backslash and quote a second time (for example printing
L"\n\t" as L"\\n" "\\t" and L"a\"b" as L"a" "\\\"" "b"). Re-parsing
the printed file doubled the length of every escaped character and
turned valid sizeof checks into invalid ones.

In addition, when the wide string was empty (LWStr []), List.iter
printed nothing after "L", emitting invalid syntax such as sizeof(L)
that failed re-parsing with "unbound logic variable L".

Handle LWStr [] explicitly as L"" and print each character with "\"%s\""
instead of "%S". Add regression test tests/pretty_printing/acsl_wstring.c.
---
 .../services/ast_printing/cil_printer.ml      |  4 ++-
 tests/pretty_printing/acsl_wstring.c          | 15 ++++++++
 .../oracle/acsl_wstring.0.res.oracle          | 34 +++++++++++++++++++
 3 files changed, 52 insertions(+), 1 deletion(-)
 create mode 100644 tests/pretty_printing/acsl_wstring.c
 create mode 100644 tests/pretty_printing/oracle/acsl_wstring.0.res.oracle

diff --git a/src/kernel/services/ast_printing/cil_printer.ml b/src/kernel/services/ast_printing/cil_printer.ml
index 1fa68a0a41..fc7daa8203 100644
--- a/src/kernel/services/ast_printing/cil_printer.ml
+++ b/src/kernel/services/ast_printing/cil_printer.ml
@@ -2396,6 +2396,8 @@ class cil_printer () = object (self)
                             we want to print it as hexa *)
     | Integer(i, _) ->  Z.pretty fmt i
     | LStr(s) -> fprintf fmt "\"%s\"" (Escape.escape_string s)
+    | LWStr [] ->
+      fprintf fmt "L\"\""
     | LWStr(s) ->
       (* text ("L\"" ^ escape_string s ^ "\"")  *)
       fprintf fmt "L";
@@ -2403,7 +2405,7 @@ class cil_printer () = object (self)
         (fun elt ->
            if (elt >= Int64.zero &&
                elt <= (Int64.of_int 255)) then
-             fprintf fmt "%S"
+             fprintf fmt "\"%s\""
                (Escape.escape_char (Char.chr (Int64.to_int elt)))
            else
              fprintf fmt "\"\\x%LX\"" elt;
diff --git a/tests/pretty_printing/acsl_wstring.c b/tests/pretty_printing/acsl_wstring.c
new file mode 100644
index 0000000000..554a664dea
--- /dev/null
+++ b/tests/pretty_printing/acsl_wstring.c
@@ -0,0 +1,15 @@
+/* run.config
+   OPT: @PTEST_FILE@ -print -then -ocode ./ocode_@PTEST_NAME@.c -print -then ./ocode_@PTEST_NAME@.c -ocode="" -print
+*/
+
+#include <stddef.h>
+
+int main(void) {
+  //@ check s1: sizeof(L"\n\t") == 3 * sizeof(wchar_t);
+  //@ check s2: sizeof(L"a\"b") == 4 * sizeof(wchar_t);
+  //@ check s3: sizeof(L"a\\b") == 4 * sizeof(wchar_t);
+  //@ check s4: sizeof(L"\351") == 2 * sizeof(wchar_t);
+  //@ check s5: sizeof(L"a'b") == 4 * sizeof(wchar_t);
+  //@ check s6: sizeof(L"") == 1 * sizeof(wchar_t);
+  return 0;
+}
diff --git a/tests/pretty_printing/oracle/acsl_wstring.0.res.oracle b/tests/pretty_printing/oracle/acsl_wstring.0.res.oracle
new file mode 100644
index 0000000000..60401e0d61
--- /dev/null
+++ b/tests/pretty_printing/oracle/acsl_wstring.0.res.oracle
@@ -0,0 +1,34 @@
