--- /dev/null
+++ b/plugins/wp/tests/wp_acsl/empty_range_add.i
@@ -0,0 +1,28 @@
+/* run.config
+   OPT:
+*/
+
+/*@ check lemma empty_plus_bad:  8 \in ((5..3) + (0..10));
+    check lemma empty_minus_bad: -2 \in ((5..3) - (0..10));
+    check lemma open_empty_bad:  0 \in ((..3) + (5..4));
+    check lemma subset_empty_ok: \subset((5..3) + (0..10), \empty);
+    check lemma nonempty_plus_ok: 8 \in ((1..3) + (0..10)); */
+
+/*@ requires n == 0;
+    ensures 5 \in ((0 .. n - 1) + (0 .. 10)); */
+void sym_empty_add(int n) {}
+
+/*@ requires n == 0;
+    requires \valid(p + (0 .. n - 1) + (0 .. 1));
+    assigns \nothing; */
+void shift_empty_valid(int *p, int n) {
+  //@ check \valid(p);
+}
+
+/*@ requires n == 0;
+    assigns *(p + (0 .. n - 1) + (0 .. 1)); */
+void shift_empty_assigns(int *p, int n) { *p = 1; }
+
+/*@ requires n == 2;
+    assigns *(p + (0 .. n - 1) + (0 .. 1)); */
+void shift_nonempty_assigns(int *p, int n) { *p = 1; }
