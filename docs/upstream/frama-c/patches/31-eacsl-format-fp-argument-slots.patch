From 5c6de1593c37e0da7712402c72c28662ea46339b Mon Sep 17 00:00:00 2001
From: Florian Stosse <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 16 Nov 2026 13:04:41 +0100
Subject: [PATCH] [e-acsl] read each format argument with its own type

With -e-acsl-validate-format-strings, validate_format collected the
variadic arguments with va_arg(ap, void *) whatever their type. On
x86_64 a double is passed in an SSE register and a long double in memory,
so reading it as a void * takes the next argument instead, and every later
"%s", "%p" or "%n" was checked against the argument after its own:

  snprintf(t, sizeof t, "%f %s", 1.5, "abc")
  snprintf: attempt to access unallocated memory via directive 2 ('%s')

The shift also hid real errors: an unterminated string for "%s" after a
double was not checked when a valid string came after it. On a 32-bit
target, a double or a long long would shift the arguments in the same way.

Read each argument with the type given by the format description that the
instrumentation passes (pointers as void *, double, long double, long,
long long, and int for everything else), and keep only the pointers.

Regression test: tests/format/printf_fp_args.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../e-acsl/libc_replacements/e_acsl_stdio.c   |  42 +-
 .../format/oracle/gen_printf_fp_args.0.c      | 499 ++++++++++++++++++
 .../format/oracle/printf_fp_args.0.res.oracle |  31 ++
 .../printf_fp_args.0.e-acsl.err.log           |  11 +
 plugins/e-acsl/tests/format/printf_fp_args.c  |  39 ++
 5 files changed, 619 insertions(+), 3 deletions(-)
 create mode 100644 plugins/e-acsl/tests/format/oracle/gen_printf_fp_args.0.c
 create mode 100644 plugins/e-acsl/tests/format/oracle/printf_fp_args.0.res.oracle
 create mode 100644 plugins/e-acsl/tests/format/oracle_dev/printf_fp_args.0.e-acsl.err.log
 create mode 100644 plugins/e-acsl/tests/format/printf_fp_args.c

diff --git a/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_stdio.c b/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_stdio.c
index f4876abc80..0d54426f5b 100644
--- a/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_stdio.c
+++ b/plugins/e-acsl/share/e-acsl/libc_replacements/e_acsl_stdio.c
@@ -780,12 +780,48 @@ static void validate_format(const char *fmtdesc, const char *fmt, va_list ap,
   format_directive **dirs = get_format_directives((char *)fmt);
   format_directive **dirs_c = dirs; /* extra alias for passing it to `free` */
 
-  /* Track addresses of variadic arguments */
+  /* Track addresses of variadic arguments. Each argument is read with its own
+     type, given by `fmtdesc`: reading an argument with a type of another size
+     or class (e.g., a `double` as a `void *`) would not consume it, and every
+     argument after it would be read from the wrong place. */
   int arglen = strlen(fmtdesc); /* number of variadic arguments */
   void *args[arglen];
   int i;
-  for (int i = 0; i < arglen; i++)
-    args[i] = va_arg(ap, void *);
+  for (int i = 0; i < arglen; i++) {
+    args[i] = NULL;
+    switch (fmtdesc[i]) {
+    case PChar:
+    case PUChar:
+    case PShort:
+    case PUShort:
+    case PInt:
+    case PUInt:
+    case PLong:
+    case PULong:
+    case PLongLong:
+    case PULongLong:
+    case PVoid:
+      args[i] = va_arg(ap, void *);
+      break;
+    case FFloat: /* promoted to double */
+    case FDouble:
+      (void)va_arg(ap, double);
+      break;
+    case FLongDouble:
+      (void)va_arg(ap, long double);
+      break;
+    case ILong:
+    case IULong:
+      (void)va_arg(ap, long);
+      break;
+    case ILongLong:
+    case IULongLong:
+      (void)va_arg(ap, long long);
+      break;
+    default: /* int, unsigned int and the types promoted to int */
+      (void)va_arg(ap, int);
+    }
+  }
   va_end(ap);
 
   /* Validate each generated directive */
