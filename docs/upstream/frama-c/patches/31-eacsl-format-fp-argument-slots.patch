@@ -0,0 +1,39 @@
+/* run.config
+   COMMENT: Check that the arguments after a floating-point argument are
+   COMMENT: validated against the right directive
+   DEPS: @PTEST_DEPS@ utils/signalled.h
+   STDOPT:
+*/
+/* run.config_dev
+   MACRO: INCLUDED_HEADERS utils/signalled.h
+   COMMENT: This part is blank on purpose (test stability + Dune)
+
+*/
+
+#include "utils/signalled.h"
+#include <stdio.h>
+
+int main(void) {
+  char t[128];
+  const char *s = "abc";
+  char u[3] = {'a', 'b', 'c'}; // not NUL-terminated
+  int n;
+  long double ld = 2.5L;
+
+  // Pointers after a double or a long double
+  OK(snprintf(t, sizeof t, "%f %s", 1.5, s));
+  OK(snprintf(t, sizeof t, "%Lf %s", ld, s));
+  OK(snprintf(t, sizeof t, "%f%n", 1.5, &n));
+  OK(snprintf(t, sizeof t, "%Lf %p", ld, (void *)&n));
+  OK(snprintf(t, sizeof t, "%s %f %d %Lf %s", s, 1.5, 7, ld, s));
+  OK(snprintf(t, sizeof t, "%lld %s %ld %s", 1LL, s, 2L, s));
+  // More doubles than registers: the last ones are passed on the stack
+  OK(snprintf(t, sizeof t, "%f %f %f %f %f %f %f %f %f %s", 1., 2., 3., 4., 5.,
+              6., 7., 8., 9., s));
+
+  // An invalid string after a double is reported on its own directive ...
+  ABRT(snprintf(t, sizeof t, "%f %s %s", 1.5, u, s));
+  // ... even when a valid string follows it
+  ABRT(snprintf(t, sizeof t, "%f %s", 1.5, u, s));
+  return 0;
+}
