From 2f087defd51d141e014112843a84ab3ba7d03efd Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:48:59 +0000
Subject: [PATCH] [eva] numerors: parse hex/suffixed float literals and handle
 non-finite constants

Rational.of_string only split decimal strings on 'e' and stripped
f/l/f32/f64 suffixes. In the Eva numerors domain (IEEE754.Make.constant):

- hexadecimal floating-point literals without hex digit 'e' were
  misparsed (e.g. 0x1.8p1 became 0.048 and DBL_MAX from <float.h> became
  8.096e+304, dropping a sure out-of-bounds alarm);
- hexadecimal literals containing 'e' (0x1.ep0, FLT_MAX) crashed with
  Failure("int_of_string");
- GCC 'd'-suffixed literals (1.5d) and non-finite constants (INFINITY,
  NAN, HUGE_VAL) crashed with Invalid_argument("Z.of_substring_base:
  invalid digit").

Delegate parsing in Rational.of_string to Zarith Q.of_string after
stripping floating-point suffixes (including d/D, without stripping hex
digits from integer literals), and return Top in IEEE754.Make.constant
for any non-finite CReal.

New test: plugins/eva/tests/numerors/float_literals.c.
---
 .../values/non_integer_arithmetic/IEEE754.ml  |   1 +
 plugins/eva/tests/numerors/float_literals.c   |  54 +++++++++
 .../oracle/float_literals.0.res.oracle        | 103 ++++++++++++++++++
 src/lib/arithmetic/rational.ml                |  51 ++++-----
 4 files changed, 181 insertions(+), 28 deletions(-)
 create mode 100644 plugins/eva/tests/numerors/float_literals.c
 create mode 100644 plugins/eva/tests/numerors/oracle/float_literals.0.res.oracle

diff --git a/plugins/eva/src/values/non_integer_arithmetic/IEEE754.ml b/plugins/eva/src/values/non_integer_arithmetic/IEEE754.ml
index 6f28b6fc25..1c77519f05 100644
--- a/plugins/eva/src/values/non_integer_arithmetic/IEEE754.ml
+++ b/plugins/eva/src/values/non_integer_arithmetic/IEEE754.ml
@@ -566,6 +566,7 @@ module Make (Model : Modeling) = struct
 
   let constant _ _ = function
     | CInt64 _ | CTopInt _ | CChr _ | CEnum _ -> Top
+    | CReal (f, _, _) when not (Float.is_finite f) -> Top
     | CReal (f, fkind, None) ->
       let Format format = format_of_fkind fkind in
       let exact = Scalar.of_float f |> Exact.singleton in
diff --git a/plugins/eva/tests/numerors/float_literals.c b/plugins/eva/tests/numerors/float_literals.c
new file mode 100644
index 0000000000..cec38dc7f1
--- /dev/null
+++ b/plugins/eva/tests/numerors/float_literals.c
@@ -0,0 +1,54 @@
+/* run.config*
+   OPT: -machdep gcc_x86_64 -eva -eva-domains numerors -eva-msg-key=d-numerors
+*/
+#include <float.h>
+#include <math.h>
+#include "__fc_builtin.h"
+
+int tab[2];
+
+void test_hex_and_suffixes(void) {
+  double x = Frama_C_double_interval(1.0, 2.0);
+  double h = x * 0x1.8p1;
+  double d = x * 3.0;
+  double he = 0x1.ep0;
+  double ds = 1.5d;
+  float fm = FLT_MAX;
+  double dm = DBL_MAX;
+  Frama_C_domain_show_each_hex(h);
+  Frama_C_domain_show_each_dec(d);
+  Frama_C_domain_show_each_he(he);
+  Frama_C_domain_show_each_ds(ds);
+  Frama_C_domain_show_each_fm(fm);
+  Frama_C_domain_show_each_dm(dm);
+}
+
+void test_dbl_max_alarm(void) {
+  double x = Frama_C_double_interval(1e305, 1e306);
+  double m = DBL_MAX;
+  int i = 0;
+  if (x < m)
+    i = 2;
+  tab[i] = 1;
+}
+
+void test_non_finite(int c) {
+  if (c == 0) {
+    float f = INFINITY;
+    Frama_C_domain_show_each_inf(f);
+  } else if (c == 1) {
+    float n = NAN;
+    Frama_C_domain_show_each_nan(n);
+  } else if (c == 2) {
+    double hv = HUGE_VAL;
+    Frama_C_domain_show_each_hv(hv);
+  }
+}
+
+void main(int c) {
+  test_hex_and_suffixes();
+  if (c == 3)
+    test_dbl_max_alarm();
+  else
+    test_non_finite(c);
+}
