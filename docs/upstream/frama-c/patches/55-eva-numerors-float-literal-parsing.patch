diff --git a/src/lib/arithmetic/rational.ml b/src/lib/arithmetic/rational.ml
index c1495fac50..9d05e94de1 100644
--- a/src/lib/arithmetic/rational.ml
+++ b/src/lib/arithmetic/rational.ml
@@ -28,38 +28,33 @@ let is_valid q =
   | Q.UNDEF -> false
   | _ -> true
 
-let pow10 e = Z.(pow ten e) |> Q.of_bigint
-
-let split_significant_exponent s =
-  match String.split_on_char 'e' s with
-  | [] | _ :: _ :: _ :: _ -> assert false
-  | [ s ] -> s, 0
-  | [ m ; e ] -> m, int_of_string e
-
-let significant_of_string significant =
-  match String.split_on_char '.' significant with
-  | [] | _ :: _ :: _ :: _ -> assert false
-  | [ m ] -> Q.of_string m
-  | [ integer ; fractional ] ->
-    let shift = pow10 (String.length fractional) in
-    Q.(of_string (integer ^ fractional) / shift)
-
-let remove_float_suffix str len =
-  if String.ends_with ~suffix:"f" str
-  || String.ends_with ~suffix:"l" str then String.sub str 0 (len - 1)
-  else if String.ends_with ~suffix:"f32" str
-       || String.ends_with ~suffix:"f64" str then
+let remove_float_suffix str =
+  let len = String.length str in
+  let is_digit_or_dot c = (c >= '0' && c <= '9') || c = '.' in
+  let has_hex_prefix =
+    String.starts_with ~prefix:"0x" str
+    || String.starts_with ~prefix:"+0x" str
+    || String.starts_with ~prefix:"-0x" str
+  in
+  let is_float_literal =
+    not has_hex_prefix || String.contains str 'p'
+  in
+  if not is_float_literal then str
+  else if len >= 4
+       && is_digit_or_dot str.[len - 4]
+       && (String.ends_with ~suffix:"f32" str
+           || String.ends_with ~suffix:"f64" str) then
     String.sub str 0 (len - 3)
+  else if len >= 2
+       && is_digit_or_dot str.[len - 2]
+       && (String.ends_with ~suffix:"f" str
+           || String.ends_with ~suffix:"d" str
+           || String.ends_with ~suffix:"l" str) then
+    String.sub str 0 (len - 1)
   else str
 
 let of_string str =
-  let str = String.lowercase_ascii str in
-  let length = String.length str in
-  let str = remove_float_suffix str length in
-  let significant, e = split_significant_exponent str in
-  let significant = significant_of_string significant in
-  let shift = if e >= 0 then pow10 e else Q.inv (pow10 ~-e) in
-  Q.(significant * shift)
+  str |> String.lowercase_ascii |> remove_float_suffix |> Q.of_string
 
 let pow2 e =
   let scaling = Q.(mul_2exp one (Stdlib.abs e)) in
