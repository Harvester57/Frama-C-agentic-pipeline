From 757346fdcc6192d49be734aecec817dbeb82b0a8 Mon Sep 17 00:00:00 2001
From: Florian Stosse <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Tue, 17 Nov 2026 18:20:20 +0000
Subject: [PATCH] [kernel] lexer: accept the GNU spelling __restrict__ of
 restrict

GCC and Clang accept restrict, __restrict and __restrict__ as the same
type qualifier, in every language mode. The lexer knew the first two
only: __restrict__ was an identifier, so any declaration using it was a
syntax error, and an unnamed parameter "int *__restrict__" silently
became a parameter named __restrict__. Frama-C's features.h hid this by
defining __restrict__ as __restrict, but only in files that include a
Frama-C libc header, and never with -no-frama-c-stdlib.

Register __restrict__ like the other GNU spellings (__const__,
__volatile__, __signed__, __inline__). The features.h define is kept;
it is now redundant but harmless.

New test tests/syntax/restrict_gnu_spelling.i (not preprocessed, so no
header can rewrite the spelling): the three spellings at file scope, in
struct members, prototypes, definitions, block scope and casts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/internals/parsing/clexer.mll       |  1 +
 .../oracle/restrict_gnu_spelling.0.res.oracle | 32 +++++++++++++++++++
 tests/syntax/restrict_gnu_spelling.i          | 25 +++++++++++++++
 3 files changed, 58 insertions(+)
 create mode 100644 tests/syntax/oracle/restrict_gnu_spelling.0.res.oracle
 create mode 100644 tests/syntax/restrict_gnu_spelling.i

diff --git a/src/kernel/internals/parsing/clexer.mll b/src/kernel/internals/parsing/clexer.mll
index c2907f78ce..ef38faf08a 100644
--- a/src/kernel/internals/parsing/clexer.mll
+++ b/src/kernel/internals/parsing/clexer.mll
@@ -179,6 +179,7 @@ let init_lexicon () =
   valid "__PRETTY_FUNCTION__" (fun loc -> PRETTY_FUNCTION__ loc) ;
   valid "__label__" (fun _ -> LABEL__) ;
   valid "__restrict" (fun loc -> RESTRICT loc) ;
+  valid "__restrict__" (fun loc -> RESTRICT loc) ;
   valid "restrict" (fun loc -> RESTRICT loc) ;
   valid "_Thread_local" (fun loc -> THREAD_LOCAL loc) ;
   (*** GCC ***)
diff --git a/tests/syntax/oracle/restrict_gnu_spelling.0.res.oracle b/tests/syntax/oracle/restrict_gnu_spelling.0.res.oracle
new file mode 100644
index 0000000000..3c04131736
--- /dev/null
+++ b/tests/syntax/oracle/restrict_gnu_spelling.0.res.oracle
@@ -0,0 +1,32 @@
+[kernel] Parsing restrict_gnu_spelling.i (no preprocessing)
+/* Generated by Frama-C */
+struct s {
+   int * restrict m1 ;
+   int * restrict m2 ;
+   int * restrict m3 ;
+};
+int * restrict g1;
+int * restrict g2;
+int * restrict g3;
+struct s gs;
+int get(int * restrict p, char * restrict q);
+
+int get_unnamed(int *, char *);
+
+int f(int * restrict p, int * restrict q, int * restrict r)
+{
+  int __retres;
+  int tmp;
+  int tmp_0;
+  int * restrict l = p;
+  int * const restrict c = q;
+  int * restrict volatile v = r;
+  int * restrict * restrict pp = & l;
+  tmp = get(l,(char *)c);
+  tmp_0 = get_unnamed(v,(char *)r);
+  ;
+  __retres = (tmp + tmp_0) + *(*pp);
+  return __retres;
+}
+
+
diff --git a/tests/syntax/restrict_gnu_spelling.i b/tests/syntax/restrict_gnu_spelling.i
new file mode 100644
index 0000000000..7f3e593e73
--- /dev/null
+++ b/tests/syntax/restrict_gnu_spelling.i
@@ -0,0 +1,25 @@
+/* GCC and Clang accept three spellings of the restrict qualifier: restrict,
+   __restrict and __restrict__. This file is not preprocessed, so no macro of
+   the Frama-C libc (features.h) can rewrite __restrict__. */
+
+int *restrict g1;
+int *__restrict g2;
+int *__restrict__ g3;
+
+struct s {
+  int *restrict m1;
+  int *__restrict m2;
+  int *__restrict__ m3;
+} gs;
+
+int get(int *__restrict__ p, char *__restrict__ q);
+int get_unnamed(int *__restrict__, char *__restrict__);
+
+int f(int *__restrict__ p, int *__restrict q, int *restrict r)
+{
+  int *__restrict__ l = p;
+  int *const __restrict__ c = q;
+  int *__restrict__ volatile v = r;
+  int * __restrict__ * __restrict__ pp = &l;
+  return get(l, (char *)c) + get_unnamed(v, (char *__restrict__)r) + **pp;
+}
-- 
