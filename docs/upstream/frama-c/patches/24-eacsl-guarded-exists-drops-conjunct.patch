+        \exists integer n, m;
+          0 <= n < size && 0 <= m < size && n == 1 && m == 2 && n < m; */
+  /*@ assert \forall integer n; 0 <= n < size ==> n >= 0 && n < 5; */
+  /*@ assert \forall integer n; (0 <= n < size ==> n >= 0) ==> n == n; */
+  return 0;
