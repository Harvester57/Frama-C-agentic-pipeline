From b505a2211d7dbfc126eae6855765306dbe810c21 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Sun, 22 Nov 2026 23:49:23 +0000
Subject: [PATCH] [wp] size void objects as char instead of int

Ctypes.object_of already maps `TPtr TVoid` (`void *`) to
`C_pointer Cil_const.charType` (1-byte `char *`), but its `TVoid` branch
mapped a `void` object to `C_int (c_int IInt)` (`sizeof(int)`). As a
result:

- in the default Typed model, `\block_length(p)` on a `void *` pointer
  was multiplied by `sizeof(int)` (4 on 32/64-bit, 2 on `x86_16`),
  proving `\block_length(p) == 32` for an 8-byte buffer;
- in the Bytes model, pointer shifts (`p + k`) and pointer differences
  (`q - p`) on `void *` stepped by `sizeof(int)` instead of 1 byte,
  proving `(char *)(p + 4) == buf + 16`, `q - p == 1`, and false
  postconditions on Frama-C libc functions such as `mempcpy`.

Map `TVoid` to `C_int (c_char ())`, consistent with `TPtr TVoid` and
GNU C `sizeof(void) == 1`.

New test: wp_acsl/void_object.i.
---
 plugins/wp/src/ctypes.ml                      |  2 +-
 .../wp_acsl/oracle/void_object.0.res.oracle   | 22 +++++++++++
 .../wp_acsl/oracle/void_object.1.res.oracle   | 36 +++++++++++++++++
 .../wp_acsl/oracle/void_object.2.res.oracle   | 13 +++++++
 plugins/wp/tests/wp_acsl/void_object.i        | 39 +++++++++++++++++++
 5 files changed, 111 insertions(+), 1 deletion(-)
 create mode 100644 plugins/wp/tests/wp_acsl/oracle/void_object.0.res.oracle
 create mode 100644 plugins/wp/tests/wp_acsl/oracle/void_object.1.res.oracle
 create mode 100644 plugins/wp/tests/wp_acsl/oracle/void_object.2.res.oracle
 create mode 100644 plugins/wp/tests/wp_acsl/void_object.i

diff --git a/plugins/wp/src/ctypes.ml b/plugins/wp/src/ctypes.ml
index 7a7442a796..9f07449fd8 100644
--- a/plugins/wp/src/ctypes.ml
+++ b/plugins/wp/src/ctypes.ml
@@ -315,7 +315,7 @@ let rec object_of typ =
     C_pointer (Cil_const.voidType)
   | TVoid ->
     WpLog.warning ~current:true "void object" ;
-    C_int (c_int IInt)
+    C_int (c_char ())
   | TNamed r -> object_of r.ttype
 
