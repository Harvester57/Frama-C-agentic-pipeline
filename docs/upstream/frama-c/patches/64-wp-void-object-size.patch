diff --git a/plugins/wp/tests/wp_acsl/void_object.i b/plugins/wp/tests/wp_acsl/void_object.i
new file mode 100644
index 0000000000..c8d0fcb17a
--- /dev/null
+++ b/plugins/wp/tests/wp_acsl/void_object.i
@@ -0,0 +1,39 @@
+/* run.config
+   OPT: -wp-fct bl_true,bl_false
+   OPT: -wp-model Bytes -wp-fct shift_true,shift_false,diff_true,diff_false
+   OPT: -machdep x86_16 -wp-fct bl_true
+*/
+
+char buf[8];
+
+void bl_true(void) {
+  void *p = buf;
+  //@ check \block_length(p) == 8;
+}
+
+void bl_false(void) {
+  void *p = buf;
+  //@ check \block_length(p) == 32;
+}
+
+void shift_true(void) {
+  void *p = buf;
+  //@ check (char *)(p + 4) == buf + 4;
+}
+
+void shift_false(void) {
+  void *p = buf;
+  //@ check (char *)(p + 4) == buf + 16;
+}
+
+void diff_true(void) {
+  void *p = buf;
+  void *q = buf + 4;
+  //@ check q - p == 4;
+}
+
+void diff_false(void) {
+  void *p = buf;
+  void *q = buf + 4;
+  //@ check q - p == 1;
+}
