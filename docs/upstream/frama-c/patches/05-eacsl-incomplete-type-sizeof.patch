 .../e-acsl/tests/constructs/incomplete_type.c | 41 +++++++++
 .../constructs/oracle/gen_incomplete_type.0.c | 91 +++++++++++++++++++
 .../oracle/incomplete_type.0.res.oracle       | 44 +++++++++
 5 files changed, 209 insertions(+), 4 deletions(-)
