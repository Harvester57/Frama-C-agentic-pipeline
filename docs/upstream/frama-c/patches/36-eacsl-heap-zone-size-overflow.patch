+/* run.config
+   COMMENT: Zone sizes given with --zone-sizes (in MB)
+*/
+/* run.config_dev
+   COMMENT: 2048 MB do not fit in an int once converted to bytes
+   MACRO: ROOT_EACSL_GCC_OPTS_EXT --zone-sizes heap:2048,stack:2048
+*/
+
+#include <stdlib.h>
+
+int main(void) {
+  char *p = malloc(16);
+  //@ assert \valid(p + (0 .. 15));
+  free(p);
+  return 0;
+}
