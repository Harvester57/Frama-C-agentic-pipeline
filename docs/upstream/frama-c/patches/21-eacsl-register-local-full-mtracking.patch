new file mode 100644
index 0000000000..efd0263112
--- /dev/null
+++ b/plugins/e-acsl/tests/full-mtracking/oracle/register.0.res.oracle
@@ -0,0 +1,2 @@
+[e-acsl] beginning translation.
+[e-acsl] translation done in project "e-acsl".
diff --git a/plugins/e-acsl/tests/full-mtracking/register.c b/plugins/e-acsl/tests/full-mtracking/register.c
new file mode 100644
index 0000000000..06b3d902e1
--- /dev/null
+++ b/plugins/e-acsl/tests/full-mtracking/register.c
@@ -0,0 +1,13 @@
+/* run.config
+   COMMENT: register variables are observed through their address
+*/
+
+int main(void) {
+  register unsigned i;
+  unsigned sum = 0;
+  for (i = 0; i < 4; i++)
+    sum += i;
+  register int j = 1;
+  /*@ assert \initialized(&j); */
+  return sum != 6 || j != 1;
+}
