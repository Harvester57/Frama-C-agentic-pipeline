From 768ddd7028cdaae894c7ef8fce249586d5b2872a Mon Sep 17 00:00:00 2001
From: Florian Stosse <florian.stosse@gmail.com>
Date: Sun, 15 Nov 2026 18:08:33 +0100
Subject: [PATCH] [e-acsl] drop the register storage class of observed
 variables

E-ACSL observes a variable through its address: __e_acsl_store_block,
__e_acsl_full_init, \initialized(&x), ... For a local declared `register`,
Cil.mkAddrOf aborts with "Taking the address of a register variable", so
E-ACSL crashes on any function with a register local under
-e-acsl-full-mtracking (e-acsl-gcc -M), and on an annotation such as
\initialized(&i) on a register local without it.

In C, `register` only forbids taking the address of the variable, which the
original program never does. Dropping the storage class from the locals and
formals of the instrumented functions keeps the program's behaviour and lets
E-ACSL take the addresses it needs.

Regression test: tests/full-mtracking/register.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/e-acsl/src/code_generator/injector.ml |  9 +++
 .../full-mtracking/oracle/gen_register.0.c    | 73 +++++++++++++++++++
 .../oracle/register.0.res.oracle              |  2 +
 .../e-acsl/tests/full-mtracking/register.c    | 13 ++++
 4 files changed, 97 insertions(+)
 create mode 100644 plugins/e-acsl/tests/full-mtracking/oracle/gen_register.0.c
 create mode 100644 plugins/e-acsl/tests/full-mtracking/oracle/register.0.res.oracle
 create mode 100644 plugins/e-acsl/tests/full-mtracking/register.c

diff --git a/plugins/e-acsl/src/code_generator/injector.ml b/plugins/e-acsl/src/code_generator/injector.ml
index 8a6c712fc5..307d587de9 100644
--- a/plugins/e-acsl/src/code_generator/injector.ml
+++ b/plugins/e-acsl/src/code_generator/injector.ml
@@ -623,6 +623,15 @@ let inject_in_fundec main fundec =
     vi.vattr <- Ast_attributes.(drop frama_c_ghost_formal vi.vattr)
   in
   List.iter unghost_formal fundec.sformals;
+  (* E-ACSL observes variables through their address ([__e_acsl_store_block],
+     [__e_acsl_full_init], [\initialized(&x)], ...), which C forbids for a
+     [register] variable. This storage class has no other effect on the
+     program, so drop it. *)
+  let unregister vi =
+    if vi.vstorage = Register then vi.vstorage <- NoStorage
+  in
+  List.iter unregister fundec.slocals;
+  List.iter unregister fundec.sformals;
   (* update environments *)
   (* TODO: do it only for built-ins *)
   Builtins.update vi.vname vi;
diff --git a/plugins/e-acsl/tests/full-mtracking/oracle/gen_register.0.c b/plugins/e-acsl/tests/full-mtracking/oracle/gen_register.0.c
new file mode 100644
index 0000000000..8c88935ff3
--- /dev/null
+++ b/plugins/e-acsl/tests/full-mtracking/oracle/gen_register.0.c
@@ -0,0 +1,73 @@
+/* Generated by Frama-C */
+#include "pthread.h"
+#include "stddef.h"
+#include "stdint.h"
+#include "stdio.h"
+#include "time.h"
+extern  __attribute__((__FC_BUILTIN__)) int __e_acsl_sound_verdict;
+
+int main(void)
+{
+  unsigned int i;
+  int tmp;
+  __e_acsl_memory_init((int *)0,(char ***)0,8UL);
+  __e_acsl_store_block((void *)(& tmp),4UL);
+  __e_acsl_store_block((void *)(& i),4UL);
+  unsigned int sum = 0U;
+  __e_acsl_store_block((void *)(& sum),4UL);
+  __e_acsl_full_init((void *)(& sum));
+  __e_acsl_full_init((void *)(& i));
+  i = 0U;
+  while (i < 4U) {
+    __e_acsl_full_init((void *)(& sum));
+    sum += i;
+    __e_acsl_full_init((void *)(& i));
+    i ++;
+  }
+  int j = 1;
+  __e_acsl_store_block((void *)(& j),4UL);
+  __e_acsl_full_init((void *)(& j));
+  {
+    int __gen_e_acsl_initialized;
+    __e_acsl_assert_data_t __gen_e_acsl_assert_data = {.values = (void *)0};
+    __gen_e_acsl_initialized = __e_acsl_initialized((void *)(& j),
+                                                    sizeof(int));
+    __e_acsl_assert_register_ptr(& __gen_e_acsl_assert_data,"&j",
+                                 (void *)(& j));
+    __e_acsl_assert_register_ulong(& __gen_e_acsl_assert_data,"sizeof(int)",
+                                   0,sizeof(int));
+    __e_acsl_assert_register_int(& __gen_e_acsl_assert_data,
+                                 "\\initialized(&j)",0,
+                                 __gen_e_acsl_initialized);
+    __gen_e_acsl_assert_data.blocking = 1;
+    __gen_e_acsl_assert_data.kind = "Assertion";
+    __gen_e_acsl_assert_data.pred_txt = "\\initialized(&j)";
+    __gen_e_acsl_assert_data.file = "register.c";
+    __gen_e_acsl_assert_data.fct = "main";
+    __gen_e_acsl_assert_data.line = 11;
+    __e_acsl_assert(__gen_e_acsl_initialized,& __gen_e_acsl_assert_data);
+    __e_acsl_assert_clean(& __gen_e_acsl_assert_data);
+  }
+  /*@ assert \initialized(&j); */ ;
+  if (sum != 6U) {
+    __e_acsl_full_init((void *)(& tmp));
+    tmp = 1;
+  }
+  else 
+    if (j != 1) {
+      __e_acsl_full_init((void *)(& tmp));
+      tmp = 1;
+    }
+    else {
+      __e_acsl_full_init((void *)(& tmp));
+      tmp = 0;
+    }
+  __e_acsl_delete_block((void *)(& tmp));
+  __e_acsl_delete_block((void *)(& j));
+  __e_acsl_delete_block((void *)(& sum));
+  __e_acsl_delete_block((void *)(& i));
+  __e_acsl_memory_clean();
+  return tmp;
+}
+
+
