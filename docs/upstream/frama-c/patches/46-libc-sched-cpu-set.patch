+/* run.config
+   STDOPT:
+   STDOPT: +"-machdep x86_64"
+*/
+#define _GNU_SOURCE
+#include <errno.h>
+#include <sched.h>
+#include <stdlib.h>
+
+int main(void) {
+  //@ assert cpu_setsize: CPU_SETSIZE == 1024;
+  //@ assert sizeof_cpu_set: sizeof(cpu_set_t) == 128;
+  //@ assert alloc_size_1024: CPU_ALLOC_SIZE(1024) == sizeof(cpu_set_t);
+  //@ assert alloc_size_2048: CPU_ALLOC_SIZE(2048) == 2 * sizeof(cpu_set_t);
+
+  cpu_set_t mask;
+  CPU_ZERO(&mask);
+  int z0 = CPU_ISSET(0, &mask);
+  int zlast = CPU_ISSET(CPU_SETSIZE - 1, &mask);
+  //@ assert zero_bits: !z0 && !zlast;
+
+  CPU_SET(0, &mask);
+  CPU_SET(65, &mask);
+  const cpu_set_t *cmask = &mask;
+  int has0 = CPU_ISSET(0, cmask);
+  int has65 = CPU_ISSET(65, cmask);
+  int has1 = CPU_ISSET(1, cmask);
+  //@ assert set_bits: has0 != 0 && has65 != 0 && has1 == 0;
+
+  // Out-of-range CPU numbers are ignored without out-of-bounds access.
+  int ignored_set = CPU_SET(CPU_SETSIZE, &mask) != 0;
+  int ignored_isset = CPU_ISSET(CPU_SETSIZE, cmask);
+  int ignored_clr = CPU_CLR(CPU_SETSIZE, &mask) != 0;
+  //@ assert oob_ignored: !ignored_set && !ignored_isset && !ignored_clr;
+
+  CPU_CLR(65, &mask);
+  int cleared65 = CPU_ISSET(65, cmask);
+  //@ assert cleared_65: cleared65 == 0;
+
+  int cnt = CPU_COUNT(cmask);
+  //@ assert count_bounds: 0 <= cnt <= CPU_SETSIZE;
+
+  cpu_set_t other;
+  CPU_ZERO(&other);
+  CPU_SET(0, &other);
+  int eq = CPU_EQUAL(cmask, &other);
+
+  cpu_set_t combined;
+  CPU_ZERO(&combined);
+  CPU_OR(&combined, cmask, &other);
+  CPU_AND(&combined, cmask, &other);
+  CPU_XOR(&combined, cmask, &other);
+
+  errno = 0;
+  int r = sched_setaffinity(0, sizeof(mask), cmask);
+  //@ assert setaff_res: r == 0 || r == -1;
+  int einval = (r == -1 && errno == EINVAL);
+
+  cpu_set_t cur;
+  int g = sched_getaffinity(0, sizeof(cur), &cur);
+  //@ assert getaff_res: g == 0 || g == -1;
+
+  // Dynamic _S macros on a 2048-CPU set.
+  size_t big_sz = CPU_ALLOC_SIZE(2048);
+  cpu_set_t *big = malloc(big_sz);
+  int big_cnt = 0;
+  if (big != NULL) {
+    CPU_ZERO_S(big_sz, big);
+    CPU_SET_S(1500, big_sz, big);
+    int is_1500 = CPU_ISSET_S(1500, big_sz, big);
+    CPU_CLR_S(1500, big_sz, big);
+    int big_oob = CPU_SET_S(2048, big_sz, big) != 0;
+    big_cnt = CPU_COUNT_S(big_sz, big) + is_1500 + big_oob;
+    sched_setaffinity(0, big_sz, big);
+    sched_getaffinity(0, big_sz, big);
+    free(big);
+  }
+
+  return z0 + zlast + (has0 == 0) + (has65 == 0) + has1 + ignored_set +
+         ignored_isset + ignored_clr + cleared65 + (cnt == 0) + eq + einval +
+         (g < 0) + (big_cnt < 0);
+}
