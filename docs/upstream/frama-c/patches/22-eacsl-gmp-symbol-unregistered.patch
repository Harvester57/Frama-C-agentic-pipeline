From 62fb6395636e5abe2ba2bcbfa813ae5338ecd827 Mon Sep 17 00:00:00 2001
From: Florian Stosse <florian.stosse@gmail.com>
Date: Sun, 15 Nov 2026 17:31:22 +0100
Subject: [PATCH] [e-acsl] register RTL functions the user's code also declares

When linking the RTL with the user's AST, an RTL function that the user's
code already declares (e.g. __gmpz_clear, declared by <gmp.h> and called by
the program) is only associated with the user's kernel function for merging
the contracts. It never enters Rtl.Symbols, so the first time E-ACSL needs
it for its own GMP code, Rtl.Symbols.find_vi raises
Unregistered("__gmpz_clear") and Frama-C stops with an unexpected error.

Register the user's varinfo under the RTL name. The generated code then
calls the user's function, which is the same function; Smart_stmt.do_call
already casts the arguments to the user's parameter types.

Regression test: tests/bts/rtl_user_gmp_symbols.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/e-acsl/src/project_initializer/rtl.ml |  6 +-
 .../bts/oracle/gen_rtl_user_gmp_symbols.0.c   | 82 +++++++++++++++++++
 .../oracle/rtl_user_gmp_symbols.0.res.oracle  |  6 ++
 .../e-acsl/tests/bts/rtl_user_gmp_symbols.c   | 22 +++++
 4 files changed, 115 insertions(+), 1 deletion(-)
 create mode 100644 plugins/e-acsl/tests/bts/oracle/gen_rtl_user_gmp_symbols.0.c
 create mode 100644 plugins/e-acsl/tests/bts/oracle/rtl_user_gmp_symbols.0.res.oracle
 create mode 100644 plugins/e-acsl/tests/bts/rtl_user_gmp_symbols.c

diff --git a/plugins/e-acsl/src/project_initializer/rtl.ml b/plugins/e-acsl/src/project_initializer/rtl.ml
index 9a0ebe796a..44269a5e74 100644
--- a/plugins/e-acsl/src/project_initializer/rtl.ml
+++ b/plugins/e-acsl/src/project_initializer/rtl.ml
@@ -215,7 +215,11 @@ let lookup_rtl_globals rtl_ast =
       in
       let assoc g =
         let kf = Globals.Functions.find_by_name vi.vname in
-        Assocs.add_kf g kf
+        Assocs.add_kf g kf;
+        (* the user's function is the one the RTL function is linked with
+           (e.g. [__gmpz_clear] declared by <gmp.h>): register it under the
+           RTL name, so that the generated code can call it. *)
+        Symbols.add_vi vi.vname (Kernel_function.get_vi kf)
       in
       do_it ~add ~assoc (fun _ -> Globals.Functions.mem_name vi.vname) acc l g
     | GAnnot (Daxiomatic (name, galist, _, _) as ga, _) as g :: l ->
diff --git a/plugins/e-acsl/tests/bts/oracle/gen_rtl_user_gmp_symbols.0.c b/plugins/e-acsl/tests/bts/oracle/gen_rtl_user_gmp_symbols.0.c
new file mode 100644
index 0000000000..1f7d476355
--- /dev/null
+++ b/plugins/e-acsl/tests/bts/oracle/gen_rtl_user_gmp_symbols.0.c
@@ -0,0 +1,82 @@
+/* Generated by Frama-C */
+#include "pthread.h"
+#include "stddef.h"
+#include "stdint.h"
+#include "stdio.h"
+#include "time.h"
+extern  __attribute__((__FC_BUILTIN__)) int __e_acsl_sound_verdict;
+
+struct my_mpz {
+   int alloc ;
+   int size ;
+   unsigned long *d ;
+};
+/*@ requires !\initialized(z);
+    ensures \valid(\old(z));
+    assigns *z;
+    assigns *z \from __e_acsl_init;
+    allocates \old(z);
+ */
+void __gmpz_init(struct my_mpz *z);
+
+/*@ requires \valid(x);
+    assigns *x;
+    assigns *x \from *x; */
+void __gmpz_clear(struct my_mpz *z);
+
+int main(void)
+{
+  int __retres;
+  struct my_mpz z;
+  __e_acsl_memory_init((int *)0,(char ***)0,8UL);
+  unsigned long a = 3UL;
+  unsigned long b = 4UL;
+  __gmpz_init(& z);
+  __gmpz_clear(& z);
+  {
+    __e_acsl_mpz_t __gen_e_acsl_a;
+    __e_acsl_mpz_t __gen_e_acsl_b;
+    __e_acsl_mpz_t __gen_e_acsl_mul;
+    __e_acsl_mpz_t __gen_e_acsl_;
+    __e_acsl_mpz_t __gen_e_acsl_add;
+    __e_acsl_mpz_t __gen_e_acsl__2;
+    int __gen_e_acsl_gt;
+    __e_acsl_assert_data_t __gen_e_acsl_assert_data = {.values = (void *)0};
+    __gmpz_init_set_ui(__gen_e_acsl_a,a);
+    __gmpz_init_set_ui(__gen_e_acsl_b,b);
+    __gmpz_init((struct my_mpz *)(__gen_e_acsl_mul));
+    __gmpz_mul(__gen_e_acsl_mul,
+               (__e_acsl_mpz_struct const *)(__gen_e_acsl_a),
+               (__e_acsl_mpz_struct const *)(__gen_e_acsl_b));
+    __gmpz_init_set_si(__gen_e_acsl_,1L);
+    __gmpz_init((struct my_mpz *)(__gen_e_acsl_add));
+    __gmpz_add(__gen_e_acsl_add,
+               (__e_acsl_mpz_struct const *)(__gen_e_acsl_mul),
+               (__e_acsl_mpz_struct const *)(__gen_e_acsl_));
+    __gmpz_init_set_si(__gen_e_acsl__2,0L);
+    __gen_e_acsl_gt = __gmpz_cmp((__e_acsl_mpz_struct const *)(__gen_e_acsl_add),
+                                 (__e_acsl_mpz_struct const *)(__gen_e_acsl__2));
+    __e_acsl_assert_register_ulong(& __gen_e_acsl_assert_data,"a",0,a);
+    __e_acsl_assert_register_ulong(& __gen_e_acsl_assert_data,"b",0,b);
+    __gen_e_acsl_assert_data.blocking = 1;
+    __gen_e_acsl_assert_data.kind = "Assertion";
+    __gen_e_acsl_assert_data.pred_txt = "a * b + 1 > 0";
+    __gen_e_acsl_assert_data.file = "rtl_user_gmp_symbols.c";
+    __gen_e_acsl_assert_data.fct = "main";
+    __gen_e_acsl_assert_data.line = 20;
+    __e_acsl_assert(__gen_e_acsl_gt > 0,& __gen_e_acsl_assert_data);
+    __e_acsl_assert_clean(& __gen_e_acsl_assert_data);
+    __gmpz_clear((struct my_mpz *)(__gen_e_acsl_a));
+    __gmpz_clear((struct my_mpz *)(__gen_e_acsl_b));
+    __gmpz_clear((struct my_mpz *)(__gen_e_acsl_mul));
+    __gmpz_clear((struct my_mpz *)(__gen_e_acsl_));
+    __gmpz_clear((struct my_mpz *)(__gen_e_acsl_add));
+    __gmpz_clear((struct my_mpz *)(__gen_e_acsl__2));
+  }
+  /*@ assert a * b + 1 > 0; */ ;
+  __retres = 0;
+  __e_acsl_memory_clean();
+  return __retres;
+}
+
+
diff --git a/plugins/e-acsl/tests/bts/oracle/rtl_user_gmp_symbols.0.res.oracle b/plugins/e-acsl/tests/bts/oracle/rtl_user_gmp_symbols.0.res.oracle
new file mode 100644
index 0000000000..10b78114de
--- /dev/null
+++ b/plugins/e-acsl/tests/bts/oracle/rtl_user_gmp_symbols.0.res.oracle
@@ -0,0 +1,6 @@
+[e-acsl] beginning translation.
+[e-acsl] translation done in project "e-acsl".
+[eva] rtl_user_gmp_symbols.c:18: Warning: ignoring unsupported allocates clause
+[eva] rtl_user_gmp_symbols.c:20: Warning: ignoring unsupported allocates clause
+[eva:alarm] rtl_user_gmp_symbols.c:20: Warning: 
+  function __e_acsl_assert, behavior blocking: precondition got status unknown.
diff --git a/plugins/e-acsl/tests/bts/rtl_user_gmp_symbols.c b/plugins/e-acsl/tests/bts/rtl_user_gmp_symbols.c
new file mode 100644
index 0000000000..efedfd4c0a
--- /dev/null
+++ b/plugins/e-acsl/tests/bts/rtl_user_gmp_symbols.c
@@ -0,0 +1,22 @@
+/* run.config
+   COMMENT: the program declares and calls GMP functions that the E-ACSL
+   COMMENT: runtime library also declares, and an assertion needs GMP
+*/
+
+struct my_mpz {
+  int alloc;
+  int size;
+  unsigned long *d;
+};
+
+void __gmpz_init(struct my_mpz *z);
+void __gmpz_clear(struct my_mpz *z);
+
+int main(void) {
+  unsigned long a = 3, b = 4;
+  struct my_mpz z;
+  __gmpz_init(&z);
+  __gmpz_clear(&z);
+  /*@ assert a * b + 1 > 0; */
+  return 0;
+}
