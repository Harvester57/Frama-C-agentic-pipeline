diff --git a/plugins/e-acsl/share/e-acsl/observation_model/bittree_model/e_acsl_bittree.c b/plugins/e-acsl/share/e-acsl/observation_model/bittree_model/e_acsl_bittree.c
index 912e26dc55..92c3ea768c 100644
--- a/plugins/e-acsl/share/e-acsl/observation_model/bittree_model/e_acsl_bittree.c
+++ b/plugins/e-acsl/share/e-acsl/observation_model/bittree_model/e_acsl_bittree.c
@@ -123,7 +123,9 @@ bt_block *bt_find(void *ptr) {
 }
 
 void bt_clean() {
-  DASSERT(bittree != NULL);
+  // The tree is only created when the first block is stored
+  if (bittree == NULL)
+    return;
   // Indicates to `bt_clean` (called by `pt_destroy`) that it should deallocate
   // the leaves of the tree
   bt_clean_with_deallocation = 1;
diff --git a/plugins/e-acsl/share/e-acsl/observation_model/internals/e_acsl_patricia_trie.c b/plugins/e-acsl/share/e-acsl/observation_model/internals/e_acsl_patricia_trie.c
index 5bd0988b55..2fcb377ecc 100644
--- a/plugins/e-acsl/share/e-acsl/observation_model/internals/e_acsl_patricia_trie.c
+++ b/plugins/e-acsl/share/e-acsl/observation_model/internals/e_acsl_patricia_trie.c
@@ -425,11 +425,14 @@ pt_leaf_t pt_lookup(const pt_struct_t *pt, void *ptr) {
   DASSERT(ptr != NULL);
 
   E_ACSL_RLOCK(pt->lock);
-  DASSERT(pt->root != NULL);
 
-  pt_leaf_t res;
+  pt_leaf_t res = NULL;
   pt_node_t *tmp = pt->root;
 
+  // the trie is empty once all its leaves have been removed
+  if (tmp == NULL)
+    goto end;
+
   /*@ loop assigns tmp;
     @*/
   while (!tmp->is_leaf) {
@@ -454,8 +457,8 @@ pt_leaf_t pt_lookup(const pt_struct_t *pt, void *ptr) {
     }
   }
 
-  if (pt->get_ptr_fct(tmp->leaf) != ptr) {
-    res = NULL;
+  if (pt->get_ptr_fct(tmp->leaf) == ptr) {
+    res = tmp->leaf;
   }
 
 end:
