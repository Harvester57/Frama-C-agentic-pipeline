--- /dev/null
+++ b/plugins/e-acsl/tests/special/e-acsl-bittree-lookup.c
@@ -0,0 +1,29 @@
+/* run.config
+   COMMENT: Lookup of blocks by their start address in the bittree memory model
+*/
+/* run.config_dev
+   MACRO: ROOT_EACSL_GCC_OPTS_EXT --memory-model bittree
+   EXECNOW: LOG @EACSL_ERR@ @EACSL_EXEC@
+   MACRO: ROOT_EACSL_GCC_OPTS_EXT --memory-model bittree --full-mtracking
+*/
+
+#include <stdlib.h>
+
+int main(void) {
+  int *q;
+  {
+    int x = 1;
+    q = &x;
+    /* marked initialized when assigned */
+    //@ check in_scope: \valid(q) && \initialized(q);
+  }
+  /* removed at the end of its scope */
+  //@ check out_of_scope: !\valid(q);
+
+  int *p = malloc(sizeof(int));
+  //@ check freeable: \freeable(p);
+  free(p);
+  /* no block is left: lookup in an empty tree */
+  //@ check freed: !\freeable(p);
+  return 0;
+}
