diff --git a/src/kernel/internals/parsing/clexer.mll b/src/kernel/internals/parsing/clexer.mll
index c2907f78ce..8ffb736a5e 100644
--- a/src/kernel/internals/parsing/clexer.mll
+++ b/src/kernel/internals/parsing/clexer.mll
@@ -315,6 +315,27 @@ let lex_oct_escape remainder lexbuf =
   let prefix = scan_oct_escape (Lexing.lexeme lexbuf) in
   prefix :: remainder lexbuf
 
+let scan_ucn ~wide str =
+  let code = ref Int64.zero in
+  for i = 2 to String.length str - 1 do
+    let d = Cabshelper.valueOfDigit (String.get str i) in
+    code := Int64.add (Int64.mul !code 16L) d
+  done ;
+  let cp = !code in
+  if (cp < 0x00A0L && cp <> 0x0024L && cp <> 0x0040L && cp <> 0x0060L)
+     || (0xD800L <= cp && cp <= 0xDFFFL)
+     || cp > 0x10FFFFL
+  then
+    parse_error "Invalid universal character name: %s" str ;
+  if wide then
+    [cp]
+  else begin
+    let buf = Buffer.create 4 in
+    Buffer.add_utf_8_uchar buf (Uchar.of_int (Int64.to_int cp)) ;
+    let s = Buffer.contents buf in
+    List.init (String.length s) (fun i -> int64_of_char s.[i])
+  end
+
 let lex_simple_escape remainder lexbuf =
   let lexchar = Lexing.lexeme_char lexbuf 1 in
   let prefix = scan_escape lexchar in
@@ -463,6 +484,9 @@ let blank = [' ' '\t' '\012' '\r' '\026']+
 let escape = '\\' _
 let hex_escape = '\\' ['x' 'X'] hexdigit+
 let oct_escape = '\\' octdigit octdigit? octdigit?
+let ucn4 = '\\' 'u' hexdigit hexdigit hexdigit hexdigit
+let ucn8 = '\\' 'U' hexdigit hexdigit hexdigit hexdigit hexdigit hexdigit hexdigit hexdigit
+let bad_ucn = '\\' ['u' 'U']
 
 (* Solaris-style pragmas *)
 let solaris_pragmas =
@@ -539,7 +563,7 @@ rule initial = parse
   | '\''
     {
     let start = Lexing.lexeme_start_p lexbuf in
-    let content = chr lexbuf in
+    let content = chr false lexbuf in
     let last = Lexing.lexeme_end_p lexbuf in
     CST_CHAR (content, E.convert_loc (start,last))
     }
@@ -547,7 +571,7 @@ rule initial = parse
   | "L'"
     {
     let start = Lexing.lexeme_start_p lexbuf in
-    let content = chr lexbuf in
+    let content = chr true lexbuf in
     let last = Lexing.lexeme_end_p lexbuf in
     CST_WCHAR (content, E.convert_loc (start,last))
     }
@@ -555,7 +579,7 @@ rule initial = parse
   | '"'
     {
     let start = Lexing.lexeme_start_p lexbuf in
-    let content = str lexbuf in
+    let content = str false lexbuf in
     let last = Lexing.lexeme_end_p lexbuf in
     CST_STRING (content, E.convert_loc (start,last))
     }
@@ -563,7 +587,7 @@ rule initial = parse
   | "L\""
     {
     let start = Lexing.lexeme_start_p lexbuf in
-    let content = str lexbuf in
+    let content = str true lexbuf in
     let last = Lexing.lexeme_end_p lexbuf in
     CST_WSTRING(content, E.convert_loc (start,last))
     }
@@ -720,7 +744,7 @@ and matchingpars parsopen = parse
   | '('   { matchingpars (parsopen + 1) lexbuf }
   | ')'   { if parsopen > 1 then matchingpars (parsopen - 1) lexbuf }
   | "/*"  { do_lex_comment comment lexbuf ; matchingpars parsopen lexbuf }
-  | '"'   { let _ = str lexbuf in matchingpars parsopen lexbuf }
+  | '"'   { let _ = str false lexbuf in matchingpars parsopen lexbuf }
   | _     { matchingpars parsopen lexbuf }
 
 
@@ -797,23 +821,27 @@ and pragma = parse
   | _     { let cur = Lexing.lexeme lexbuf in cur ^ (pragma lexbuf) }
 
 
-and str = parse
+and str wide = parse
   (* no nul termination in CST_STRING '"' *)
   | '"'         { [] }
-  | hex_escape  { lex_hex_escape str lexbuf }
-  | oct_escape  { lex_oct_escape str lexbuf }
-  | escape      { lex_simple_escape str lexbuf }
+  | hex_escape  { lex_hex_escape (str wide) lexbuf }
+  | oct_escape  { lex_oct_escape (str wide) lexbuf }
+  | ucn4 | ucn8 { let prefix = scan_ucn ~wide (Lexing.lexeme lexbuf) in prefix @ str wide lexbuf }
+  | bad_ucn     { parse_error "Incomplete universal character name: %s" (Lexing.lexeme lexbuf) }
+  | escape      { lex_simple_escape (str wide) lexbuf }
   | eof         { parse_error "unterminated string" }
-  | _           { lex_unescaped str lexbuf }
+  | _           { lex_unescaped (str wide) lexbuf }
 
 
-and chr =  parse
+and chr wide =  parse
   | '\''        { [] }
-  | hex_escape  { lex_hex_escape chr lexbuf }
-  | oct_escape  { lex_oct_escape chr lexbuf }
-  | escape      { lex_simple_escape chr lexbuf }
+  | hex_escape  { lex_hex_escape (chr wide) lexbuf }
+  | oct_escape  { lex_oct_escape (chr wide) lexbuf }
+  | ucn4 | ucn8 { let prefix = scan_ucn ~wide (Lexing.lexeme lexbuf) in prefix @ chr wide lexbuf }
+  | bad_ucn     { parse_error "Incomplete universal character name: %s" (Lexing.lexeme lexbuf) }
+  | escape      { lex_simple_escape (chr wide) lexbuf }
   | eof         { parse_error "unterminated char" }
-  | _           { lex_unescaped chr lexbuf }
+  | _           { lex_unescaped (chr wide) lexbuf }
 
 
 and annot_first_token = parse
