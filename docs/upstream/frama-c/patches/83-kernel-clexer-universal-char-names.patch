diff --git a/tests/syntax/ucn_literals.c b/tests/syntax/ucn_literals.c
new file mode 100644
index 0000000000..7f77056ab5
--- /dev/null
+++ b/tests/syntax/ucn_literals.c
@@ -0,0 +1,37 @@
+/* run.config
+   EXIT: 0
+   PLUGIN: @EVA_PLUGINS@
+   OPT: -eva -print
+
+   EXIT: 1
+   OPT: -cpp-extra-args="-DBAD_SURROGATE"
+   OPT: -cpp-extra-args="-DBAD_LOW"
+   OPT: -cpp-extra-args="-DBAD_HIGH"
+   OPT: -cpp-extra-args="-DBAD_INCOMPLETE"
+*/
+#include <stddef.h>
+
+#ifdef BAD_SURROGATE
+wchar_t bad = L'\uD800';
+#elif defined(BAD_LOW)
+wchar_t bad = L'\u0041';
+#elif defined(BAD_HIGH)
+wchar_t bad = L'\U00110000';
+#elif defined(BAD_INCOMPLETE)
+wchar_t bad = L'\u12';
+#else
+const wchar_t *ws1 = L"\u20AC";
+const wchar_t *ws2 = L"\U0001F600";
+wchar_t wc = L'\u20AC';
+const char *s_euro = "\u20AC";
+const char *s_dollar = "\u0024\u0040\u0060";
+char c_dollar = '\u0024';
+
+void main(void) {
+  /*@ check ws1[0] == 0x20AC && ws1[1] == 0; */
+  /*@ check ws2[0] == 0x1F600 && ws2[1] == 0; */
+  /*@ check wc == 0x20AC; */
+  /*@ check (unsigned char)s_euro[0] == 0xE2 && (unsigned char)s_euro[1] == 0x82 && (unsigned char)s_euro[2] == 0xAC && s_euro[3] == 0; */
+  /*@ check s_dollar[0] == '$' && s_dollar[1] == '@' && s_dollar[2] == '`' && c_dollar == '$'; */
+}
+#endif
