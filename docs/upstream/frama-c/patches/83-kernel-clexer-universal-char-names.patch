From b3717852aeef1812d2ed45b4b7a80543e209b133 Mon Sep 17 00:00:00 2001
From: Harvester57 <1315-Harvester57@users.noreply.git.frama-c.com>
Date: Mon, 23 Nov 2026 00:17:04 +0000
Subject: [PATCH] [kernel] support universal character names in C character and
 string literals

---
 src/kernel/internals/parsing/clexer.mll       | 58 ++++++++++++++-----
 tests/syntax/oracle/ucn_literals.0.err.oracle |  0
 tests/syntax/oracle/ucn_literals.0.res.oracle | 56 ++++++++++++++++++
 tests/syntax/oracle/ucn_literals.1.err.oracle |  0
 tests/syntax/oracle/ucn_literals.1.res.oracle | 11 ++++
 tests/syntax/oracle/ucn_literals.2.err.oracle |  0
 tests/syntax/oracle/ucn_literals.2.res.oracle | 11 ++++
 tests/syntax/oracle/ucn_literals.3.err.oracle |  0
 tests/syntax/oracle/ucn_literals.3.res.oracle | 11 ++++
 tests/syntax/oracle/ucn_literals.4.err.oracle |  0
 tests/syntax/oracle/ucn_literals.4.res.oracle | 11 ++++
 tests/syntax/ucn_literals.c                   | 37 ++++++++++++
 12 files changed, 180 insertions(+), 15 deletions(-)
 create mode 100644 tests/syntax/oracle/ucn_literals.0.err.oracle
 create mode 100644 tests/syntax/oracle/ucn_literals.0.res.oracle
 create mode 100644 tests/syntax/oracle/ucn_literals.1.err.oracle
 create mode 100644 tests/syntax/oracle/ucn_literals.1.res.oracle
 create mode 100644 tests/syntax/oracle/ucn_literals.2.err.oracle
 create mode 100644 tests/syntax/oracle/ucn_literals.2.res.oracle
